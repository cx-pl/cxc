bool CheckTwoAwaitImportedValueTaskFailure(
    bool failFirst, bool cancel, bool completeBeforeCall) {
    Math.CrossModuleCoroutineProbe.ResetImportedTaskSource();
    TaskCompletionSource<int> source = new TaskCompletionSource<int>();
    ValueTask<int> first = new ValueTask<int>(17);
    Task<int> second = new Task<int>(25);
    Exception failure = new Exception();
    cx_test_root_object(failure);
    if (failFirst) first.SetTask(source.Task);
    else second = source.Task;
    if (completeBeforeCall) {
        if (cancel) source.SetCanceled();
        else source.SetException(failure);
    }
    Task<int> result = AwaitTwoTasksWithFirstValueTaskCallSource(first, second);
    cx_test_root_object(source.Task);
    cx_test_root_object(result);
    if (result.IsCompleted != completeBeforeCall) return false;
    ForceCollection();
    if (!completeBeforeCall) {
        if (cancel) source.SetCanceled();
        else source.SetException(failure);
    }
    TaskScheduler.Run();
    ForceCollection();
    bool observed = false;
    try { result.GetResult(); }
    catch (OperationCanceledException) { observed = cancel; }
    catch (Exception error) { observed = !cancel && error == failure; }
    return result.IsCompleted && result.IsCanceled == cancel && observed &&
        Math.CrossModuleCoroutineProbe.ImportedTaskSourceCalls == 1;
}

