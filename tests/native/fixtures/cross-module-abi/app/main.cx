bool CheckFiveCallSourceTerminalAtPosition(
    Task<int> first, Task<int> second, Task<int> third, Task<int> fourth,
    Task<int> fifth, int awaitPosition, bool cancel) {
    if (awaitPosition < 1 || awaitPosition > 5) return false;
    cx_test_reset_conditional_branch_source_counts();
    TaskCompletionSource<int> pending = new TaskCompletionSource<int>();
    Task<int> output = first;
    if (awaitPosition == 1) {
        output = AwaitFiveTasksWithLaterCallSources(
            pending.Task, second, third, fourth, fifth);
    } else if (awaitPosition == 2) {
        output = AwaitFiveTasksWithLaterCallSources(
            first, pending.Task, third, fourth, fifth);
    } else if (awaitPosition == 3) {
        output = AwaitFiveTasksWithLaterCallSources(
            first, second, pending.Task, fourth, fifth);
    } else if (awaitPosition == 4) {
        output = AwaitFiveTasksWithLaterCallSources(
            first, second, third, pending.Task, fifth);
    } else {
        output = AwaitFiveTasksWithLaterCallSources(
            first, second, third, fourth, pending.Task);
    }

    cx_test_root_object(pending.Task);
    cx_test_root_object(output);
    if (output.IsCompleted ||
        cx_test_conditional_branch_source_count(1) != awaitPosition - 1) {
        return false;
    }
    ForceCollection();
    Exception failure = new Exception();
    if (cancel) pending.SetCanceled();
    else pending.SetException(failure);
    TaskScheduler.Run();

    if (cancel) {
        bool cancellationObserved = false;
        try {
            output.GetResult();
        } catch (OperationCanceledException) {
            cancellationObserved = true;
        }
        return cancellationObserved && output.IsCanceled &&
            cx_test_conditional_branch_source_count(1) == awaitPosition - 1;
    }

    bool faultIdentityPreserved = false;
    try {
        output.GetResult();
    } catch (Exception observed) {
        faultIdentityPreserved = observed == failure;
    }
    return faultIdentityPreserved &&
        cx_test_conditional_branch_source_count(1) == awaitPosition - 1;
}

bool CheckEnumeratorForeachCallSourceTerminalAtPosition(
    Task<int> first, Task<int> second, Task<int> third,
    int awaitPosition, bool cancel) {
    if (awaitPosition < 1 || awaitPosition > 3) return false;
    cx_test_reset_conditional_branch_source_counts();
    ReusableCallbackProbe.EnumeratorDisposeCount = 0;
    ReusableCallbackProbe.LastValue = -1;
    TaskCompletionSource<int> pending = new TaskCompletionSource<int>();
    Task<int> output = first;
    if (awaitPosition == 1) {
        output = StartEnumeratorForeachCallSourceAdjustments(
            pending.Task, second, third);
    } else if (awaitPosition == 2) {
        output = StartEnumeratorForeachCallSourceAdjustments(
            first, pending.Task, third);
    } else {
        output = StartEnumeratorForeachCallSourceAdjustments(
            first, second, pending.Task);
    }

    int expectedEarlierCalls = awaitPosition - 1;
    int expectedEarlierDisposals = awaitPosition - 1;
    int expectedLastValue = awaitPosition == 1 ? -1 :
        (awaitPosition == 2 ? 20 : 28);
    cx_test_root_object(pending.Task);
    cx_test_root_object(output);
    if (output.IsCompleted ||
        cx_test_conditional_branch_source_count(1) != expectedEarlierCalls ||
        ReusableCallbackProbe.EnumeratorDisposeCount != expectedEarlierDisposals ||
        ReusableCallbackProbe.LastValue != expectedLastValue) return false;

    ForceCollection();
    Exception failure = new Exception();
    if (cancel) pending.SetCanceled();
    else pending.SetException(failure);
    TaskScheduler.Run();

    bool terminalStateObserved = false;
    if (cancel) {
        try {
            output.GetResult();
        } catch (OperationCanceledException) {
            terminalStateObserved = output.IsCanceled;
        }
    } else {
        try {
            output.GetResult();
        } catch (Exception observed) {
            terminalStateObserved = observed == failure;
        }
    }
    return output.IsCompleted && terminalStateObserved &&
        cx_test_conditional_branch_source_count(1) == expectedEarlierCalls &&
        ReusableCallbackProbe.EnumeratorDisposeCount == expectedEarlierDisposals &&
        ReusableCallbackProbe.LastValue == expectedLastValue;
}

