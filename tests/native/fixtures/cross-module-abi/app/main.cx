    } finally { left += 1; ReusableCallbackProbe.FinallyCount += 1; }
    Task<int> selected = LaterTaskSource(left, second);
    var middle = await selected;
    try { throw failure; }
    catch (Exception error) when (middle >= 25) {
        if (error != null) middle += 1;
    } finally { middle += 1; ReusableCallbackProbe.FinallyCount += 1; }
    Task<int> finalSelected = LaterTaskSource(middle, third);
    var right = await finalSelected;
    return left + middle + right;
}

