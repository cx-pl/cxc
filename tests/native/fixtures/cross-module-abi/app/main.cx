public static class TaskAwaitPrefixProbe {
    public static int Calls;
    public static void Record() { Calls += 1; }
}

public static class GenericTaskPrefixProbe {
    public static int Recorded;
    public static void Record(int value) { Recorded = value; }
}

public static class GenericLargeTaskPrefixProbe {
    public static LargeTaskPayload Recorded;
    public static void Record(LargeTaskPayload value) { Recorded = value; }
    public static LargeTaskPayload CreateSeed(int number) {
        LargeTaskPayload value = new LargeTaskPayload(number, new string(1u, 'a'));
        value.Label1 = new string(2u, 'b');
        value.Label2 = new string(3u, 'c');
        value.Label3 = new string(4u, 'd');
        value.Label4 = new string(5u, 'e');
        value.Label5 = new string(6u, 'f');
        value.Label6 = new string(7u, 'g');
        value.Label7 = new string(8u, 'h');
        value.Label8 = new string(9u, 'i');
        value.Label9 = new string(10u, 'j');
        value.Label10 = new string(11u, 'k');
        value.Label11 = new string(12u, 'l');
        return value;
    }
    public static void Clear() {
        Recorded.Number = -1;
        Recorded.Label0 = null;
        Recorded.Label1 = null;
        Recorded.Label2 = null;
        Recorded.Label3 = null;
        Recorded.Label4 = null;
        Recorded.Label5 = null;
        Recorded.Label6 = null;
        Recorded.Label7 = null;
        Recorded.Label8 = null;
        Recorded.Label9 = null;
        Recorded.Label10 = null;
        Recorded.Label11 = null;
    }
    public static bool Matches(int number) {
        return Recorded.Number == number &&
            Recorded.Label0.Length == 1 &&
            Recorded.Label1.Length == 2 &&
            Recorded.Label2.Length == 3 &&
            Recorded.Label3.Length == 4 &&
            Recorded.Label4.Length == 5 &&
            Recorded.Label5.Length == 6 &&
            Recorded.Label6.Length == 7 &&
            Recorded.Label7.Length == 8 &&
            Recorded.Label8.Length == 9 &&
            Recorded.Label9.Length == 10 &&
            Recorded.Label10.Length == 11 &&
            Recorded.Label11.Length == 12;
    }
    public static bool MatchesValue(LargeTaskPayload value, int number) {
        return value.Number == number &&
            value.Label0.Length == 1 &&
            value.Label1.Length == 2 &&
            value.Label2.Length == 3 &&
            value.Label3.Length == 4 &&
            value.Label4.Length == 5 &&
            value.Label5.Length == 6 &&
            value.Label6.Length == 7 &&
            value.Label7.Length == 8 &&
            value.Label8.Length == 9 &&
            value.Label9.Length == 10 &&
            value.Label10.Length == 11 &&
            value.Label11.Length == 12;
    }
}

