    if (awaitPosition == 1) pending.SetResult(17);
    else if (awaitPosition == 2) pending.SetResult(25);
    else pending.SetResult(34);
    TaskScheduler.Run();
    return output.IsCompleted && output.GetResult() == 76 &&
        cx_test_conditional_branch_source_count(1) == 2 &&
        ReusableCallbackProbe.LastValue == 27;
}

bool CheckNestedConditionalCallSourcePendingAtPosition(
    Task<int> first, Task<int> second, Task<int> third, int awaitPosition) {
    if (awaitPosition < 1 || awaitPosition > 3) return false;
    cx_test_reset_conditional_branch_source_counts();
    ReusableCallbackProbe.LastValue = -1;
    TaskCompletionSource<int> pending = new TaskCompletionSource<int>();
    Task<int> output = first;
    if (awaitPosition == 1) {
        output = AwaitThreeTasksWithNestedConditionalCallSource(
            pending.Task, second, third, false, true);
    } else if (awaitPosition == 2) {
        output = AwaitThreeTasksWithNestedConditionalCallSource(
            first, pending.Task, third, false, true);
    } else {
        output = AwaitThreeTasksWithNestedConditionalCallSource(
            first, second, pending.Task, false, true);
    }

    int expectedBranchCalls = awaitPosition == 1 ? 0 : 1;
    int expectedLaterCalls = awaitPosition == 3 ? 1 : 0;
    cx_test_root_object(pending.Task);
    cx_test_root_object(output);
    if (output.IsCompleted ||
        cx_test_conditional_branch_source_count(2) != expectedBranchCalls ||
        cx_test_conditional_branch_source_count(1) != expectedLaterCalls ||
        ReusableCallbackProbe.LastValue != (awaitPosition == 3 ? 25 : -1)) {
        return false;
    }
    ForceCollection();
    if (awaitPosition == 1) pending.SetResult(17);
    else if (awaitPosition == 2) pending.SetResult(25);
    else pending.SetResult(34);
    TaskScheduler.Run();
    return output.IsCompleted && output.GetResult() == 76 &&
        cx_test_conditional_branch_source_count(2) == 1 &&
        cx_test_conditional_branch_source_count(1) == 1 &&
        ReusableCallbackProbe.LastValue == 25;
}

async Task<int> PickConditionalTaskBranchFromCalls(
    Task<int> first, Task<int> second, bool chooseFirst) {
    if (chooseFirst) {
        var value = await ConditionalFirstTaskSource(first);
        return value + 10;
    } else {
        var value = await ConditionalSecondTaskSource(second);
        return value + 20;
    }
}

async Task<int> PickConditionalTaskBranchCallAfterAwait(
    Task<int> firstA, Task<int> firstB,
    Task<int> secondA, Task<int> secondB, bool chooseFirst) {
    if (chooseFirst) {
        var left = await firstA;
        var right = await ConditionalFirstTaskSource(firstB);
        return left + right;
    } else {
        var left = await secondA;
        var right = await ConditionalSecondTaskSource(secondB);
        return left - right;
    }
}

async Task<int> PickConditionalTaskBranchTwice(
    Task<int> firstA, Task<int> firstB,
    Task<int> secondA, Task<int> secondB, bool chooseFirst) {
    if (chooseFirst) {
        var left = await firstA;
        var right = await firstB;
        return left + right;
    } else {
        var left = await secondA;
        var right = await secondB;
        return left - right;
    }
}

async Task<int> PickConditionalTaskBranchThrice(
    Task<int> firstA, Task<int> firstB, Task<int> firstC,
    Task<int> secondA, Task<int> secondB, Task<int> secondC,
    bool chooseFirst) {
    if (chooseFirst) {
        var a = await firstA;
        var b = await firstB;
        var c = await firstC;
        return a + b + c;
    } else {
        var a = await secondA;
        var b = await secondB;
        var c = await secondC;
        return a + b + c;
    }
}

async Task<int> PickConditionalTaskBranchFourTimes(
    Task<int> firstA, Task<int> firstB, Task<int> firstC, Task<int> firstD,
    Task<int> secondA, Task<int> secondB, Task<int> secondC, Task<int> secondD,
    bool chooseFirst) {
    if (chooseFirst) {
        var a = await firstA;
        var b = await firstB;
        var c = await firstC;
        var d = await firstD;
        return a + b + c + d;
    } else {
        var a = await secondA;
        var b = await secondB;
        var c = await secondC;
        var d = await secondD;
        return a + b + c + d;
    }
}

async Task<int> AwaitTaskThroughExplicitLocal(Task<int> source) {
    System.Threading.Tasks.Task<int> selected = source;
    var result = await selected;
    return result + 1;
}

async Task<int> AwaitTaskThroughExplicitLocalCall(Task<int> source) {
    System.Threading.Tasks.Task<int> selected = ConditionalFirstTaskSource(source);
    var result = await selected;
    return result + 1;
}

async Task<int> AwaitTwoTasksWithLaterConditionalCall(
    Task<int> first, Task<int> second, bool chooseFirst) {
    var left = await first;
    Task<int> selected = chooseFirst
        ? ConditionalFirstTaskSource(second)
        : ConditionalSecondTaskSource(second);
    var right = await selected;
    return right + 1;
}

async Task<int> AwaitTaskThroughExplicitLocalWithReferencePrefix(
    Task<int> source, AwaitReferencePrefix inputPrefix) {
    AwaitReferencePrefix prefix = inputPrefix;
    System.Threading.Tasks.Task<int> selected = ConditionalFirstTaskSource(source);
    var result = await selected;
    if (prefix.Value == "explicit-local-prefix" && result > 0) {
        return result + 13;
    } else {
        return prefix.Value == "explicit-local-prefix"
            ? result - 13
            : result;
    }
}

async Task<bool> AwaitTaskShortCircuitAnd(bool left, Task<bool> source) {
    return left && await source;
}

async Task<string> AwaitTaskNullCoalesce(string value, Task<string> fallback) {
    return value ?? await fallback;
}

async Task<int> AwaitTwoValueTaskLocalsWithSwitch(
    ValueTask<int> first, ValueTask<int> second) {
    var firstResult = await first;
    switch (1) {
        case 1 when firstResult > 0: ForceCollection(); break;
        default: break;
    }
    firstResult++;
    var secondResult = await second;
    return firstResult + secondResult;
}

async Task<int> AwaitTwoValueTaskLocalsWithThrow(
    ValueTask<int> first, ValueTask<int> second, Exception failure) {
    Exception capturedFailure = failure;
    var firstResult = await first;
    if (firstResult < 0) throw capturedFailure;
    firstResult++;
    var secondResult = await second;
    if (capturedFailure != null) secondResult++;
    return firstResult + secondResult;
}

async Task<int> AwaitTwoValueTaskLocalsWithTry(
    ValueTask<int> first, ValueTask<int> second) {
    var firstResult = await first;
    try {
        if (firstResult < 0) throw new Exception();
    } catch (Exception error) when (firstResult < 0) {
        firstResult++;
        ForceCollection();
    } finally {
        if (firstResult == 0) ForceCollection();
    }
    var secondResult = await second;
    return firstResult + secondResult;
}

async Task<int> AwaitTwoValueTaskLocalsWithReference(
    ValueTask<int> first, ValueTask<int> second,
    AwaitReferencePrefix referenceSeed) {
    int baseline = 2;
    AwaitReferencePrefix capturedPrefix = referenceSeed;
    var firstResult = await first;
    firstResult++;
    if (firstResult > 0 && capturedPrefix.Value.Length > 0u) {
        int capturedPrefixLength = (int)capturedPrefix.Value.Length;
        if (capturedPrefixLength > 0) ForceCollection();
    }
    var secondResult = await second;
    return baseline + firstResult + secondResult +
        (int)capturedPrefix.Value.Length;
}

async Task<int> AwaitThreeValueTaskLocalsWithReference(
    ValueTask<int> first, ValueTask<int> second, ValueTask<int> third,
    AwaitReferencePrefix referenceSeed) {
    int baseline = 2;
    AwaitReferencePrefix capturedPrefix = referenceSeed;
    var firstResult = await first;
    firstResult++;
    if (firstResult > 0 && capturedPrefix.Value.Length > 0u) {
        int capturedPrefixLength = (int)capturedPrefix.Value.Length;
        if (capturedPrefixLength > 0) ForceCollection();
    }
    var secondResult = await second;
    var thirdResult = await third;
    return baseline + firstResult + secondResult + thirdResult +
        (int)capturedPrefix.Value.Length;
}

async Task<int> AwaitNestedValueTaskLocal(ValueTask<int> pending) {
    return await AwaitValueTaskLocal(pending);
}

