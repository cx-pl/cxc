public class ReusableCallbackProbe {
    public static int LastValue;
    public static int FinallyCount;
    public static int EnumeratorDisposeCount;
}

public class MultiAwaitEnumeratorSequence {
    public int First;
    public int Second;

    public MultiAwaitEnumerator GetEnumerator() {
        return new MultiAwaitEnumerator(this);
    }

    public constructor(int first, int second) {
        First = first;
        Second = second;
    }
}

public struct MultiAwaitEnumerator {
    private MultiAwaitEnumeratorSequence _owner;
    private int _index;

    public int Current {
        const get => _index == 1 ? _owner.First : _owner.Second;
    }

    public bool MoveNext() {
        if (_index >= 2) return false;
        _index += 1;
        return true;
    }

    public void Dispose() {
        ReusableCallbackProbe.EnumeratorDisposeCount += 1;
    }

    public constructor(MultiAwaitEnumeratorSequence owner) {
        _owner = owner;
        _index = 0;
    }
}

public class ReusableStringCallbackProbe {
    public ReusableValueTaskSource<string> Source;
    public uint Version;
    public int LastLength;

    public void Consume() {
        LastLength = (int)Source.GetResult(Version).Length;
    }

    public constructor(ReusableValueTaskSource<string> source) {
        Source = source;
        Version = 0u;
        LastLength = 0;
    }
}

void RegisterReusableCallbackWithNestedStructPayload(
    ReusableValueTaskSource<int> source,
    ReusableValueTask<int> handle) {
    TaskPayload payload = CrossModuleCoroutineProbe.CreateCallbackPayload(
        7, new string(3u, 'p'));
    source.OnCompleted(source.GetVersion(), () => {
        ReusableCallbackProbe.LastValue = payload.Number +
            (int)payload.Label.Length + handle.GetResult();
    });
}

void RegisterReusableCallbackWithArrayPayload(
    ReusableValueTaskSource<int> source,
    ReusableValueTask<int> handle) {
    string[] payload = new string[1];
    payload[0] = new string(2u, 'a');
    source.OnCompleted(source.GetVersion(), () => {
        ReusableCallbackProbe.LastValue =
            (int)payload[0].Length + handle.GetResult();
    });
}

async Task AwaitReusableSourceWhileKeepingFrameReference(
    ReusableValueTaskSource<int> source,
    ReusableValueTask<int> handle) {
    TaskPayload payload = CrossModuleCoroutineProbe.CreateCallbackPayload(
        9, new string(4u, 'f'));
    TaskCompletionSource callbackCompletion = new TaskCompletionSource();
    source.OnCompleted(source.GetVersion(), () => {
        ReusableCallbackProbe.LastValue = handle.GetResult();
        callbackCompletion.SetResult();
    });
    await callbackCompletion.Task;
    ReusableCallbackProbe.LastValue =
        payload.Number + (int)payload.Label.Length +
        ReusableCallbackProbe.LastValue;
}

ReusableValueTaskSource<string> CreateCompletedStringReusableSource() {
    ReusableValueTaskSource<string> source =
        new ReusableValueTaskSource<string>();
    string payload = new string(2u, 'r');
    source.SetResult(payload);
    return source;
}

