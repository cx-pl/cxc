async Task<int> AwaitExplicitLargePayloadAcrossSecondValueTask(
    ValueTask<LargeTaskPayload> first, ValueTask<int> second) {
    LargeTaskPayload payload = await first;
    if (payload.Number > 0) {
        payload.Number += 1;
        ForceCollection();
    }
    ForceCollection();
    int suffix = await second;
    ForceCollection();
    return payload.Number + suffix +
        (payload.Label11.Length == 6u ? 1000 : 0);
}

async Task<int> AwaitExplicitLargePayloadAcrossThreeValueTasks(
    ValueTask<LargeTaskPayload> first,
    ValueTask<int> second,
    ValueTask<int> third) {
    LargeTaskPayload payload = await first;
    if (payload.Number > 0) {
        payload.Number += 1;
        ForceCollection();
    }
    int middle = await second;
    ForceCollection();
    int suffix = await third;
    ForceCollection();
    return payload.Number + middle + suffix +
        (payload.Label11.Length == 6u ? 1000 : 0);
}

async Task<int> AwaitTwoValueTaskLocalsWithLoop(
    ValueTask<int> first, ValueTask<int> second) {
    var firstResult = await first;
    while (firstResult < 5) {
        if (firstResult == 3) {
            firstResult++;
            continue;
        }
        firstResult++;
    }
    var secondResult = await second;
    return firstResult + secondResult;
}

