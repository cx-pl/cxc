    TaskCompletionSource<int> pendingFirst = new TaskCompletionSource<int>();
    TaskCompletionSource<int> pendingSecond = new TaskCompletionSource<int>();
    Task<int> pendingResult = AwaitConditionalTaskWhile(
        pendingFirst.Task, pendingSecond.Task, 2);
    cx_test_root_object(pendingFirst.Task);
    cx_test_root_object(pendingSecond.Task);
    cx_test_root_object(pendingResult);
    if (pendingResult.IsCompleted) return 2;
    ForceCollection();
    pendingFirst.SetResult(31);
    TaskScheduler.Run();
    if (pendingResult.IsCompleted) return 3;
    ForceCollection();
    pendingSecond.SetResult(37);
    TaskScheduler.Run();
    if (!pendingResult.IsCompleted || pendingResult.GetResult() != 37) return 4;
    return 0;
}
