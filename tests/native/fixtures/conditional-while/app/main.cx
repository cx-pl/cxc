import System.Threading.Tasks;

namespace App;

public extern void ForceCollection();
public extern void cx_test_root_object(object value);
public extern void cx_test_allocation_probe_begin();
public extern int cx_test_allocation_probe_end();

public static class TaskAwaitPrefixProbe {
    public static int Value;
    public static void RecordValue(int value) { Value = value; }
}

public static class TaskLocalSourceProbe {
    public static int Calls;
    public static Task<int> Pass(Task<int> source) {
        Calls += 1;
        return source;
    }
}

async Task<int> AwaitTaskDirectReturn(Task<int> source) {
    return await source;
}

async Task<int> AwaitTaskLocalWithReferencePrefix(
    Task<int> source, string marker) {
    string prefix = marker;
    Task<int> selected = source;
    var result = await selected;
    return result + (int)prefix.Length;
}

async Task<int> AwaitTaskLocalWithInferredReferencePrefix(
    Task<int> source, string marker) {
    string prefix = marker;
    var selected = source;
    var result = await selected;
    return result + (int)prefix.Length;
}

async Task<int> AwaitTaskLocalCallWithInferredReferencePrefix(
    Task<int> source, string marker) {
    string prefix = marker;
    var selected = TaskLocalSourceProbe.Pass(source);
    var result = await selected;
    return result + (int)prefix.Length;
}

async Task AwaitVoidTwoWithReferencePrefix(
    Task first, Task second, string marker) {
    string prefix = marker;
    await first;
    await second;
    TaskAwaitPrefixProbe.RecordValue((int)prefix.Length);
}

async Task AwaitVoidTwoWithInferredReferencePrefix(
    Task first, Task second, string marker) {
    var prefix = marker;
    await first;
    await second;
    TaskAwaitPrefixProbe.RecordValue((int)prefix.Length);
}

Task StartPendingVoidPrefix(Task first, Task second) {
    string marker = new string(17u, 'p');
    Task result = AwaitVoidTwoWithReferencePrefix(first, second, marker);
    marker = null;
    return result;
}

Task StartPendingVoidInferredPrefix(Task first, Task second) {
    string marker = new string(18u, 'v');
    Task result = AwaitVoidTwoWithInferredReferencePrefix(first, second, marker);
    marker = null;
    return result;
}

async Task<int> AwaitConditionalTaskWhile(
    Task<int> first, Task<int> second, int limit) {
    int iterations = 0;
    int result = 0;
    while (iterations < limit) {
        var value = await (iterations == 0 ? first : second);
        result = value;
        iterations++;
    }
    return result;
}

async Task<int> AwaitTaskInsideLoop(Task<int> source, int count) {
    int total = 0;
    for (int index = 0; index < count; index++) {
        int value = await source;
        total += value;
    }
    return total;
}

async Task<int> AwaitConditionalTaskFor(
    Task<int> first, Task<int> next, int limit) {
    int result = 0;
    for (int index = 0; index < limit; index++) {
        var value = await (index == 0 ? first : next);
        result = value;
    }
    return result;
}

async Task<int> AwaitForControl(Task<int> source, int limit) {
    int result = 0;
    for (int index = 0; index < limit; index++) {
        var value = await source;
        if (value == 99) break;
        if (value == 0) continue;
        if (value == 42) return value;
        result = value;
    }
    return result;
}

async Task<int> AwaitWhileControl(Task<int> source, int limit) {
    int iterations = 0;
    int result = 0;
    while (iterations < limit) {
        var value = await source;
        iterations++;
        if (value == 99) break;
        if (value == 0) continue;
        if (value == 42) return value;
        result = value;
    }
    return result;
}

async Task<int> AwaitDoWhileControl(Task<int> source, int limit) {
    int iterations = 0;
    int result = 0;
    do {
        var value = await source;
        iterations++;
        if (value == 99) break;
        if (value == 0) continue;
        if (value == 42) return value;
        result = value;
    } while (iterations < limit);
    return result;
}

async Task<int> AwaitDoWhileCount(
    Task<int> first, Task<int> next, int limit) {
    int iterations = 0;
    int result = 0;
    do {
        var value = await (iterations == 0 ? first : next);
        result = value;
        iterations++;
    } while (iterations < limit);
    return result;
}

async Task AwaitVoidWhile(Task first, Task next, int limit) {
    int iterations = 0;
    while (iterations < limit) {
        await (iterations == 0 ? first : next);
        iterations++;
    }
    return;
}

async Task AwaitVoidDoWhile(Task first, Task next, int limit) {
    int iterations = 0;
    do {
        await (iterations == 0 ? first : next);
        iterations++;
    } while (iterations < limit);
    return;
}

async Task AwaitVoidFor(Task first, Task next, int limit) {
    for (int index = 0; index < limit; index++) {
        await (index == 0 ? first : next);
    }
}

int RunDoWhileTaskContract() {
    TaskCompletionSource<int> doWhileZeroFirst = new TaskCompletionSource<int>();
    TaskCompletionSource<int> doWhileZeroNext = new TaskCompletionSource<int>();
    doWhileZeroFirst.SetResult(29);
    cx_test_allocation_probe_begin();
    Task<int> doWhileZero = AwaitDoWhileCount(
        doWhileZeroFirst.Task, doWhileZeroNext.Task, 0);
    int doWhileZeroAllocations = cx_test_allocation_probe_end();
    if (!doWhileZero.IsCompleted || doWhileZero.GetResult() != 29 ||
        doWhileZeroAllocations != 1) return 21;

    TaskCompletionSource<int> doWhileInlineFirst = new TaskCompletionSource<int>();
    TaskCompletionSource<int> doWhileInlineNext = new TaskCompletionSource<int>();
    doWhileInlineFirst.SetResult(31);
    doWhileInlineNext.SetResult(37);
    cx_test_allocation_probe_begin();
    Task<int> doWhileInline = AwaitDoWhileCount(
        doWhileInlineFirst.Task, doWhileInlineNext.Task, 2);
    int doWhileInlineAllocations = cx_test_allocation_probe_end();
    if (!doWhileInline.IsCompleted || doWhileInline.GetResult() != 37 ||
        doWhileInlineAllocations != 1) return 22;

    TaskCompletionSource<int> doWhilePendingFirst = new TaskCompletionSource<int>();
    TaskCompletionSource<int> doWhilePendingNext = new TaskCompletionSource<int>();
    Task<int> doWhilePending = AwaitDoWhileCount(
        doWhilePendingFirst.Task, doWhilePendingNext.Task, 2);
    cx_test_root_object(doWhilePendingFirst.Task);
    cx_test_root_object(doWhilePendingNext.Task);
    cx_test_root_object(doWhilePending);
    if (doWhilePending.IsCompleted) return 23;
    ForceCollection();
    doWhilePendingFirst.SetResult(41);
    TaskScheduler.Run();
    if (doWhilePending.IsCompleted) return 24;
    ForceCollection();
    doWhilePendingNext.SetResult(43);
    TaskScheduler.Run();
    if (!doWhilePending.IsCompleted || doWhilePending.GetResult() != 43)
        return 25;
    return 0;
}

