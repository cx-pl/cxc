    public static long MeasureCapturedRetention(
        BenchmarkArraySequence values) {
        System.GC.Collect();
        long before = BenchmarkNativeClock.GetHeapBytes();
        int threshold = 512;
        int multiplier = 3;
        IEnumerable<int> filtered = values
            .Filter((int value) => value > threshold);
        IEnumerable<int> query = filtered
            .Map<int>((int value) => value * multiplier);
        System.GC.Collect();
        long retained = BenchmarkNativeClock.GetHeapBytes() - before;
        long checksum = Sum(query);
        if (checksum == 0L) { return -1L; }
        return retained;
    }

    public static long MeasureStaticRetention(BenchmarkArraySequence values) {
        System.GC.Collect();
        long before = BenchmarkNativeClock.GetHeapBytes();
        IEnumerable<int> filtered = values
            .Filter((int value) => IsEven(value));
        IEnumerable<int> query = filtered
            .Map<int>((int value) => MultiplyByTen(value));
        System.GC.Collect();
        long retained = BenchmarkNativeClock.GetHeapBytes() - before;
        long checksum = Sum(query);
        if (checksum == 0L) { return -1L; }
        return retained;
    }

    private static void CreateSortedSevenKeyEnumerator(
        BenchmarkArraySequence values) {
        IEnumerable<int> sorted = values
            .Sort<int>(
                (int value) => SortBucket(value),
                (int left, int right) => CompareInt(left, right))
            .ThenSort<int>(
                (int value) => SortSecondaryBucket(value),
                (int left, int right) => CompareInt(left, right))
            .ThenSort<int>(
                (int value) => SortTertiaryBucket(value),
                (int left, int right) => CompareInt(left, right))
            .ThenSort<int>(
                (int value) => SortQuaternaryBucket(value),
                (int left, int right) => CompareInt(left, right))
            .ThenSort<int>(
                (int value) => SortQuinaryBucket(value),
                (int left, int right) => CompareInt(left, right))
            .ThenSort<int>(
                (int value) => SortSixthBucket(value),
                (int left, int right) => CompareInt(left, right))
            .ThenSort<int>(
                (int value) => SortSeventhBucket(value),
                (int left, int right) => CompareInt(left, right));
        RetainedSortEnumerator = sorted.GetEnumerator();
        RetainedSortEnumerator.MoveNext();
    }

    private static void CreateSortedEightKeyEnumerator(
        BenchmarkArraySequence values) {
        IEnumerable<int> sorted = values
            .Sort<int>(
                (int value) => SortBucket(value),
                (int left, int right) => CompareInt(left, right))
            .ThenSort<int>(
                (int value) => SortSecondaryBucket(value),
                (int left, int right) => CompareInt(left, right))
            .ThenSort<int>(
                (int value) => SortTertiaryBucket(value),
                (int left, int right) => CompareInt(left, right))
            .ThenSort<int>(
                (int value) => SortQuaternaryBucket(value),
                (int left, int right) => CompareInt(left, right))
            .ThenSort<int>(
                (int value) => SortQuinaryBucket(value),
                (int left, int right) => CompareInt(left, right))
            .ThenSort<int>(
                (int value) => SortSixthBucket(value),
                (int left, int right) => CompareInt(left, right))
            .ThenSort<int>(
                (int value) => SortSeventhBucket(value),
                (int left, int right) => CompareInt(left, right))
            .ThenSort<int>(
                (int value) => value,
                (int left, int right) => CompareInt(left, right));
        RetainedSortEnumerator = sorted.GetEnumerator();
        RetainedSortEnumerator.MoveNext();
    }

    private static void ReleaseDisposedSortEnumerator() {
        RetainedSortEnumerator = default;
    }

    public static long MeasureDisposedSortScratchRetention(
        BenchmarkArraySequence values) {
        System.GC.Collect();
        CreateSortedSevenKeyEnumerator(values);
        System.GC.Collect();
        long beforeDispose = BenchmarkNativeClock.GetHeapBytes();
        RetainedSortEnumerator.Dispose();
        System.GC.Collect();
        long afterDispose = BenchmarkNativeClock.GetHeapBytes();
        ReleaseDisposedSortEnumerator();
        System.GC.Collect();
        return beforeDispose - afterDispose;
    }

    public static long MeasureDisposedEightKeySortScratchRetention(
        BenchmarkArraySequence values) {
        System.GC.Collect();
        CreateSortedEightKeyEnumerator(values);
        System.GC.Collect();
        long beforeDispose = BenchmarkNativeClock.GetHeapBytes();
        RetainedSortEnumerator.Dispose();
        System.GC.Collect();
        long afterDispose = BenchmarkNativeClock.GetHeapBytes();
        ReleaseDisposedSortEnumerator();
        System.GC.Collect();
        return beforeDispose - afterDispose;
    }

    public static RetainedQueryProjection MakeRetainedProjection(int value) {
        return new RetainedQueryProjection(value);
    }

    private static bool CreateRetainedArrayMapTakeEnumerator() {
        Array<int> source = new Array<int>(1u);
        source.Set(0u, 41);
        IEnumerable<RetainedQueryProjection> query = source
            .Map<RetainedQueryProjection>(
                (int value) => MakeRetainedProjection(value))
            .Take(1u);
        RetainedMapTakeEnumerator = query.GetEnumerator();
        return RetainedMapTakeEnumerator.MoveNext();
    }

    private static bool CreateRetainedListMapTakeEnumerator() {
        List<int> source = new List<int>();
        source.Add(41);
        IEnumerable<RetainedQueryProjection> query = source
            .Map<RetainedQueryProjection>(
                (int value) => MakeRetainedProjection(value))
            .Take(1u);
        RetainedMapTakeEnumerator = query.GetEnumerator();
        return RetainedMapTakeEnumerator.MoveNext();
    }

    private static bool CreateRetainedListFilterMapTakeEnumerator() {
        List<int> source = new List<int>();
        source.Add(41);
        int threshold = 40;
        int multiplier = 1;
        IEnumerable<RetainedQueryProjection> query = source
            .Filter((int value) => value > threshold)
            .Map<RetainedQueryProjection>((int value) =>
                MakeRetainedProjection(value * multiplier))
            .Take(1u);
        RetainedMapTakeEnumerator = query.GetEnumerator();
        return RetainedMapTakeEnumerator.MoveNext();
    }

    private static bool CreateRetainedArrayFilterMapTakeEnumerator() {
        Array<int> source = new Array<int>(1u);
        source.Set(0u, 41);
        int threshold = 40;
        int multiplier = 1;
        IEnumerable<RetainedQueryProjection> query = source
            .Filter((int value) => value > threshold)
            .Map<RetainedQueryProjection>((int value) =>
                MakeRetainedProjection(value * multiplier))
            .Take(1u);
        RetainedMapTakeEnumerator = query.GetEnumerator();
        return RetainedMapTakeEnumerator.MoveNext();
    }

    private static bool RetainedMapTakeCurrentIsValid() {
        RetainedQueryProjection value = RetainedMapTakeEnumerator.Current;
        return value != null && value.Read() == 83;
    }

    private static long MeasureDisposedMapTakeRetention(
        bool useListSource) {
        System.GC.Collect();
        bool moved = useListSource
            ? CreateRetainedListMapTakeEnumerator()
            : CreateRetainedArrayMapTakeEnumerator();
        if (!moved) {
            RetainedMapTakeEnumerator = default;
            return -1L;
        }
        System.GC.Collect();
        if (!RetainedMapTakeCurrentIsValid()) {
            RetainedMapTakeEnumerator.Dispose();
            RetainedMapTakeEnumerator = default;
            return -2L;
        }
        System.GC.Collect();
        long beforeDispose = BenchmarkNativeClock.GetHeapBytes();
        RetainedMapTakeEnumerator.Dispose();
        System.GC.Collect();
        long afterDispose = BenchmarkNativeClock.GetHeapBytes();
        RetainedMapTakeEnumerator = default;
        System.GC.Collect();
        return beforeDispose - afterDispose;
    }

    public static long MeasureDisposedArrayMapTakeRetention() {
        return MeasureDisposedMapTakeRetention(false);
    }

    public static long MeasureDisposedListMapTakeRetention() {
        return MeasureDisposedMapTakeRetention(true);
    }

    private static long MeasureDisposedFilterMapTakeRetention(
        bool useListSource) {
        System.GC.Collect();
        bool moved = useListSource
            ? CreateRetainedListFilterMapTakeEnumerator()
            : CreateRetainedArrayFilterMapTakeEnumerator();
        if (!moved) {
            RetainedMapTakeEnumerator = default;
            return -1L;
        }
        System.GC.Collect();
        if (!RetainedMapTakeCurrentIsValid()) {
            RetainedMapTakeEnumerator.Dispose();
            RetainedMapTakeEnumerator = default;
            return -2L;
        }
        System.GC.Collect();
        long beforeDispose = BenchmarkNativeClock.GetHeapBytes();
        RetainedMapTakeEnumerator.Dispose();
        System.GC.Collect();
        long afterDispose = BenchmarkNativeClock.GetHeapBytes();
        RetainedMapTakeEnumerator = default;
        System.GC.Collect();
        return beforeDispose - afterDispose;
    }

    public static long MeasureDisposedArrayFilterMapTakeRetention() {
        return MeasureDisposedFilterMapTakeRetention(false);
    }

    public static long MeasureDisposedListFilterMapTakeRetention() {
        return MeasureDisposedFilterMapTakeRetention(true);
    }

    private static bool CreateRetainedArrayFilterTakeEnumerator() {
        Array<int> source = new Array<int>(2u);
        source.Set(0u, 41);
        source.Set(1u, 42);
        RetainedQueryProjection captured = MakeRetainedProjection(41);
        IEnumerable<int> query = source
            .Filter((int value) => captured.Read() == 83 && value > 0)
            .Take(2u);
        RetainedFilterTakeEnumerator = query.GetEnumerator();
        return RetainedFilterTakeEnumerator.MoveNext();
    }

    private static bool CreateRetainedListFilterTakeEnumerator() {
        List<int> source = new List<int>();
        source.Add(41);
        source.Add(42);
        RetainedQueryProjection captured = MakeRetainedProjection(41);
        IEnumerable<int> query = source
            .Filter((int value) => captured.Read() == 83 && value > 0)
            .Take(2u);
        RetainedFilterTakeEnumerator = query.GetEnumerator();
        return RetainedFilterTakeEnumerator.MoveNext();
    }

    private static bool CreateRetainedArrayFilterSkipTakeEnumerator() {
        Array<int> source = new Array<int>(3u);
        source.Set(0u, 41);
        source.Set(1u, 42);
        source.Set(2u, 43);
        RetainedQueryProjection captured = MakeRetainedProjection(41);
        IEnumerable<int> query = source
            .Filter((int value) => captured.Read() == 83 && value > 0)
            .Skip(1u).Take(1u);
        RetainedFilterTakeEnumerator = query.GetEnumerator();
        return true;
    }

    private static bool CreateRetainedListFilterSkipTakeEnumerator() {
        List<int> source = new List<int>();
        source.Add(41);
        source.Add(42);
        source.Add(43);
        RetainedQueryProjection captured = MakeRetainedProjection(41);
        IEnumerable<int> query = source
            .Filter((int value) => captured.Read() == 83 && value > 0)
            .Skip(1u).Take(1u);
        RetainedFilterTakeEnumerator = query.GetEnumerator();
        return true;
    }

    private static long CollectAndReadHeapBytes() {
        BenchmarkNativeClock.ScrubConservativeStack();
        System.GC.Collect();
        return BenchmarkNativeClock.GetHeapBytes();
    }

    private static long MeasureFilterTakeCompletionRelease(
        bool useListSource) {
        System.GC.Collect();
        bool moved = useListSource
            ? CreateRetainedListFilterTakeEnumerator()
            : CreateRetainedArrayFilterTakeEnumerator();
        if (!moved || RetainedFilterTakeEnumerator.Current != 41) {
            RetainedFilterTakeEnumerator = default;
            return -1L;
        }
        long beforeCompletion = CollectAndReadHeapBytes();
        bool completed = RetainedFilterTakeEnumerator.MoveNext();
        if (!completed || RetainedFilterTakeEnumerator.Current != 42) {
            RetainedFilterTakeEnumerator.Dispose();
            RetainedFilterTakeEnumerator = default;
            return -2L;
        }
        long afterCompletion = CollectAndReadHeapBytes();
        RetainedFilterTakeEnumerator.Dispose();
        RetainedFilterTakeEnumerator = default;
        System.GC.Collect();
        return beforeCompletion - afterCompletion;
    }

    public static long MeasureArrayFilterTakeCompletionRelease() {
        return MeasureFilterTakeCompletionRelease(false);
    }

    public static long MeasureListFilterTakeCompletionRelease() {
        return MeasureFilterTakeCompletionRelease(true);
    }

    private static long MeasureFilterSkipTakeCompletionRelease(
        bool useListSource) {
        System.GC.Collect();
        bool created = useListSource
            ? CreateRetainedListFilterSkipTakeEnumerator()
            : CreateRetainedArrayFilterSkipTakeEnumerator();
        if (!created) {
            RetainedFilterTakeEnumerator = default;
            return -1L;
        }
        long beforeCompletion = CollectAndReadHeapBytes();
        bool moved = RetainedFilterTakeEnumerator.MoveNext();
        if (!moved || RetainedFilterTakeEnumerator.Current != 42) {
            RetainedFilterTakeEnumerator.Dispose();
            RetainedFilterTakeEnumerator = default;
            return -2L;
        }
        long afterCompletion = CollectAndReadHeapBytes();
        RetainedFilterTakeEnumerator.Dispose();
        RetainedFilterTakeEnumerator = default;
        System.GC.Collect();
        return beforeCompletion - afterCompletion;
    }

    public static long MeasureArrayFilterSkipTakeCompletionRelease() {
        return MeasureFilterSkipTakeCompletionRelease(false);
    }

    public static long MeasureListFilterSkipTakeCompletionRelease() {
        return MeasureFilterSkipTakeCompletionRelease(true);
    }

    private static bool CreateRetainedArrayMapSkipTakeEnumerator() {
        Array<int> source = new Array<int>(3u);
        source.Set(0u, 41);
        source.Set(1u, 42);
        source.Set(2u, 43);
        RetainedQueryProjection captured = MakeRetainedProjection(41);
        IEnumerable<RetainedQueryProjection> query = source
            .Map<RetainedQueryProjection>((int value) =>
                MakeRetainedProjection(value + captured.Read() - 83))
            .Skip(1u).Take(1u);
        RetainedMapSkipTakeEnumerator = query.GetEnumerator();
        return true;
    }

    private static bool CreateRetainedListMapSkipTakeEnumerator() {
        List<int> source = new List<int>();
        source.Add(41);
        source.Add(42);
        source.Add(43);
        RetainedQueryProjection captured = MakeRetainedProjection(41);
        IEnumerable<RetainedQueryProjection> query = source
            .Map<RetainedQueryProjection>((int value) =>
                MakeRetainedProjection(value + captured.Read() - 83))
            .Skip(1u).Take(1u);
        RetainedMapSkipTakeEnumerator = query.GetEnumerator();
        return true;
    }

    private static long MeasureMapSkipTakeCompletionRelease(
        bool useListSource) {
        System.GC.Collect();
        bool created = useListSource
            ? CreateRetainedListMapSkipTakeEnumerator()
            : CreateRetainedArrayMapSkipTakeEnumerator();
        if (!created) {
            RetainedMapSkipTakeEnumerator = default;
            return -1L;
        }
        bool moved = RetainedMapSkipTakeEnumerator.MoveNext();
        if (!moved || RetainedMapSkipTakeEnumerator.Current == null ||
            RetainedMapSkipTakeEnumerator.Current.Read() != 85) {
            RetainedMapSkipTakeEnumerator.Dispose();
            RetainedMapSkipTakeEnumerator = default;
            return -2L;
        }
        long beforeCompletion = CollectAndReadHeapBytes();
        bool completed = RetainedMapSkipTakeEnumerator.MoveNext();
        if (completed) {
            RetainedMapSkipTakeEnumerator.Dispose();
            RetainedMapSkipTakeEnumerator = default;
            return -3L;
        }
        long afterCompletion = CollectAndReadHeapBytes();
        RetainedMapSkipTakeEnumerator.Dispose();
        RetainedMapSkipTakeEnumerator = default;
        System.GC.Collect();
        return beforeCompletion - afterCompletion;
    }

    public static long MeasureArrayMapSkipTakeCompletionRelease() {
        return MeasureMapSkipTakeCompletionRelease(false);
    }

    public static long MeasureListMapSkipTakeCompletionRelease() {
        return MeasureMapSkipTakeCompletionRelease(true);
    }

    public static long Sum(IEnumerable<int> values) {
        long sum = 0L;
        IEnumerator<int> enumerator = values.GetEnumerator();
        try {
            while (enumerator.MoveNext()) {
                sum += enumerator.Current;
            }
        } finally {
            enumerator.Dispose();
        }
        return sum;
    }

    public static long HandwrittenTwoFilterSum(BenchmarkArraySequence values) {
        long sum = 0L;
        for (uint index = 0u; index < values.Length; index += 1u) {
            int value = values.Get(index);
            if (IsEven(value) && GreaterThanTwo(value)) {
                sum += value;
            }
        }
        return sum;
    }

    public static long HandwrittenStreamingSum(BenchmarkArraySequence values) {
        long sum = 0L;
        uint selected = 0u;
        for (uint index = 0u; index < values.Length && selected < 128u;
            index += 1u) {
            int value = values.Get(index);
            if (IsEven(value) && GreaterThanTwo(value)) {
                sum += MultiplyByTen(value);
                selected += 1u;
            }
        }
        return sum;
    }

    public static long HandwrittenSingleFilterMapTakeSum(
        BenchmarkArraySequence values) {
        long sum = 0L;
        uint selected = 0u;
        for (uint index = 0u; index < values.Length && selected < 128u;
            index += 1u) {
            int value = values.Get(index);
            if (IsEven(value)) {
                sum += MultiplyByTen(value);
                selected += 1u;
            }
        }
        return sum;
    }

    public static long HandwrittenListFilterMapTakeSum() {
        long sum = 0L;
        uint selected = 0u;
        for (uint index = 0u;
            index < ListValues.Count && selected < 128u;
            index += 1u) {
            int value = ListValues.Get(index);
            if (IsEven(value)) {
                sum += MultiplyByTen(value);
                selected += 1u;
            }
        }
        return sum;
    }

    public static long HandwrittenArrayMapFilterTakeSum(
        BenchmarkArraySequence values) {
        long sum = 0L;
        uint selected = 0u;
        for (uint index = 0u; index < values.Length && selected < 128u;
            index += 1u) {
            int mapped = MultiplyByTen(values.Get(index));
            if (GreaterThan10240(mapped)) {
                sum += mapped;
                selected += 1u;
            }
        }
        return sum;
    }

    public static long HandwrittenListMapFilterTakeSum() {
        long sum = 0L;
        uint selected = 0u;
        for (uint index = 0u;
            index < ListValues.Count && selected < 128u;
            index += 1u) {
            int mapped = MultiplyByTen(ListValues.Get(index));
            if (GreaterThan10240(mapped)) {
                sum += mapped;
                selected += 1u;
            }
        }
        return sum;
    }

    public static long HandwrittenArrayMapTakeSum(
        BenchmarkArraySequence values) {
        long sum = 0L;
        uint index = 0u;
        while (index < values.Length && index < 128u) {
            sum += MultiplyByTen(values.Get(index));
            index += 1u;
        }
        return sum;
    }

    public static long HandwrittenListMapTakeSum() {
        long sum = 0L;
        uint index = 0u;
        while (index < ListValues.Count && index < 128u) {
            sum += MultiplyByTen(ListValues.Get(index));
            index += 1u;
        }
        return sum;
    }

    public static long HandwrittenArrayMapSkipTakeSum(
        BenchmarkArraySequence values) {
        long sum = 0L;
        for (uint index = 0u; index < values.Length && index < 640u;
            index += 1u) {
            int mapped = MultiplyByTen(values.Get(index));
            if (index >= 512u) { sum += mapped; }
        }
        return sum;
    }

    public static long HandwrittenListMapSkipTakeSum() {
        long sum = 0L;
        for (uint index = 0u;
            index < ListValues.Count && index < 640u;
            index += 1u) {
            int mapped = MultiplyByTen(ListValues.Get(index));
            if (index >= 512u) { sum += mapped; }
        }
        return sum;
    }

    public static long HandwrittenArrayFilterTakeSum(
        BenchmarkArraySequence values) {
        long sum = 0L;
        uint selected = 0u;
        for (uint index = 0u; index < values.Length && selected < 128u;
            index += 1u) {
            int value = values.Get(index);
            if (IsEven(value)) {
                sum += value;
                selected += 1u;
            }
        }
        return sum;
    }

    public static long HandwrittenListFilterTakeSum() {
        long sum = 0L;
        uint selected = 0u;
        for (uint index = 0u;
            index < ListValues.Count && selected < 128u;
            index += 1u) {
            int value = ListValues.Get(index);
            if (IsEven(value)) {
                sum += value;
                selected += 1u;
            }
        }
        return sum;
    }

    public static long HandwrittenPageSum(BenchmarkArraySequence values) {
        long sum = 0L;
        for (uint index = 512u; index < 640u; index += 1u) {
            sum += values.Get(index);
        }
        return sum;
    }

    public static long HandwrittenListPageSum() {
        long sum = 0L;
        for (uint index = 512u; index < 640u; index += 1u) {
            sum += ListValues.Get(index);
        }
        return sum;
    }

    public static long HandwrittenCapturedSum(
        BenchmarkArraySequence values,
        int threshold,
        int multiplier) {
        long sum = 0L;
        for (uint index = 0u; index < values.Length; index += 1u) {
            int value = values.Get(index);
            if (value > threshold) {
                sum += value * multiplier;
            }
        }
        return sum;
    }

    public static long HandwrittenNoncapturedFilterMapSum(
        BenchmarkArraySequence values) {
        long sum = 0L;
        for (uint index = 0u; index < values.Length; index += 1u) {
            int value = values.Get(index);
            if (value > 512) {
                sum += value * 3;
            }
        }
        return sum;
    }

    public static long Evaluate(
        uint category,
        IEnumerable<int> query,
        BenchmarkArraySequence values,
        int threshold,
        int multiplier) {
        if (category == 0u) { return HandwrittenTwoFilterSum(values); }
        if (category == 4u) { return HandwrittenStreamingSum(values); }
        if (category == 11u) {
            return HandwrittenSingleFilterMapTakeSum(values);
        }
        if (category == 16u) { return HandwrittenListFilterMapTakeSum(); }
        if (category == 45u || category == 46u) {
            return HandwrittenArrayMapFilterTakeSum(values);
        }
        if (category == 47u) {
            return HandwrittenArrayMapTakeSum(values);
        }
        if (category == 50u) { return HandwrittenListMapTakeSum(); }
        if (category == 65u) {
            return HandwrittenArrayMapSkipTakeSum(values);
        }
        if (category == 68u) { return HandwrittenListMapSkipTakeSum(); }
        if (category == 22u) { return HandwrittenListPageSum(); }
        if (category == 6u) { return HandwrittenPageSum(values); }
        if (category == 8u) {
            return HandwrittenCapturedSum(values, threshold, multiplier);
        }
        if (category == 41u) {
            return HandwrittenNoncapturedFilterMapSum(values);
        }
        return Sum(query);
    }

    public static void Measure(
        uint category,
        IEnumerable<int> query,
        BenchmarkArraySequence values,
        uint iterations,
        uint samples,
        int threshold,
        int multiplier) {
        if (BenchmarkNativeClock.ShouldMeasureCategory(category) == 0u) {
            return;
        }
        uint warmup = 0u;
        while (warmup < 100u) {
            long ignored = Evaluate(
                category, query, values, threshold, multiplier);
            warmup += 1u;
        }

        uint sample = 0u;
        while (sample < samples) {
            MeasureSample(
                category, query, values, iterations, threshold, multiplier,
                sample);
            sample += 1u;
        }
    }

    public static void MeasureSample(
        uint category,
        IEnumerable<int> query,
        BenchmarkArraySequence values,
        uint iterations,
        int threshold,
        int multiplier,
        uint sample) {
        BenchmarkNativeClock.StartAllocationTracking();
        long start = BenchmarkNativeClock.GetNanoseconds();
        uint iteration = 0u;
        long checksum = 0L;
        while (iteration < iterations) {
            checksum += Evaluate(
                category, query, values, threshold, multiplier);
            iteration += 1u;
        }
        long elapsed = BenchmarkNativeClock.GetNanoseconds() - start;
        BenchmarkNativeClock.StopAllocationTracking();
        BenchmarkNativeClock.WriteResult(
            category,
            sample,
            iterations,
            elapsed,
            checksum,
            BenchmarkNativeClock.GetAllocationCount(),
            BenchmarkNativeClock.GetAllocationBytes());
    }

    public static void MeasurePaired(
        uint firstCategory,
        IEnumerable<int> firstQuery,
        uint secondCategory,
        IEnumerable<int> secondQuery,
        BenchmarkArraySequence values,
        uint iterations,
        uint samples,
        int threshold,
        int multiplier) {
        bool measureFirst =
            BenchmarkNativeClock.ShouldMeasureCategory(firstCategory) != 0u;
        bool measureSecond =
            BenchmarkNativeClock.ShouldMeasureCategory(secondCategory) != 0u;
        if (!measureFirst && !measureSecond) { return; }

        uint warmup = 0u;
        while (warmup < 100u) {
            if (measureFirst) {
                long ignoredFirst = Evaluate(
                    firstCategory, firstQuery, values, threshold, multiplier);
            }
            if (measureSecond) {
                long ignoredSecond = Evaluate(
                    secondCategory, secondQuery, values, threshold, multiplier);
            }
            warmup += 1u;
        }

        uint sample = 0u;
        while (sample < samples) {
            if (sample % 2u == 0u) {
                if (measureFirst) {
                    MeasureSample(firstCategory, firstQuery, values,
                        iterations, threshold, multiplier, sample);
                }
                if (measureSecond) {
                    MeasureSample(secondCategory, secondQuery, values,
                        iterations, threshold, multiplier, sample);
                }
            } else {
                if (measureSecond) {
                    MeasureSample(secondCategory, secondQuery, values,
                        iterations, threshold, multiplier, sample);
                }
                if (measureFirst) {
                    MeasureSample(firstCategory, firstQuery, values,
                        iterations, threshold, multiplier, sample);
                }
            }
            sample += 1u;
        }
    }
}

public int Main() {
    const uint valueCount = 2048u;
    const uint iterations = 2000u;
    const uint samples = 7u;
    Array<int> storage = new Array<int>(valueCount);
    BenchmarkArraySequence values = new BenchmarkArraySequence(storage);
    BenchmarkNativeClock.WriteHeader();
    List<int> list = new List<int>();
    for (uint index = 0u; index < valueCount; index += 1u) {
        storage.Set(index, (int)index);
        list.Add((int)index);
    }

    WhereEnumerable<int> first = values
        .Filter((int value) => QueryBenchmarks.IsEven(value));
    WhereWhereEnumerable<int> fused = first
        .Filter((int value) => QueryBenchmarks.GreaterThanTwo(value));
    IEnumerable<int> firstInterface = first;
    IEnumerable<int> layered = firstInterface
        .Filter((int value) => QueryBenchmarks.GreaterThanTwo(value));

    long expected = QueryBenchmarks.HandwrittenTwoFilterSum(values);
    if (QueryBenchmarks.Sum(fused) != expected ||
        QueryBenchmarks.Sum(layered) != expected) {
        return 1;
    }

    QueryBenchmarks.Measure(0u, fused, values, iterations, samples, 0, 0);
    QueryBenchmarks.Measure(1u, fused, values, iterations, samples, 0, 0);
    QueryBenchmarks.Measure(2u, layered, values, iterations, samples, 0, 0);
    IEnumerable<int> listInterface = list;
    IEnumerable<int> listFirstFilter = listInterface
        .Filter((int value) => QueryBenchmarks.IsEven(value));
    IEnumerable<int> listLayered = listFirstFilter
        .Filter((int value) => QueryBenchmarks.GreaterThanTwo(value));
    QueryBenchmarks.ListValues = list;
    QueryBenchmarks.Measure(
        3u, listLayered, values, iterations, samples, 0, 0);

    IEnumerable<int> indexedListStream = list
        .Filter((int value) => QueryBenchmarks.IsEven(value))
        .Map<int>((int value) => QueryBenchmarks.MultiplyByTen(value))
        .Take(128u);
    if (QueryBenchmarks.Sum(indexedListStream) !=
        QueryBenchmarks.HandwrittenListFilterMapTakeSum()) {
        return 9;
    }
    IEnumerable<int> listSingleFilterFallback = listInterface
        .Filter((int value) => QueryBenchmarks.IsEven(value))
        .Map<int>((int value) => QueryBenchmarks.MultiplyByTen(value))
        .Take(128u);
    if (QueryBenchmarks.Sum(listSingleFilterFallback) !=
        QueryBenchmarks.HandwrittenListFilterMapTakeSum()) {
        return 10;
    }
    QueryBenchmarks.Measure(
        16u, indexedListStream, values, iterations, samples, 0, 0);
    QueryBenchmarks.Measure(
        17u, indexedListStream, values, iterations, samples, 0, 0);
    QueryBenchmarks.Measure(
        18u, listSingleFilterFallback, values, iterations, samples, 0, 0);

    IEnumerable<int> streamingFiltered = values
        .Filter((int value) => QueryBenchmarks.IsEven(value))
        .Filter((int value) => QueryBenchmarks.GreaterThanTwo(value));
    IEnumerable<int> streamingMapped = streamingFiltered
        .Map<int>((int value) => QueryBenchmarks.MultiplyByTen(value));
    IEnumerable<int> streaming = streamingMapped.Take(128u);
    if (QueryBenchmarks.Sum(streaming) !=
        QueryBenchmarks.HandwrittenStreamingSum(values)) { return 2; }
    QueryBenchmarks.Measure(4u, streaming, values, iterations, samples, 0, 0);
    QueryBenchmarks.Measure(5u, streaming, values, iterations, samples, 0, 0);

    IEnumerable<int> singleFilterStream = values
        .Filter((int value) => QueryBenchmarks.IsEven(value))
        .Map<int>((int value) => QueryBenchmarks.MultiplyByTen(value))
        .Take(128u);
    IEnumerable<int> singleFilterInterface = values
        .Filter((int value) => QueryBenchmarks.IsEven(value));
    IEnumerable<int> singleFilterLayered = singleFilterInterface
        .Map<int>((int value) => QueryBenchmarks.MultiplyByTen(value))
        .Take(128u);
    if (QueryBenchmarks.Sum(singleFilterStream) !=
            QueryBenchmarks.HandwrittenSingleFilterMapTakeSum(values) ||
        QueryBenchmarks.Sum(singleFilterLayered) !=
            QueryBenchmarks.HandwrittenSingleFilterMapTakeSum(values)) {
        return 6;
    }
    QueryBenchmarks.Measure(
        11u, singleFilterStream, values, iterations, samples, 0, 0);
    QueryBenchmarks.Measure(
        12u, singleFilterStream, values, iterations, samples, 0, 0);
    QueryBenchmarks.Measure(
        13u, singleFilterLayered, values, iterations, samples, 0, 0);

    IEnumerable<int> indexedArrayStream = storage
        .Filter((int value) => QueryBenchmarks.IsEven(value))
        .Map<int>((int value) => QueryBenchmarks.MultiplyByTen(value))
        .Take(128u);
    if (QueryBenchmarks.Sum(indexedArrayStream) !=
        QueryBenchmarks.HandwrittenSingleFilterMapTakeSum(values)) {
        return 8;
    }
    QueryBenchmarks.Measure(
        15u, indexedArrayStream, values, iterations, samples, 0, 0);

    IEnumerable<int> paged = values.Page(4u, 128u);
    IEnumerable<int> page = paged
        .Map<int>((int value) => QueryBenchmarks.Identity(value));
    if (QueryBenchmarks.Sum(page) != QueryBenchmarks.HandwrittenPageSum(values)) {
        return 3;
    }
    QueryBenchmarks.Measure(6u, page, values, iterations, samples, 0, 0);
    QueryBenchmarks.Measure(7u, page, values, iterations, samples, 0, 0);

    IEnumerable<int> indexedPaged = storage.Page(4u, 128u);
    IEnumerable<int> indexedPage = indexedPaged
        .Map<int>((int value) => QueryBenchmarks.Identity(value));
    if (QueryBenchmarks.Sum(indexedPage) != QueryBenchmarks.HandwrittenPageSum(values)) {
        return 7;
    }
    QueryBenchmarks.Measure(14u, indexedPage, values, iterations, samples, 0, 0);

    IEnumerable<int> indexedListPage = list.Page(4u, 128u)
        .Map<int>((int value) => QueryBenchmarks.Identity(value));
    if (QueryBenchmarks.Sum(indexedListPage) !=
        QueryBenchmarks.HandwrittenListPageSum()) {
        return 14;
    }
    IEnumerable<int> interfaceListPage = listInterface.Page(4u, 128u)
        .Map<int>((int value) => QueryBenchmarks.Identity(value));
    if (QueryBenchmarks.Sum(interfaceListPage) !=
        QueryBenchmarks.HandwrittenListPageSum()) {
        return 15;
    }
    QueryBenchmarks.Measure(
        22u, indexedListPage, values, iterations, samples, 0, 0);
    QueryBenchmarks.Measure(
        23u, indexedListPage, values, iterations, samples, 0, 0);
    QueryBenchmarks.Measure(
        24u, interfaceListPage, values, iterations, samples, 0, 0);

    IEnumerable<int> indexedArrayMapFilterTake = storage
        .Map<int>((int value) => QueryBenchmarks.MultiplyByTen(value))
        .Filter((int value) => QueryBenchmarks.GreaterThan10240(value))
        .Take(128u);
    IEnumerable<int> interfaceArrayMapFilterTake = values
        .Map<int>((int value) => QueryBenchmarks.MultiplyByTen(value))
        .Filter((int value) => QueryBenchmarks.GreaterThan10240(value))
        .Take(128u);
    long expectedArrayMapFilterTake =
        QueryBenchmarks.HandwrittenArrayMapFilterTakeSum(values);
    if (QueryBenchmarks.Sum(indexedArrayMapFilterTake) !=
            expectedArrayMapFilterTake ||
        QueryBenchmarks.Sum(interfaceArrayMapFilterTake) !=
            expectedArrayMapFilterTake) {
        return 45;
    }
    QueryBenchmarks.MeasurePaired(
        45u, indexedArrayMapFilterTake,
        46u, interfaceArrayMapFilterTake,
        values, iterations, samples, 0, 0);

    IEnumerable<int> indexedListMapFilterTake = list
        .Map<int>((int value) => QueryBenchmarks.MultiplyByTen(value))
        .Filter((int value) => QueryBenchmarks.GreaterThan10240(value))
        .Take(128u);
    IEnumerable<int> interfaceListMapFilterTake = listInterface
        .Map<int>((int value) => QueryBenchmarks.MultiplyByTen(value))
        .Filter((int value) => QueryBenchmarks.GreaterThan10240(value))
        .Take(128u);
    long expectedListMapFilterTake =
        QueryBenchmarks.HandwrittenListMapFilterTakeSum();
    if (QueryBenchmarks.Sum(indexedListMapFilterTake) !=
            expectedListMapFilterTake ||
        QueryBenchmarks.Sum(interfaceListMapFilterTake) !=
            expectedListMapFilterTake) {
        return 71;
    }
    QueryBenchmarks.MeasurePaired(
        71u, indexedListMapFilterTake,
        72u, interfaceListMapFilterTake,
        values, iterations, samples, 0, 0);

    IEnumerable<int> indexedArrayMapTake = storage
        .Map<int>((int value) => QueryBenchmarks.MultiplyByTen(value))
        .Take(128u);
    IEnumerable<int> interfaceArrayMapTake = values
        .Map<int>((int value) => QueryBenchmarks.MultiplyByTen(value))
        .Take(128u);
    long expectedArrayMapTake =
        QueryBenchmarks.HandwrittenArrayMapTakeSum(values);
    if (QueryBenchmarks.Sum(indexedArrayMapTake) != expectedArrayMapTake ||
        QueryBenchmarks.Sum(interfaceArrayMapTake) != expectedArrayMapTake) {
        return 47;
    }
    QueryBenchmarks.Measure(
        47u, indexedArrayMapTake, values, iterations, samples, 0, 0);
    QueryBenchmarks.MeasurePaired(
        48u, indexedArrayMapTake,
        49u, interfaceArrayMapTake,
        values, iterations, samples, 0, 0);

    IEnumerable<int> indexedListMapTake = list
        .Map<int>((int value) => QueryBenchmarks.MultiplyByTen(value))
        .Take(128u);
    IEnumerable<int> interfaceListMapTake = listInterface
        .Map<int>((int value) => QueryBenchmarks.MultiplyByTen(value))
        .Take(128u);
    long expectedListMapTake = QueryBenchmarks.HandwrittenListMapTakeSum();
    if (QueryBenchmarks.Sum(indexedListMapTake) != expectedListMapTake ||
        QueryBenchmarks.Sum(interfaceListMapTake) != expectedListMapTake) {
        return 50;
    }
