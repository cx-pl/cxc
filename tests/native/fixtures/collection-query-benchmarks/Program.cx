import System.Collections;
import System.Collections.Query;

internal final class BenchmarkNativeClock {
    public static extern long GetNanoseconds();
    public static extern void StartAllocationTracking();
    public static extern void StopAllocationTracking();
    public static extern long GetAllocationCount();
    public static extern long GetAllocationBytes();
    public static extern long GetHeapBytes();
    public static extern void ScrubConservativeStack();
    public static extern uint SupportsRetainedReleaseBudget();
    public static extern uint SupportsPrefixCompletionReleaseBudget();
    public static extern void WriteHeader();
    public static extern uint ShouldMeasureCategory(uint category);
    public static extern void WriteResult(
        uint category,
        uint sample,
        uint iterations,
        long elapsedNanoseconds,
        long checksum,
        long allocationCount,
        long allocationBytes);
    public static extern void WriteRetained(uint workload, long bytes);
}

public final class BenchmarkArraySequence : IEnumerable<int> {
    private Array<int> _values;

    public uint Length { const get { return _values.Length; } }

    public constructor(Array<int> values) {
        _values = values;
    }

    public int Get(uint index) const {
        return _values.Get(index);
    }

    public IEnumerator<int> GetEnumerator() const {
        return _values.GetEnumerator();
    }
}

public final class RetainedQueryProjection {
    private Array<int> _payload;

    public constructor(int value) {
        _payload = new Array<int>(65536u);
        _payload.Set(0u, value);
        _payload.Set(65535u, value + 1);
    }

    public int Read() const {
        return _payload.Get(0u) + _payload.Get(65535u);
    }
}

public static class QueryBenchmarks {
    public static List<int> ListValues;
    public static IEnumerator<int> RetainedSortEnumerator;
    public static IEnumerator<RetainedQueryProjection>
        RetainedMapTakeEnumerator;
    public static IEnumerator<int> RetainedFilterTakeEnumerator;
    public static IEnumerator<RetainedQueryProjection>
        RetainedMapSkipTakeEnumerator;

    public static bool IsEven(int value) {
        return value % 2 == 0;
    }

    public static bool GreaterThanTwo(int value) {
        return value > 2;
    }

    public static bool GreaterThan10240(int value) {
        return value > 10240;
    }

    public static int MultiplyByTen(int value) {
        return value * 10;
    }

    public static int Identity(int value) {
        return value;
    }

    public static int Triple(int value) {
        return value * 3;
    }

    public static bool GreaterThan512(int value) {
        return value > 512;
    }

    public static int CompareInt(int left, int right) {
        if (left < right) { return -1; }
        if (left > right) { return 1; }
        return 0;
    }

    public static int SortBucket(int value) {
        return value % 17;
    }

    public static int SortSecondaryBucket(int value) {
        return value % 11;
    }

    public static int SortTertiaryBucket(int value) {
        return value % 7;
    }

    public static int SortQuaternaryBucket(int value) {
        return value % 5;
    }

    public static int SortQuinaryBucket(int value) {
        return value % 3;
    }

    public static int SortSixthBucket(int value) {
        return value % 2;
    }

    public static int SortSeventhBucket(int value) {
        return value % 19;
    }

    public static BenchmarkArraySequence CreateSortInput(uint count) {
        Array<int> storage = new Array<int>(count);
        for (uint index = 0u; index < count; index += 1u) {
            storage.Set(index, (int)((index * 37u) % count));
        }
        return new BenchmarkArraySequence(storage);
    }

    public static bool VerifySorted(
        IEnumerable<int> values,
        uint expectedCount,
        long expectedSum) {
        IEnumerator<int> enumerator = values.GetEnumerator();
        uint count = 0u;
        long sum = 0L;
        int previous = 0;
        bool hasPrevious = false;
        bool ordered = true;
        try {
            while (enumerator.MoveNext()) {
                int value = enumerator.Current;
                if (hasPrevious && value < previous) { ordered = false; }
                previous = value;
                hasPrevious = true;
                count += 1u;
                sum += value;
            }
        } finally {
            enumerator.Dispose();
        }
        return ordered && count == expectedCount && sum == expectedSum;
    }

    public static bool VerifyMultiKeySorted(
        IEnumerable<int> values,
        uint expectedCount,
        long expectedSum) {
        IEnumerator<int> enumerator = values.GetEnumerator();
        uint count = 0u;
        long sum = 0L;
        int previousBucket = 0;
        int previousSecondary = 0;
        bool hasPrevious = false;
        bool ordered = true;
        try {
            while (enumerator.MoveNext()) {
                int value = enumerator.Current;
                int bucket = SortBucket(value);
                int secondary = SortSecondaryBucket(value);
                if (hasPrevious && (bucket < previousBucket ||
                    (bucket == previousBucket && secondary < previousSecondary))) {
                    ordered = false;
                }
                previousBucket = bucket;
                previousSecondary = secondary;
                hasPrevious = true;
                count += 1u;
                sum += value;
            }
        } finally {
            enumerator.Dispose();
        }
        return ordered && count == expectedCount && sum == expectedSum;
    }

