    }
    QueryBenchmarks.Measure(
        20u, sort512, sort512Values, 50u, samples, 0, 0);

    BenchmarkArraySequence sort2048Values =
        QueryBenchmarks.CreateSortInput(2048u);
    IEnumerable<int> sort2048 = sort2048Values.Sort<int>(
        (int value) => value,
        (int left, int right) => QueryBenchmarks.CompareInt(left, right));
    long sort2048Sum = 2048L * 2047L / 2L;
    if (!QueryBenchmarks.VerifySorted(sort2048, 2048u, sort2048Sum)) {
        return 13;
    }
    QueryBenchmarks.Measure(
        21u, sort2048, sort2048Values, 10u, samples, 0, 0);
    BenchmarkNativeClock.WriteRetained(
        0u, QueryBenchmarks.MeasureStaticRetention(values));
    BenchmarkNativeClock.WriteRetained(
        1u, QueryBenchmarks.MeasureCapturedRetention(values));
    BenchmarkNativeClock.WriteRetained(
        2u, QueryBenchmarks.MeasureDisposedSortScratchRetention(values));
    BenchmarkNativeClock.WriteRetained(
        3u, QueryBenchmarks.MeasureDisposedEightKeySortScratchRetention(values));
    long arrayMapTakeReleased =
        QueryBenchmarks.MeasureDisposedArrayMapTakeRetention();
    BenchmarkNativeClock.WriteRetained(4u, arrayMapTakeReleased);
    long listMapTakeReleased =
        QueryBenchmarks.MeasureDisposedListMapTakeRetention();
    BenchmarkNativeClock.WriteRetained(5u, listMapTakeReleased);
    long listFilterMapTakeReleased =
        QueryBenchmarks.MeasureDisposedListFilterMapTakeRetention();
    long arrayFilterMapTakeReleased =
        QueryBenchmarks.MeasureDisposedArrayFilterMapTakeRetention();
    BenchmarkNativeClock.WriteRetained(6u, arrayFilterMapTakeReleased);
    BenchmarkNativeClock.WriteRetained(7u, listFilterMapTakeReleased);
    long arrayFilterTakeReleased =
        QueryBenchmarks.MeasureArrayFilterTakeCompletionRelease();
    BenchmarkNativeClock.WriteRetained(8u, arrayFilterTakeReleased);
    long listFilterTakeReleased =
        QueryBenchmarks.MeasureListFilterTakeCompletionRelease();
    BenchmarkNativeClock.WriteRetained(9u, listFilterTakeReleased);
    long arrayFilterSkipTakeReleased =
        QueryBenchmarks.MeasureArrayFilterSkipTakeCompletionRelease();
    BenchmarkNativeClock.WriteRetained(10u, arrayFilterSkipTakeReleased);
    long listFilterSkipTakeReleased =
        QueryBenchmarks.MeasureListFilterSkipTakeCompletionRelease();
    BenchmarkNativeClock.WriteRetained(11u, listFilterSkipTakeReleased);
    long arrayMapSkipTakeReleased =
        QueryBenchmarks.MeasureArrayMapSkipTakeCompletionRelease();
    BenchmarkNativeClock.WriteRetained(12u, arrayMapSkipTakeReleased);
    long listMapSkipTakeReleased =
        QueryBenchmarks.MeasureListMapSkipTakeCompletionRelease();
    BenchmarkNativeClock.WriteRetained(13u, listMapSkipTakeReleased);
    if (BenchmarkNativeClock.SupportsRetainedReleaseBudget() != 0u &&
        (arrayMapTakeReleased < 245000L ||
        listMapTakeReleased < 245000L ||
        arrayFilterMapTakeReleased < 245000L ||
        listFilterMapTakeReleased < 245000L)) {
        return 14;
    }
    if (BenchmarkNativeClock.SupportsPrefixCompletionReleaseBudget() != 0u &&
        (arrayFilterTakeReleased < 245000L ||
        listFilterTakeReleased < 245000L ||
        arrayFilterSkipTakeReleased < 245000L ||
        listFilterSkipTakeReleased < 245000L ||
        arrayMapSkipTakeReleased < 245000L ||
        listMapSkipTakeReleased < 245000L)) {
        return 15;
    }
    return 0;
}
