int ReadCurrentTwice(IAsyncEnumerable<int> source) {
    IAsyncEnumerator<int> enumerator =
        source.GetAsyncEnumerator(CancellationToken.None);
    int result = 0;
    if (enumerator.MoveNextAsync().GetResult()) {
        result = enumerator.Current + enumerator.Current;
    }
    enumerator.DisposeAsync().GetResult();
    return result;
}

int ReadCurrentTwiceStruct(IAsyncEnumerable<ProjectionValue> source) {
    IAsyncEnumerator<ProjectionValue> enumerator =
        source.GetAsyncEnumerator(CancellationToken.None);
    int result = 0;
    if (enumerator.MoveNextAsync().GetResult()) {
        ProjectionValue first = enumerator.Current;
        ProjectionValue second = enumerator.Current;
        result = first.Value + first.Derived + second.Value + second.Derived;
    }
    enumerator.DisposeAsync().GetResult();
    return result;
}

int ReadCurrentTwiceReference(
    IAsyncEnumerable<ProjectionReference> source) {
    IAsyncEnumerator<ProjectionReference> enumerator =
        source.GetAsyncEnumerator(CancellationToken.None);
    int result = 0;
    if (enumerator.MoveNextAsync().GetResult()) {
        ProjectionReference first = enumerator.Current;
        if (first == null) { return -1; }
        int firstTotal = first.Value + first.Derived;
        first = null;
        System.GC.Collect();
        ProjectionReference second = enumerator.Current;
        if (second == null) { return -2; }
        result = firstTotal + second.Value + second.Derived;
    }
    enumerator.DisposeAsync().GetResult();
    return result;
}

