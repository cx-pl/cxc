import System.Collections;
import System.Collections.Query;
import System.Threading.Tasks;

public interface IRow {
    object Read();
}

public final class Row<T> : IRow {
    private T _value;

    public constructor(T value) {
        _value = value;
    }

    public object Read() {
        return _value as object;
    }
}

public static class QueryProbe {
    public static uint FilterCalls;
    public static uint SecondFilterCalls;
    public static uint MapCalls;
    public static uint SortKeyCalls;
    public static uint SecondarySortKeyCalls;
    public static uint TertiarySortKeyCalls;
    public static uint FourthSortKeyCalls;
    public static uint FifthSortKeyCalls;
    public static uint SixthSortKeyCalls;
    public static uint SeventhSortKeyCalls;
    public static uint EighthSortKeyCalls;
    public static uint ComparerCalls;
    public static uint ThrowingSortKeyCalls;
    public static uint ThrowingTertiarySortKeyCalls;
    public static uint ThrowingFourthSortKeyCalls;
    public static uint ThrowingFifthSortKeyCalls;
    public static uint ThrowingFilterCalls;
    public static uint ThrowingMapCalls;
    public static List<int> SortMutationList;
    public static uint SortMutationKeyCalls;
    public static uint ReferenceProjectionCalls;
    public static uint StructProjectionCalls;
    public static uint AsyncProjectionCalls;
    public static uint AsyncPredicateCalls;
    public static uint PositionPredicateCalls;

    public static bool KeepEven(int value) {
        FilterCalls += 1u;
        return value % 2 == 0;
    }

    public static bool KeepMappedGreaterThanTwenty(int value) {
        FilterCalls += 1u;
        return value > 20;
    }

    public static bool KeepGreaterThanTwo(int value) {
        SecondFilterCalls += 1u;
        return value > 2;
    }

    public static bool IsAsyncPositionMatch(int value) {
        PositionPredicateCalls += 1u;
        return value == 43;
    }

    public static bool AsyncMoveRejectsNullEnumerator(
        IAsyncEnumerator<int> enumerator) {
        try {
            enumerator.MoveNextAsync().AsTask().GetResult();
        } catch (System.InvalidOperationException) {
            return true;
        }
        return false;
    }

    public static bool IsPositionMatch(int value) {
        PositionPredicateCalls += 1u;
        return value == 4;
    }


    public static int MultiplyByTen(int value) {
        MapCalls += 1u;
        return value * 10;
    }

    public static ProjectionReference MakeReferenceProjection(int value) {
        ReferenceProjectionCalls += 1u;
        return new ProjectionReference(value, value * 3);
    }

    public static ProjectionValue MakeStructProjection(int value) {
        StructProjectionCalls += 1u;
        return new ProjectionValue(value, value * 5);
    }

    public static int MakeAsyncProjection(int value) {
        AsyncProjectionCalls += 1u;
        return value * 2;
    }

    public static Task<int> MakePendingAsyncProjection(int value) {
        AsyncProjectionCalls += 1u;
        TaskCompletionSource<int> completion =
            new TaskCompletionSource<int>();
        TaskScheduler.PostAfter(1u, () =>
            completion.SetResult(value * 2));
        return completion.GetTask();
    }

    public static Task<ProjectionReference>
        MakePendingAsyncReferenceProjection(int value) {
        ReferenceProjectionCalls += 1u;
        TaskCompletionSource<ProjectionReference> completion =
            new TaskCompletionSource<ProjectionReference>();
        TaskScheduler.PostAfter(1u, () => completion.SetResult(
            new ProjectionReference(value, value * 3)));
        return completion.GetTask();
    }

    public static Task<ProjectionReference>
        MakePendingFaultingAsyncReferenceProjection(int value) {
        ReferenceProjectionCalls += 1u;
        TaskCompletionSource<ProjectionReference> completion =
            new TaskCompletionSource<ProjectionReference>();
        TaskScheduler.PostAfter(1u, () => completion.SetException(
            new System.InvalidOperationException(
                "async reference projection failure")));
        return completion.GetTask();
    }

    public static Task<int> MakePendingFaultingAsyncProjection(int value) {
        TaskCompletionSource<int> completion =
            new TaskCompletionSource<int>();
        TaskScheduler.PostAfter(1u, () => completion.SetException(
            new System.InvalidOperationException("async projection failure")));
        return completion.GetTask();
    }

    public static Task<int> MakePendingCanceledAsyncProjection(int value) {
        TaskCompletionSource<int> completion =
            new TaskCompletionSource<int>();
        TaskScheduler.PostAfter(1u, () => completion.SetCanceled());
        return completion.GetTask();
    }

    public static Task<bool> MakePendingEvenAsyncPredicate(int value) {
        AsyncPredicateCalls += 1u;
        TaskCompletionSource<bool> completion =
            new TaskCompletionSource<bool>();
        TaskScheduler.PostAfter(1u, () =>
            completion.SetResult(value % 2 == 0));
        return completion.GetTask();
    }

    public static Task<bool> MakeImmediateFalseAsyncPredicate(int value) {
        AsyncPredicateCalls += 1u;
        return new Task<bool>(false);
    }

    public static Task<bool> MakePendingAboveAsyncPredicate(
        int value,
        int threshold) {
        AsyncPredicateCalls += 1u;
        TaskCompletionSource<bool> completion =
            new TaskCompletionSource<bool>();
        TaskScheduler.PostAfter(1u, () =>
            completion.SetResult(value > threshold));
        return completion.GetTask();
    }

    public static Task<bool> MakePendingReferenceAboveAsyncPredicate(
        ProjectionReference value,
        int threshold) {
        AsyncPredicateCalls += 1u;
        TaskCompletionSource<bool> completion =
            new TaskCompletionSource<bool>();
        TaskScheduler.PostAfter(1u, () =>
            completion.SetResult(value.Derived > threshold));
        return completion.GetTask();
    }

    public static Task<bool> MakePendingFaultingAsyncPredicate(int value) {
        AsyncPredicateCalls += 1u;
        TaskCompletionSource<bool> completion =
            new TaskCompletionSource<bool>();
        TaskScheduler.PostAfter(1u, () => completion.SetException(
            new System.InvalidOperationException("async predicate failure")));
        return completion.GetTask();
    }

    public static Task<bool> MakePendingCanceledAsyncPredicate(int value) {
        AsyncPredicateCalls += 1u;
        TaskCompletionSource<bool> completion =
            new TaskCompletionSource<bool>();
        TaskScheduler.PostAfter(1u, () => completion.SetCanceled());
        return completion.GetTask();
    }



    public static int ReadSortKey(SortValue value) {
        SortKeyCalls += 1u;
        return value.Key;
    }

    public static int ReadSecondarySortKey(SortValue value) {
        SecondarySortKeyCalls += 1u;
        return value.Secondary;
    }

    public static int ReadTertiarySortKey(SortValue value) {
        TertiarySortKeyCalls += 1u;
        return value.Id;
    }

    public static int ReadFourthSortKey(SortValue value) {
        FourthSortKeyCalls += 1u;
        return value.Secondary;
    }

    public static int ReadFifthSortKey(SortValue value) {
        FifthSortKeyCalls += 1u;
        return value.Id;
    }

    public static int ReadSixthSortKey(SortValue value) {
        SixthSortKeyCalls += 1u;
        return value.Id;
    }

    public static int ReadSeventhSortKey(SortValue value) {
        SeventhSortKeyCalls += 1u;
        return value.Secondary;
    }

    public static int ReadEighthSortKey(SortValue value) {
        EighthSortKeyCalls += 1u;
        return value.Secondary;
    }


    public static int ReadConstantSecondarySortKey(SortValue value) {
        SecondarySortKeyCalls += 1u;
        return 0;
    }

    public static int ReadConstantTertiarySortKey(SortValue value) {
        TertiarySortKeyCalls += 1u;
        return 0;
    }

    public static int CompareInt(int left, int right) {
        if (left < right) {
            return -1;
        }
        if (left > right) {
            return 1;
        }
        return 0;
    }

    public static int CompareThenThrow(int left, int right) {
        ComparerCalls += 1u;
        if (ComparerCalls == 2u) {
            throw new System.ArgumentOutOfRangeException("comparer");
        }
        return CompareInt(left, right);
    }

    public static int ReadThrowingSortKey(int value) {
        ThrowingSortKeyCalls += 1u;
        if (ThrowingSortKeyCalls == 2u) {
            throw new System.InvalidOperationException("sort key failure");
        }
        return value;
    }

    public static int ReadSortKeyAndAppend(int value) {
        SortMutationKeyCalls += 1u;
        if (SortMutationKeyCalls == 1u) {
            SortMutationList.Add(0);
        }
        return value;
    }

    public static int ReadThrowingTertiarySortKey(int value) {
        ThrowingTertiarySortKeyCalls += 1u;
        if (ThrowingTertiarySortKeyCalls == 2u) {
            throw new System.InvalidOperationException("tertiary sort key failure");
        }
        return value;
    }

    public static int ReadThrowingFourthSortKey(int value) {
        ThrowingFourthSortKeyCalls += 1u;
        if (ThrowingFourthSortKeyCalls == 2u) {
            throw new System.InvalidOperationException("fourth sort key failure");
        }
        return value;
    }

    public static int ReadThrowingFifthSortKey(int value) {
        ThrowingFifthSortKeyCalls += 1u;
        if (ThrowingFifthSortKeyCalls == 2u) {
            throw new System.InvalidOperationException("fifth sort key failure");
        }
        return value;
    }

    public static bool ThrowFromFilter(int value) {
        ThrowingFilterCalls += 1u;
        throw new System.InvalidOperationException("filter failure");
    }

    public static int ThrowFromMap(int value) {
        ThrowingMapCalls += 1u;
        throw new System.InvalidOperationException("map failure");
    }
}

public final class SourceProbeException : System.Exception {
    public constructor() : base() { }
}

public final class SortValue {
    public int Key;
    public int Id;
    public int Secondary;

    public constructor(int key, int id, int secondary) {
        Key = key;
        Id = id;
        Secondary = secondary;
    }
}

public final class ProjectionReference {
    public int Value;
    public int Derived;

    public constructor(int value, int derived) {
        Value = value;
        Derived = derived;
    }
}

public struct ProjectionValue {
    public int Value;
    public int Derived;

    public constructor(int value, int derived) {
        Value = value;
        Derived = derived;
    }
}

public final class ProbeSequence : IEnumerable<int> {
    public uint MoveCalls;
    public uint DisposeCalls;
    public uint ThrowOnMoveCall;
    public bool ThrowOnGetEnumerator;
    public bool ThrowOnCurrent;
    public bool ThrowOnDispose;
    public bool Infinite;

    public IEnumerator<int> GetEnumerator() const {
        if (ThrowOnGetEnumerator) {
            throw new SourceProbeException();
        }
        return new ProbeEnumerator(this);
    }
}

public final class ProbeEnumerator : IEnumerator<int> {
    private ProbeSequence _owner;
    private int _current;

    public int Current {
        const get {
            if (_owner.ThrowOnCurrent) {
                throw new SourceProbeException();
            }
            return _current;
        }
    }

    public constructor(ProbeSequence owner) {
        _owner = owner;
        _current = 0;
    }

    public bool MoveNext() {
        _owner.MoveCalls += 1u;
        if (_owner.ThrowOnMoveCall != 0u &&
            _owner.MoveCalls == _owner.ThrowOnMoveCall) {
            throw new SourceProbeException();
        }
        if (_owner.Infinite) {
            _current += 1;
            return true;
        }
        if (_current >= 6) {
            return false;
        }
        _current += 1;
        return true;
    }

    public void Dispose() {
        _owner.DisposeCalls += 1u;
        if (_owner.ThrowOnDispose) {
            throw new System.ArgumentOutOfRangeException("cleanup");
        }
    }
}

public final class AsyncDisposeProbeException : System.Exception {
    public constructor() : base() { }
}

public final class AsyncProbeSequence : IAsyncEnumerable<int> {
    public uint Mode;
    public uint Count;
    public uint MoveCalls;
    public uint DisposeCalls;
    public bool Empty;
    public bool ThrowOnGetAsyncEnumerator;
    public bool ReturnNullAsyncEnumerator;
    public bool ThrowOnCurrent;
    public CancellationToken LastCancellationToken;
    public bool HoldMove;
    public TaskCompletionSource<bool> PendingMove;
    public bool PendingDispose;
    public bool DisposeFault;
    public bool DisposeCompleted;

    public IAsyncEnumerator<int> GetAsyncEnumerator(
        CancellationToken cancellationToken) {
        LastCancellationToken = cancellationToken;
        if (ThrowOnGetAsyncEnumerator) {
            throw new System.InvalidOperationException(
                "async source open failure");
        }
        if (ReturnNullAsyncEnumerator) {
            return null;
        }
        return new AsyncProbeEnumerator(this, cancellationToken);
    }

    public void CompleteMove(TaskCompletionSource<bool> completion) {
        completion.SetResult(true);
    }

    public void CompletePendingMove() {
        TaskCompletionSource<bool> completion = PendingMove;
        completion.SetResult(true);
    }

    public void CompleteDispose(TaskCompletionSource completion) {
        DisposeCompleted = true;
        if (DisposeFault) {
            completion.SetException(new AsyncDisposeProbeException());
        } else {
            completion.SetResult();
        }
    }
}

internal final class AsyncStringListSequence : IAsyncEnumerable<string> {
    private List<string> _values;

    internal constructor(List<string> values) {
        _values = values;
    }

    public IAsyncEnumerator<string> GetAsyncEnumerator(
        CancellationToken cancellationToken) {
        return new AsyncStringListEnumerator(_values);
    }
}

internal final class AsyncStringListEnumerator : IAsyncEnumerator<string> {
    private List<string> _values;
    private int _index;

    internal constructor(List<string> values) {
        _values = values;
        _index = -1;
    }

    public string Current {
        const get { return _values.Get((uint)_index); }
    }

    public ValueTask<bool> MoveNextAsync() {
        _index += 1;
        return new ValueTask<bool>((uint)_index < _values.Count);
    }

    public ValueTask DisposeAsync() {
        return new ValueTask();
    }
}

internal final class AsyncSortValueListSequence :
    IAsyncEnumerable<SortValue> {
    private List<SortValue> _values;
    public uint MoveCalls;
    public uint DisposeCalls;

    internal constructor(List<SortValue> values) {
        _values = values;
        MoveCalls = 0u;
        DisposeCalls = 0u;
    }

    public IAsyncEnumerator<SortValue> GetAsyncEnumerator(
        CancellationToken cancellationToken) {
        return new AsyncSortValueListEnumerator(this, _values);
    }
}

internal final class AsyncSortValueListEnumerator :
    IAsyncEnumerator<SortValue> {
    private AsyncSortValueListSequence _owner;
    private List<SortValue> _values;
    private uint _index;

    internal constructor(
        AsyncSortValueListSequence owner,
        List<SortValue> values) {
        _owner = owner;
        _values = values;
        _index = 0u;
    }

    public SortValue Current { const get { return _values.Get(_index - 1u); } }

    public ValueTask<bool> MoveNextAsync() {
        _owner.MoveCalls += 1u;
        bool moved = _index < _values.Count;
        if (moved) { _index += 1u; }
        return new ValueTask<bool>(moved);
    }

    public ValueTask DisposeAsync() {
        _owner.DisposeCalls += 1u;
        _owner = default;
        _values = default;
        return new ValueTask();
    }
}

public final class AsyncProbeEnumerator : IAsyncEnumerator<int> {
    private AsyncProbeSequence _owner;
    private CancellationToken _cancellationToken;
    private int _current;

    public int Current {
        const get {
            if (_owner.ThrowOnCurrent) {
                throw new SourceProbeException();
            }
            return _current;
        }
    }

    public constructor(
        AsyncProbeSequence owner,
        CancellationToken cancellationToken) {
        _owner = owner;
        _cancellationToken = cancellationToken;
        _current = 0;
    }

    public ValueTask<bool> MoveNextAsync() {
        _owner.MoveCalls += 1u;
        if (_cancellationToken.IsCancellationRequested || _owner.Mode == 2u) {
            Task<bool> canceledTask = new Task<bool>();
            canceledTask.SetCanceled();
            ValueTask<bool> canceled;
            canceled.SetTask(canceledTask);
            return canceled;
        }
        if (_owner.Mode == 3u) {
            Task<bool> faultedTask = new Task<bool>();
            faultedTask.SetFault(
                new System.InvalidOperationException("async move failure"));
            ValueTask<bool> faulted;
            faulted.SetTask(faultedTask);
            return faulted;
        }
        if (_owner.Empty) { return new ValueTask<bool>(false); }
        if (_owner.HoldMove ||
            (_owner.Mode == 1u && _owner.MoveCalls == 1u)) {
            _current = 42;
            TaskCompletionSource<bool> completion =
                new TaskCompletionSource<bool>();
            if (_owner.HoldMove) {
                _owner.PendingMove = completion;
            } else {
                AsyncProbeSequence owner = _owner;
                TaskScheduler.PostAfter(1u, () => owner.CompleteMove(completion));
            }
            ValueTask<bool> pending;
            pending.SetTask(completion.GetTask());
            return pending;
        }
        uint count = _owner.Count == 0u ? 1u : _owner.Count;
        if (_owner.MoveCalls <= count) {
            _current = 41 + (int)_owner.MoveCalls;
            return new ValueTask<bool>(true);
        }
        return new ValueTask<bool>(false);
    }

    public ValueTask DisposeAsync() {
        _owner.DisposeCalls += 1u;
        if (_owner.PendingDispose) {
            TaskCompletionSource completion = new TaskCompletionSource();
            AsyncProbeSequence owner = _owner;
            TaskScheduler.PostAfter(1u, () => owner.CompleteDispose(completion));
            return new ValueTask(completion.Task);
        }
        _owner.DisposeCompleted = true;
        return new ValueTask();
    }
}

public final class AsyncTokenEnumerable : IAsyncEnumerable<int> {
    private IAsyncEnumerable<int> _source;
    private CancellationToken _cancellationToken;

    public constructor(
        IAsyncEnumerable<int> source,
        CancellationToken cancellationToken) {
        _source = source;
        _cancellationToken = cancellationToken;
    }

    public IAsyncEnumerator<int> GetAsyncEnumerator(
        CancellationToken ignored) {
        return _source.GetAsyncEnumerator(_cancellationToken);
    }
}

Task<List<T>> CreateEmptyGenericResult<T>() {
    return new Task<List<T>>(new List<T>());
}

internal final class FixtureAsyncCaptureSnapshot {
    private List<QueryCapture<int>> _cells;
    private List<int> _values;

    internal constructor() {
        _cells = new List<QueryCapture<int>>();
        _values = new List<int>();
    }

    internal void Capture(QueryCapture<int> cell) {
        if (cell == null) {
            throw new System.InvalidOperationException(
                "The fixture capture expression has no cell.");
        }
        for (uint index = 0u; index < _cells.Count; index += 1u) {
            if (_cells.Get(index) == cell) { return; }
        }
        _cells.Add(cell);
        _values.Add(cell.Value);
    }

    internal int Read(QueryCapture<int> cell) {
        for (uint index = 0u; index < _cells.Count; index += 1u) {
            if (_cells.Get(index) == cell) {
                return _values.Get(index);
            }
        }
        throw new System.InvalidOperationException(
            "The fixture capture was not snapshotted for execution.");
    }
}

internal final class FixtureGenericCaptureSnapshot<T> {
    private List<QueryCapture<T>> _cells;
    private List<T> _values;

    internal constructor() {
        _cells = new List<QueryCapture<T>>();
        _values = new List<T>();
    }

    internal void Capture(QueryCapture<T> cell) {
        if (cell == null) {
            throw new System.InvalidOperationException(
                "The fixture generic capture has no cell.");
        }
        for (uint index = 0u; index < _cells.Count; index += 1u) {
            if (_cells.Get(index) == cell) { return; }
        }
        _cells.Add(cell);
        _values.Add(cell.Value);
    }

    internal T Read(QueryCapture<T> cell) {
        for (uint index = 0u; index < _cells.Count; index += 1u) {
            if (_cells.Get(index) == cell) {
                return _values.Get(index);
            }
        }
        throw new System.InvalidOperationException(
            "The fixture generic capture was not snapshotted for execution.");
    }
}

internal final class FixtureQueryLocal {
    internal string Name;
    internal int Value;
    internal FixtureQueryLocal Parent;

    internal constructor(string name, int value, FixtureQueryLocal parent) {
        Name = name;
        Value = value;
        Parent = parent;
    }
}

internal final class FixtureGenericPlanExecutor<T> {
    internal List<T> Execute(QueryPlan<T> plan) {
        QueryPlanValidator.Validate(plan);
        QueryPlan<T> current = plan;
        List<QueryPlan<T>> stages = new List<QueryPlan<T>>();
        while (current != null && current.Kind != "Source") {
            if (current.Kind != "Filter" && current.Kind != "Select" &&
                current.Kind != "OrderBy" &&
                current.Kind != "OrderByDescending" &&
                current.Kind != "ThenOrderBy" &&
                current.Kind != "ThenOrderByDescending" &&
                current.Kind != "Skip" &&
                current.Kind != "Take" && current.Kind != "Page") {
                throw new System.InvalidOperationException(
                    "The fixture generic provider does not execute this operator.");
            }
            stages.Add(current);
            current = current.Source as QueryPlan<T>;
        }
        if (current == null || current.Kind != "Source") {
            throw new System.InvalidOperationException(
                "The fixture generic provider requires a source plan.");
        }
        List<T> source = current.Source as List<T>;
        if (source == null) {
            throw new System.InvalidOperationException(
                "The fixture generic provider source payload must be a list.");
        }

        FixtureGenericCaptureSnapshot<T> captures =
            new FixtureGenericCaptureSnapshot<T>();
        for (uint stageIndex = 0u; stageIndex < stages.Count; stageIndex += 1u) {
            QueryPlan<T> stage = stages.Get(stageIndex);
            if (stage.Kind == "Filter") {
                QueryLambda<T, bool> predicate =
                    stage.Expression as QueryLambda<T, bool>;
                if (predicate == null || predicate.Body == null) {
                    throw new System.InvalidOperationException(
                        "The fixture generic filter requires a typed predicate.");
                }
                object bodyObject = predicate.Body;
                QueryExpression<bool> body =
                    bodyObject as QueryExpression<bool>;
                if (!IsBooleanExpression(body)) {
                    throw new System.InvalidOperationException(
                        "The fixture generic provider does not evaluate this predicate.");
                }
                CaptureBoolean(body, captures);
            } else if (stage.Kind == "Select") {
                QueryLambda<T, T> selector =
                    stage.Expression as QueryLambda<T, T>;
                if (selector == null || selector.Body == null) {
                    throw new System.InvalidOperationException(
                        "The fixture generic projection requires a typed selector.");
                }
                object selectorBody = selector.Body;
                CaptureValue(
                    selectorBody as QueryExpression<T>, captures);
            } else if (stage.Kind == "OrderBy" ||
                stage.Kind == "OrderByDescending" ||
                stage.Kind == "ThenOrderBy" ||
                stage.Kind == "ThenOrderByDescending") {
                QueryLambda<T, T> keySelector =
                    stage.Expression as QueryLambda<T, T>;
                if (keySelector == null || keySelector.Body == null) {
                    throw new System.InvalidOperationException(
                        "The fixture generic ordering requires an integer key selector.");
                }
                object keyBodyObject = keySelector.Body;
                QueryExpression<int> keyBody =
                    keyBodyObject as QueryExpression<int>;
                if (!IsIntegerExpression(keyBody)) {
                    throw new System.InvalidOperationException(
                        "The fixture generic provider does not evaluate this order key.");
                }
                CaptureInteger(keyBody, captures);
            }
        }

        List<T> values = new List<T>();
        for (uint index = 0u; index < source.Count; index += 1u) {
            values.Add(source.Get(index));
        }
        for (uint stageIndex = stages.Count; stageIndex > 0u;
            stageIndex -= 1u) {
            QueryPlan<T> stage = stages.Get(stageIndex - 1u);
            if (stage.Kind == "Filter") {
                values = FilterValues(
                    values, stage.Expression as QueryLambda<T, bool>, captures);
            } else if (stage.Kind == "Select") {
                values = SelectValues(
                    values, stage.Expression as QueryLambda<T, T>, captures);
            } else if (stage.Kind == "OrderBy" ||
                stage.Kind == "OrderByDescending") {
                values = OrderValues(
                    values, stages, captures);
            } else if (stage.Kind == "ThenOrderBy" ||
                stage.Kind == "ThenOrderByDescending") {
                // The primary key applies the complete stable key chain.
            } else {
                uint start = 0u;
                uint count = values.Count;
                if (stage.Kind == "Skip") {
                    start = stage.Count < count ? stage.Count : count;
                    count -= start;
                } else if (stage.Kind == "Take") {
                    if (stage.Count < count) { count = stage.Count; }
                } else {
                    start = stage.Count < count ? stage.Count : count;
                    count -= start;
                    if (stage.SecondCount < count) {
                        count = stage.SecondCount;
                    }
                }
                List<T> window = new List<T>();
                for (uint index = start; index < start + count; index += 1u) {
                    window.Add(values.Get(index));
                }
                values = window;
            }
        }
        return values;
    }

    private List<T> OrderValues(
        List<T> source,
        List<QueryPlan<T>> stages,
        FixtureGenericCaptureSnapshot<T> captures) {
        List<QueryExpression<int>> keys = new List<QueryExpression<int>>();
        List<bool> descending = new List<bool>();
        for (uint stageIndex = stages.Count; stageIndex > 0u;
            stageIndex -= 1u) {
            QueryPlan<T> stage = stages.Get(stageIndex - 1u);
            if (stage.Kind != "OrderBy" &&
                stage.Kind != "OrderByDescending" &&
                stage.Kind != "ThenOrderBy" &&
                stage.Kind != "ThenOrderByDescending") {
                continue;
            }
            QueryLambda<T, T> keySelector =
                stage.Expression as QueryLambda<T, T>;
            object bodyObject = keySelector == null ? null : keySelector.Body;
            QueryExpression<int> body =
                bodyObject as QueryExpression<int>;
            if (!IsIntegerExpression(body)) {
                throw new System.InvalidOperationException(
                    "The fixture generic provider does not evaluate this order key.");
            }
            keys.Add(body);
            descending.Add(stage.Kind == "OrderByDescending" ||
                stage.Kind == "ThenOrderByDescending");
        }
        if (keys.Count == 0u || keys.Count > 8u) {
            throw new System.InvalidOperationException(
                "The fixture generic ordering supports one through eight integer keys.");
        }
        List<T> ordered = new List<T>();
        for (uint index = 0u; index < source.Count; index += 1u) {
            ordered.Add(source.Get(index));
        }
        for (uint index = 1u; index < ordered.Count; index += 1u) {
            T item = ordered.Get(index);
            int itemValue = (int)(item as object);
            uint insertAt = index;
            while (insertAt > 0u) {
                T previous = ordered.Get(insertAt - 1u);
                int previousValue = (int)(previous as object);
                bool shouldMove = false;
                for (uint keyIndex = 0u; keyIndex < keys.Count;
                    keyIndex += 1u) {
                    int previousKey = EvaluateIntegerExpression(
                        keys.Get(keyIndex), previousValue, captures);
                    int itemKey = EvaluateIntegerExpression(
                        keys.Get(keyIndex), itemValue, captures);
                    if (previousKey == itemKey) { continue; }
                    shouldMove = descending.Get(keyIndex)
                        ? previousKey < itemKey
                        : previousKey > itemKey;
                    break;
                }
                if (!shouldMove) { break; }
                ordered.Set(insertAt, previous);
                insertAt -= 1u;
            }
            ordered.Set(insertAt, item);
        }
        return ordered;
    }

    private List<T> SelectValues(
        List<T> source,
        QueryLambda<T, T> selector,
        FixtureGenericCaptureSnapshot<T> captures) {
        if (selector == null || selector.Body == null) {
            throw new System.InvalidOperationException(
                "The fixture generic projection requires a typed selector.");
        }
        object bodyObject = selector.Body;
        QueryExpression<T> body = bodyObject as QueryExpression<T>;
        if (body == null) {
            throw new System.InvalidOperationException(
                "The fixture generic projection requires a typed body.");
        }
        List<T> result = new List<T>();
        for (uint index = 0u; index < source.Count; index += 1u) {
            T value = source.Get(index);
            object integerBodyObject = body;
            QueryExpression<int> integerBody =
                integerBodyObject as QueryExpression<int>;
            if (integerBody != null && IsIntegerExpression(integerBody)) {
                object boxedValue = value as object;
                int integerValue = (int)boxedValue;
                int projectedValue = EvaluateIntegerExpression(
                    integerBody, integerValue, captures);
                object boxedProjection = projectedValue as object;
                result.Add((T)boxedProjection);
            } else {
                result.Add(EvaluateValue(body, value, captures));
            }
        }
        return result;
    }

    private List<T> FilterValues(
        List<T> source,
        QueryLambda<T, bool> predicate,
        FixtureGenericCaptureSnapshot<T> captures) {
        if (predicate == null || predicate.Body == null) {
            throw new System.InvalidOperationException(
                "The fixture generic filter requires a typed predicate.");
        }
        object bodyObject = predicate.Body;
        QueryExpression<bool> body = bodyObject as QueryExpression<bool>;
        if (!IsBooleanExpression(body)) {
            throw new System.InvalidOperationException(
                "The fixture generic provider does not evaluate this predicate.");
        }
        List<T> result = new List<T>();
        for (uint index = 0u; index < source.Count; index += 1u) {
            T value = source.Get(index);
            if (EvaluateBooleanExpression(body, value, captures)) {
                result.Add(value);
            }
        }
        return result;
    }

    private bool IsBooleanExpression(QueryExpression<bool> expression) {
        if (expression == null) { return false; }
        if (expression.Kind == "Constant") {
            return expression.ConstantValue != null;
        }
        if (expression.Kind == "Not") {
            return IsBooleanExpression(
                expression.Left as QueryExpression<bool>);
        }
        if (expression.Kind == "AndAlso" || expression.Kind == "OrElse") {
            return IsBooleanExpression(
                    expression.Left as QueryExpression<bool>) &&
                IsBooleanExpression(
                    expression.Right as QueryExpression<bool>);
        }
        QueryExpression<int> leftInteger =
            expression.Left as QueryExpression<int>;
        QueryExpression<int> rightInteger =
            expression.Right as QueryExpression<int>;
        bool isIntegerComparison = expression.Kind == "Equal" ||
            expression.Kind == "NotEqual" ||
            expression.Kind == "GreaterThan" ||
            expression.Kind == "GreaterThanOrEqual" ||
            expression.Kind == "LessThan" ||
            expression.Kind == "LessThanOrEqual";
        if (leftInteger != null && rightInteger != null &&
            isIntegerComparison) {
            return IsIntegerExpression(leftInteger) &&
                IsIntegerExpression(rightInteger) &&
                HasCompatibleIntegerCaptures(leftInteger) &&
                HasCompatibleIntegerCaptures(rightInteger);
        }
        if (expression.Kind != "Equal" && expression.Kind != "NotEqual") {
            return false;
        }
        return IsValueExpression(
                expression.Left as QueryExpression<T>) &&
            IsValueExpression(expression.Right as QueryExpression<T>);
    }

    internal bool IsBooleanExpressionForStream(
        QueryExpression<bool> expression) {
        return IsBooleanExpression(expression);
    }

    private bool IsValueExpression(QueryExpression<T> expression) {
        return expression != null &&
            (expression.Kind == "Parameter" ||
                expression.Kind == "Constant" ||
                expression.Kind == "CapturedValue");
    }

    private void CaptureBoolean(
        QueryExpression<bool> expression,
        FixtureGenericCaptureSnapshot<T> captures) {
        if (expression.Kind == "Not") {
            CaptureBoolean(
                expression.Left as QueryExpression<bool>, captures);
        } else if (expression.Kind == "AndAlso" ||
            expression.Kind == "OrElse") {
            CaptureBoolean(
                expression.Left as QueryExpression<bool>, captures);
            CaptureBoolean(
                expression.Right as QueryExpression<bool>, captures);
        } else {
            CaptureInteger(
                expression.Left as QueryExpression<int>, captures);
            CaptureInteger(
                expression.Right as QueryExpression<int>, captures);
            CaptureValue(
                expression.Left as QueryExpression<T>, captures);
            CaptureValue(
                expression.Right as QueryExpression<T>, captures);
        }
    }

    internal void CaptureBooleanForStream(
        QueryExpression<bool> expression,
        FixtureGenericCaptureSnapshot<T> captures) {
        CaptureBoolean(expression, captures);
    }

    internal bool IsIntegerExpressionForStream(
        QueryExpression<int> expression) {
        return IsIntegerExpression(expression) &&
            HasCompatibleIntegerCaptures(expression);
    }

    internal void CaptureIntegerForStream(
        QueryExpression<int> expression,
        FixtureGenericCaptureSnapshot<T> captures) {
        CaptureInteger(expression, captures);
    }

    internal int EvaluateIntegerForStream(
        QueryExpression<int> expression,
        int value,
        FixtureGenericCaptureSnapshot<T> captures) {
        return EvaluateIntegerExpression(expression, value, captures);
    }

    private void CaptureInteger(
        QueryExpression<int> expression,
        FixtureGenericCaptureSnapshot<T> captures) {
        if (expression == null) { return; }
        if (expression.Kind == "CapturedValue") {
            QueryCapture<T> cell =
                expression.ConstantValue as QueryCapture<T>;
            captures.Capture(cell);
        } else if (expression.Kind == "Add" ||
            expression.Kind == "Subtract" ||
            expression.Kind == "Multiply" ||
            expression.Kind == "Divide" ||
            expression.Kind == "Modulo") {
            CaptureInteger(
                expression.Left as QueryExpression<int>, captures);
            CaptureInteger(
                expression.Right as QueryExpression<int>, captures);
        }
    }

    internal bool EvaluateBooleanExpression(
        QueryExpression<bool> expression,
        T value,
        FixtureGenericCaptureSnapshot<T> captures) {
        if (expression.Kind == "Constant") {
            return (bool)expression.ConstantValue;
        }
        if (expression.Kind == "Not") {
            return !EvaluateBooleanExpression(
                expression.Left as QueryExpression<bool>, value, captures);
        }
        if (expression.Kind == "AndAlso") {
            return EvaluateBooleanExpression(
                    expression.Left as QueryExpression<bool>, value, captures) &&
                EvaluateBooleanExpression(
                    expression.Right as QueryExpression<bool>, value, captures);
        }
        if (expression.Kind == "OrElse") {
            return EvaluateBooleanExpression(
                    expression.Left as QueryExpression<bool>, value, captures) ||
                EvaluateBooleanExpression(
                    expression.Right as QueryExpression<bool>, value, captures);
        }
        QueryExpression<int> leftInteger =
            expression.Left as QueryExpression<int>;
        QueryExpression<int> rightInteger =
            expression.Right as QueryExpression<int>;
        if (leftInteger != null && rightInteger != null &&
            IsIntegerExpression(leftInteger) &&
            IsIntegerExpression(rightInteger)) {
            int integerValue = 0;
            if (HasIntegerParameter(leftInteger) ||
                HasIntegerParameter(rightInteger)) {
                object boxedValue = value as object;
                integerValue = (int)boxedValue;
            }
            int left = EvaluateIntegerExpression(
                leftInteger, integerValue, captures);
            int right = EvaluateIntegerExpression(
                rightInteger, integerValue, captures);
            if (expression.Kind == "Equal") { return left == right; }
            if (expression.Kind == "NotEqual") { return left != right; }
            if (expression.Kind == "GreaterThan") { return left > right; }
            if (expression.Kind == "GreaterThanOrEqual") { return left >= right; }
            if (expression.Kind == "LessThan") { return left < right; }
            if (expression.Kind == "LessThanOrEqual") { return left <= right; }
        }
        QueryExpression<T> leftExpression =
            expression.Left as QueryExpression<T>;
        QueryExpression<T> rightExpression =
            expression.Right as QueryExpression<T>;
        T leftValue = EvaluateValue(leftExpression, value, captures);
        T rightValue = EvaluateValue(rightExpression, value, captures);
        bool equal = leftValue == rightValue;
        return expression.Kind == "Equal" ? equal : !equal;
    }

    private bool IsIntegerExpression(QueryExpression<int> expression) {
        if (expression == null) { return false; }
        if (expression.Kind == "Parameter" || expression.Kind == "Constant" ||
            expression.Kind == "CapturedValue") {
            return true;
        }
        if (expression.Kind != "Add" && expression.Kind != "Subtract" &&
            expression.Kind != "Multiply" && expression.Kind != "Divide" &&
            expression.Kind != "Modulo") {
            return false;
        }
        return IsIntegerExpression(
                expression.Left as QueryExpression<int>) &&
            IsIntegerExpression(
                expression.Right as QueryExpression<int>);
    }

    private bool HasCompatibleIntegerCaptures(
        QueryExpression<int> expression) {
        if (expression == null) { return true; }
        if (expression.Kind == "CapturedValue") {
            return expression.ConstantValue as QueryCapture<T> != null;
        }
        return HasCompatibleIntegerCaptures(
                expression.Left as QueryExpression<int>) &&
            HasCompatibleIntegerCaptures(
                expression.Right as QueryExpression<int>);
    }

    private bool HasIntegerParameter(QueryExpression<int> expression) {
        if (expression == null) { return false; }
        if (expression.Kind == "Parameter") { return true; }
        return HasIntegerParameter(
                expression.Left as QueryExpression<int>) ||
            HasIntegerParameter(
                expression.Right as QueryExpression<int>);
    }

    private void CaptureValue(
        QueryExpression<T> expression,
        FixtureGenericCaptureSnapshot<T> captures) {
        if (expression == null) { return; }
        if (expression.Kind == "CapturedValue") {
            QueryCapture<T> cell =
                expression.ConstantValue as QueryCapture<T>;
            captures.Capture(cell);
        } else if (expression.Kind == "Add" ||
            expression.Kind == "Subtract" ||
            expression.Kind == "Multiply" ||
            expression.Kind == "Divide" ||
            expression.Kind == "Modulo") {
            CaptureValue(
                expression.Left as QueryExpression<T>, captures);
            CaptureValue(
                expression.Right as QueryExpression<T>, captures);
        }
    }

    private int EvaluateIntegerExpression(
        QueryExpression<int> expression,
        int value,
        FixtureGenericCaptureSnapshot<T> captures) {
        if (expression.Kind == "Parameter") { return value; }
        if (expression.Kind == "Constant") {
            return (int)expression.ConstantValue;
        }
        if (expression.Kind == "CapturedValue") {
            QueryCapture<T> cell =
                expression.ConstantValue as QueryCapture<T>;
            object capturedValue = captures.Read(cell) as object;
            return (int)capturedValue;
        }
        int left = EvaluateIntegerExpression(
            expression.Left as QueryExpression<int>, value, captures);
        int right = EvaluateIntegerExpression(
            expression.Right as QueryExpression<int>, value, captures);
        if (expression.Kind == "Add") { return left + right; }
        if (expression.Kind == "Subtract") { return left - right; }
        if (expression.Kind == "Multiply") { return left * right; }
        if (expression.Kind == "Divide") { return left / right; }
        if (expression.Kind == "Modulo") { return left % right; }
        throw new System.InvalidOperationException(
            "The fixture generic provider does not evaluate this integer expression.");
    }

    private T EvaluateValue(
        QueryExpression<T> expression,
        T value,
        FixtureGenericCaptureSnapshot<T> captures) {
        if (expression.Kind == "Parameter") { return value; }
        if (expression.Kind == "Constant") {
            return (T)expression.ConstantValue;
        }
        if (expression.Kind == "CapturedValue") {
            QueryCapture<T> cell =
                expression.ConstantValue as QueryCapture<T>;
            return captures.Read(cell);
        }
        throw new System.InvalidOperationException(
            "The fixture generic provider only evaluates parameters, constants, and captures.");
    }

    internal IAsyncEnumerable<T> Stream(QueryPlan<T> plan) {
        object planObject = plan;
        QueryPlan<int> integerPlan = planObject as QueryPlan<int>;
        if (integerPlan != null) {
            IAsyncEnumerable<int> integerStream =
                new FixtureIntegerStreamExecutor().Stream(integerPlan);
            return integerStream as IAsyncEnumerable<T>;
        }
        QueryPlanValidator.Validate(plan);
        QueryPlan<T> current = plan;
        List<QueryPlan<T>> stages = new List<QueryPlan<T>>();
        while (current != null && current.Kind != "Source") {
            if (current.Kind != "Filter" && current.Kind != "Skip" &&
                current.Kind != "Take" && current.Kind != "Page") {
                throw new System.InvalidOperationException(
                    "The fixture generic provider only streams filters and source windows.");
            }
            stages.Add(current);
            current = current.Source as QueryPlan<T>;
        }
        if (current == null || current.Kind != "Source") {
            throw new System.InvalidOperationException(
                "The fixture generic stream requires a source plan.");
        }
        IAsyncEnumerable<T> stream = current.Source as IAsyncEnumerable<T>;
        if (stream == null) {
            throw new System.InvalidOperationException(
                "The fixture generic stream source must be async enumerable.");
        }
        FixtureGenericPlanExecutor<T> evaluator =
            new FixtureGenericPlanExecutor<T>();
        FixtureGenericCaptureSnapshot<T> captures =
            new FixtureGenericCaptureSnapshot<T>();
        for (uint stageIndex = 0u; stageIndex < stages.Count;
            stageIndex += 1u) {
            QueryPlan<T> stage = stages.Get(stageIndex);
            if (stage.Kind != "Filter") { continue; }
            QueryLambda<T, bool> predicate =
                stage.Expression as QueryLambda<T, bool>;
            if (predicate == null || predicate.Body == null) {
                throw new System.InvalidOperationException(
                    "The fixture generic stream filter requires a typed predicate.");
            }
            object bodyObject = predicate.Body;
            QueryExpression<bool> body = bodyObject as QueryExpression<bool>;
            if (!evaluator.IsBooleanExpressionForStream(body)) {
                throw new System.InvalidOperationException(
                    "The fixture generic stream does not evaluate this predicate.");
            }
            evaluator.CaptureBooleanForStream(body, captures);
        }
        for (uint stageIndex = stages.Count; stageIndex > 0u;
            stageIndex -= 1u) {
            QueryPlan<T> stage = stages.Get(stageIndex - 1u);
            if (stage.Kind == "Filter") {
                QueryLambda<T, bool> predicate =
                    stage.Expression as QueryLambda<T, bool>;
                object bodyObject = predicate.Body;
                QueryExpression<bool> body =
                    bodyObject as QueryExpression<bool>;
                FixtureGenericStreamPredicate<T> streamPredicate =
                    new FixtureGenericStreamPredicate<T>(
                        evaluator, body, captures);
                stream = stream.Filter(
                    value => streamPredicate.Matches(value));
            } else if (stage.Kind == "Skip") {
                stream = stream.Skip(stage.Count);
            } else if (stage.Kind == "Take") {
                stream = stream.Take(stage.Count);
            } else {
                stream = stream.Skip(stage.Count).Take(stage.SecondCount);
            }
        }
        return stream;
    }

    internal Task<List<T>> ExecuteAsync(
        QueryPlan<T> plan,
        CancellationToken cancellationToken) {
        Task<List<T>> result = new Task<List<T>>();
        if (cancellationToken.IsCancellationRequested) {
            result.SetCanceled();
            return result;
        }
        try {
            result.SetResult(Execute(plan));
        } catch (System.Exception error) {
            result.SetFault(error);
        }
        return result;
    }
}

internal final class FixtureGenericStreamPredicate<T> {
    private FixtureGenericPlanExecutor<T> _executor;
    private QueryExpression<bool> _body;
    private FixtureGenericCaptureSnapshot<T> _captures;

    internal constructor(
        FixtureGenericPlanExecutor<T> executor,
        QueryExpression<bool> body,
        FixtureGenericCaptureSnapshot<T> captures) {
        _executor = executor;
        _body = body;
        _captures = captures;
    }

    internal bool Matches(T value) {
        return _executor.EvaluateBooleanExpression(_body, value, _captures);
    }
}

internal final class FixtureIntegerStreamPredicate {
    private FixtureGenericPlanExecutor<int> _executor;
    private QueryExpression<bool> _body;
    private FixtureGenericCaptureSnapshot<int> _captures;

    internal constructor(
        FixtureGenericPlanExecutor<int> executor,
        QueryExpression<bool> body,
        FixtureGenericCaptureSnapshot<int> captures) {
        _executor = executor;
        _body = body;
        _captures = captures;
    }

    internal bool Matches(int value) {
        return _executor.EvaluateBooleanExpression(_body, value, _captures);
    }
}

internal final class FixtureIntegerStreamSelector {
    private FixtureGenericPlanExecutor<int> _executor;
    private QueryExpression<int> _body;
    private FixtureGenericCaptureSnapshot<int> _captures;

    internal constructor(
        FixtureGenericPlanExecutor<int> executor,
        QueryExpression<int> body,
        FixtureGenericCaptureSnapshot<int> captures) {
        _executor = executor;
        _body = body;
        _captures = captures;
    }

    internal int Project(int value) {
        return _executor.EvaluateIntegerForStream(
            _body, value, _captures);
    }
}

internal final class FixturePeopleIntegerStreamSelector {
    private QueryExpression<int> _body;
    private FixtureAsyncCaptureSnapshot _captures;

    internal constructor(
        QueryExpression<int> body,
        FixtureAsyncCaptureSnapshot captures) {
        _body = body;
        _captures = captures;
    }

    internal int Project(SortValue value) {
        return FixtureAsyncQueryProvider.EvaluateAsyncPeopleInt(
            _body, value, _captures);
    }
}

internal final class FixturePeopleIntegerStreamPredicate {
    private QueryExpression<bool> _body;
    private FixtureAsyncCaptureSnapshot _captures;

    internal constructor(
        QueryExpression<bool> body,
        FixtureAsyncCaptureSnapshot captures) {
        _body = body;
        _captures = captures;
    }

    internal bool Matches(int value) {
        return FixtureAsyncQueryProvider.EvaluateAsyncBool(
            _body, value, _captures);
    }
}

internal final class FixtureIntegerStreamExecutor {
    internal IAsyncEnumerable<int> Stream(QueryPlan<int> plan) {
        QueryPlanValidator.Validate(plan);
        QueryPlan<int> current = plan;
        List<QueryPlan<int>> stages = new List<QueryPlan<int>>();
        while (current != null && current.Kind != "Source") {
            if (current.Kind != "Filter" && current.Kind != "Select" &&
                current.Kind != "Skip" && current.Kind != "Take" &&
                current.Kind != "Page") {
                throw new System.InvalidOperationException(
                    "The fixture integer stream does not execute this operator.");
            }
            stages.Add(current);
            if (current.Kind == "Select") {
                QueryPlan<SortValue> peopleSource =
                    current.Source as QueryPlan<SortValue>;
                if (peopleSource != null) {
                    return StreamPeopleProjection(
                        stages, current, peopleSource);
                }
            }
            current = current.Source as QueryPlan<int>;
        }
        if (current == null || current.Kind != "Source") {
            throw new System.InvalidOperationException(
                "The fixture integer stream requires a source plan.");
        }
        IAsyncEnumerable<int> stream = current.Source as IAsyncEnumerable<int>;
        if (stream == null) {
            throw new System.InvalidOperationException(
                "The fixture integer stream source must be async enumerable.");
        }
        FixtureGenericPlanExecutor<int> evaluator =
            new FixtureGenericPlanExecutor<int>();
        FixtureGenericCaptureSnapshot<int> captures =
            new FixtureGenericCaptureSnapshot<int>();
        for (uint stageIndex = 0u; stageIndex < stages.Count;
            stageIndex += 1u) {
            QueryPlan<int> stage = stages.Get(stageIndex);
            if (stage.Kind == "Filter") {
                QueryLambda<int, bool> predicate =
                    stage.Expression as QueryLambda<int, bool>;
                if (predicate == null || predicate.Body == null) {
                    throw new System.InvalidOperationException(
                        "The fixture integer stream filter requires a typed predicate.");
                }
                object bodyObject = predicate.Body;
                QueryExpression<bool> body = bodyObject as QueryExpression<bool>;
                if (!evaluator.IsBooleanExpressionForStream(body)) {
                    throw new System.InvalidOperationException(
                        "The fixture integer stream does not evaluate this predicate.");
                }
                evaluator.CaptureBooleanForStream(body, captures);
            } else if (stage.Kind == "Select") {
                QueryLambda<int, int> selector =
                    stage.Expression as QueryLambda<int, int>;
                if (selector == null || selector.Body == null) {
                    throw new System.InvalidOperationException(
                        "The fixture integer stream projection requires a typed selector.");
                }
                object bodyObject = selector.Body;
                QueryExpression<int> body =
                    bodyObject as QueryExpression<int>;
                if (!evaluator.IsIntegerExpressionForStream(body)) {
                    throw new System.InvalidOperationException(
                        "The fixture integer stream does not evaluate this projection.");
                }
                evaluator.CaptureIntegerForStream(body, captures);
            }
        }
        for (uint stageIndex = stages.Count; stageIndex > 0u;
            stageIndex -= 1u) {
            QueryPlan<int> stage = stages.Get(stageIndex - 1u);
            if (stage.Kind == "Filter") {
                QueryLambda<int, bool> predicate =
                    stage.Expression as QueryLambda<int, bool>;
                QueryExpression<bool> body = predicate.Body;
                FixtureIntegerStreamPredicate streamPredicate =
                    new FixtureIntegerStreamPredicate(
                        evaluator, body, captures);
                stream = stream.Filter(value => streamPredicate.Matches(value));
            } else if (stage.Kind == "Select") {
                QueryLambda<int, int> selector =
                    stage.Expression as QueryLambda<int, int>;
                QueryExpression<int> body = selector.Body;
                FixtureIntegerStreamSelector streamSelector =
                    new FixtureIntegerStreamSelector(
                        evaluator, body, captures);
                stream = stream.Map<int>(value => streamSelector.Project(value));
            } else if (stage.Kind == "Skip") {
                stream = stream.Skip(stage.Count);
            } else if (stage.Kind == "Take") {
                stream = stream.Take(stage.Count);
            } else {
                stream = stream.Skip(stage.Count).Take(stage.SecondCount);
            }
        }
        return stream;
    }

    private IAsyncEnumerable<int> StreamPeopleProjection(
        List<QueryPlan<int>> stages,
        QueryPlan<int> selectPlan,
        QueryPlan<SortValue> sourcePlan) {
        if (sourcePlan.Kind != "Source") {
            throw new System.InvalidOperationException(
                "The fixture cross-type stream requires a direct source projection.");
        }
        IAsyncEnumerable<SortValue> people =
            sourcePlan.Source as IAsyncEnumerable<SortValue>;
        if (people == null) {
            throw new System.InvalidOperationException(
                "The fixture cross-type stream source must be async enumerable.");
        }
        QueryLambda<SortValue, int> selector =
            selectPlan.Expression as QueryLambda<SortValue, int>;
        if (selector == null || selector.Body == null ||
            !FixtureAsyncQueryProvider.IsPeopleIntegerExpressionForStream(
                selector.Body)) {
            throw new System.InvalidOperationException(
                "The fixture cross-type stream requires an integer member expression.");
        }
        FixtureAsyncCaptureSnapshot captures =
            new FixtureAsyncCaptureSnapshot();
        FixtureAsyncQueryProvider.SnapshotIntCaptures(
            selector.Body, captures);
        FixtureGenericPlanExecutor<int> evaluator =
            new FixtureGenericPlanExecutor<int>();
        for (uint stageIndex = 0u; stageIndex < stages.Count;
            stageIndex += 1u) {
            QueryPlan<int> stage = stages.Get(stageIndex);
            if (stage.Kind == "Filter") {
                QueryLambda<int, bool> predicate =
                    stage.Expression as QueryLambda<int, bool>;
                if (predicate == null || predicate.Body == null ||
                    !evaluator.IsBooleanExpressionForStream(predicate.Body)) {
                    throw new System.InvalidOperationException(
                        "The fixture cross-type stream filter is unsupported.");
                }
                FixtureAsyncQueryProvider.SnapshotBoolCaptures(
                    predicate.Body, captures);
            } else if (stage.Kind != "Select" && stage.Kind != "Skip" &&
                stage.Kind != "Take" && stage.Kind != "Page") {
                throw new System.InvalidOperationException(
                    "The fixture cross-type stream operator is unsupported.");
            }
        }

        FixturePeopleIntegerStreamSelector streamSelector =
            new FixturePeopleIntegerStreamSelector(selector.Body, captures);
        IAsyncEnumerable<int> stream =
            people.Map<int>(value => streamSelector.Project(value));
        for (uint stageIndex = stages.Count; stageIndex > 0u;
            stageIndex -= 1u) {
            QueryPlan<int> stage = stages.Get(stageIndex - 1u);
            if (stage.Kind == "Select") {
                continue;
            }
            if (stage.Kind == "Filter") {
                QueryLambda<int, bool> predicate =
                    stage.Expression as QueryLambda<int, bool>;
                FixturePeopleIntegerStreamPredicate streamPredicate =
                    new FixturePeopleIntegerStreamPredicate(
                        predicate.Body, captures);
                stream = stream.Filter(
                    value => streamPredicate.Matches(value));
            } else if (stage.Kind == "Skip") {
                stream = stream.Skip(stage.Count);
            } else if (stage.Kind == "Take") {
                stream = stream.Take(stage.Count);
            } else {
                stream = stream.Skip(stage.Count).Take(stage.SecondCount);
            }
        }
        return stream;
    }
}

public final class FixtureAsyncQueryProvider : IAsyncQueryProvider, IQueryProvider {
    public List<T> Execute<T>(QueryPlan<T> plan) {
        return new FixtureGenericPlanExecutor<T>().Execute(plan);
    }

    public Task<List<T>> ExecuteAsync<T>(
        QueryPlan<T> plan,
        CancellationToken cancellationToken) {
        return new FixtureGenericPlanExecutor<T>().ExecuteAsync(
            plan, cancellationToken);
    }

    public Task<List<int>> ExecuteAsyncIntegerWindow(
        QueryPlan<int> plan,
        CancellationToken cancellationToken) {
        QueryPlanValidator.Validate(plan);
        Task<List<int>> result = new Task<List<int>>();
        if (cancellationToken.IsCancellationRequested) {
            result.SetCanceled();
            return result;
        }
        QueryPlan<int> sourcePlan = plan;
        List<QueryPlan<int>> stages = new List<QueryPlan<int>>();
        while (sourcePlan != null && sourcePlan.Kind != "Source") {
            if (sourcePlan.Kind != "Skip" && sourcePlan.Kind != "Take" &&
                sourcePlan.Kind != "Page") {
                throw new System.InvalidOperationException(
                    "Unsupported fixture integer async window operator '" +
                    sourcePlan.Kind + "'.");
            }
            stages.Add(sourcePlan);
            sourcePlan = sourcePlan.Source as QueryPlan<int>;
        }
        if (sourcePlan == null || sourcePlan.Kind != "Source") {
            throw new System.InvalidOperationException(
                "Unsupported fixture integer async window shape.");
        }
        List<int> source = sourcePlan.Source as List<int>;
        if (source == null) {
            throw new System.InvalidOperationException(
                "The fixture integer async source is not a list.");
        }
        uint start = 0u;
        uint end = source.Count;
        for (uint stageIndex = stages.Count; stageIndex > 0u;
            stageIndex -= 1u) {
            QueryPlan<int> stage = stages.Get(stageIndex - 1u);
            uint available = end - start;
            if (stage.Kind == "Skip") {
                uint skipped = stage.Count < available
                    ? stage.Count : available;
                start += skipped;
            } else if (stage.Kind == "Take") {
                if (stage.Count < available) {
                    end = start + stage.Count;
                }
            } else {
                uint skipped = stage.Count < available
                    ? stage.Count : available;
                start += skipped;
                available = end - start;
                if (stage.SecondCount < available) {
                    end = start + stage.SecondCount;
                }
            }
        }
        List<int> window = new List<int>();
        for (uint index = start; index < end; index += 1u) {
            window.Add(source.Get(index));
        }
        result.SetResult(window);
        return result;
    }

    public Task<List<int>> ExecutePeopleAsync(
        QueryPlan<int> plan,
        CancellationToken cancellationToken) {
        Task<List<int>> result = new Task<List<int>>();
        if (cancellationToken.IsCancellationRequested) {
            result.SetCanceled();
        } else {
            QueryPlanValidator.Validate(plan);
            result.SetResult(ApplyPeopleSelectWindow(plan));
        }
        return result;
    }

    public Task<List<int>> ExecuteAsyncValues(
        QueryPlan<int> plan,
        CancellationToken cancellationToken) {
        QueryPlanValidator.Validate(plan);
        QueryPlan<int> current = plan;
        List<QueryPlan<int>> stages = new List<QueryPlan<int>>();
        while (current != null && current.Kind != "Source") {
            if (current.Kind != "Filter" && current.Kind != "Select" &&
                current.Kind != "Skip" && current.Kind != "Take") {
                throw new System.InvalidOperationException(
                    "Unsupported fixture async query operator '" +
                    current.Kind + "'.");
            }
            stages.Add(current);
            current = current.Source as QueryPlan<int>;
        }
        if (current == null || current.Kind != "Source") {
            throw new System.InvalidOperationException(
                "Unsupported fixture async query plan shape.");
        }
        IAsyncEnumerable<int> source =
            current.Source as IAsyncEnumerable<int>;
        if (source == null) {
            throw new System.InvalidOperationException(
                "The fixture plan source is not an async sequence.");
        }
        AsyncTokenEnumerable tokenSource = new AsyncTokenEnumerable(
            source, cancellationToken);
        FixtureAsyncCaptureSnapshot captures =
            new FixtureAsyncCaptureSnapshot();
        for (uint index = 0u; index < stages.Count; index += 1u) {
            QueryPlan<int> stage = stages.Get(index);
            if (stage.Kind == "Filter") {
                QueryLambda<int, bool> predicate =
                    stage.Expression as QueryLambda<int, bool>;
                if (predicate != null) {
                    SnapshotBoolCaptures(predicate.Body, captures);
                }
            } else if (stage.Kind == "Select") {
                QueryLambda<int, int> selector =
                    stage.Expression as QueryLambda<int, int>;
                if (selector != null) {
                    SnapshotIntCaptures(selector.Body, captures);
                }
            }
        }
        for (uint index = 0u; index < stages.Count; index += 1u) {
            QueryPlan<int> stage = stages.Get(index);
            if (stage.Kind == "Take" && stage.Count == 0u) {
                return new Task<List<int>>(new List<int>());
            }
        }
        return MaterializeAsyncValues(
            tokenSource, stages, captures);
    }

    internal static void SnapshotIntCaptures(
        QueryExpression<int> expression,
        FixtureAsyncCaptureSnapshot captures) {
        if (expression == null) { return; }
        if (expression.Kind == "CapturedValue") {
            captures.Capture(
                expression.ConstantValue as QueryCapture<int>);
        }
        SnapshotIntCaptures(
            expression.Left as QueryExpression<int>, captures);
        SnapshotIntCaptures(
            expression.Right as QueryExpression<int>, captures);
        SnapshotBoolCaptures(
            expression.Left as QueryExpression<bool>, captures);
        SnapshotBoolCaptures(
            expression.Right as QueryExpression<bool>, captures);
    }

    internal static void SnapshotBoolCaptures(
        QueryExpression<bool> expression,
        FixtureAsyncCaptureSnapshot captures) {
        if (expression == null) { return; }
        SnapshotIntCaptures(
            expression.Left as QueryExpression<int>, captures);
        SnapshotIntCaptures(
            expression.Right as QueryExpression<int>, captures);
        SnapshotBoolCaptures(
            expression.Left as QueryExpression<bool>, captures);
        SnapshotBoolCaptures(
            expression.Right as QueryExpression<bool>, captures);
    }

    private static async Task<List<int>> MaterializeAsyncValues(
        IAsyncEnumerable<int> source,
        List<QueryPlan<int>> stages,
        FixtureAsyncCaptureSnapshot captures) {
        FixtureAsyncPipelineState state =
            new FixtureAsyncPipelineState(stages, captures);
        List<int> values = new List<int>();
        await foreach (int value in source) {
            int selected = state.Process(value);
            if (state.Include) {
                values.Add(selected);
            }
            if (state.StopAfterCurrent) {
                break;
            }
        }
        return values;
    }

    public IAsyncEnumerable<T> Stream<T>(QueryPlan<T> plan) {
        return new FixtureGenericPlanExecutor<T>().Stream(plan);
    }

    private List<SortValue> ApplyPeopleFilter(
        QueryPlan<SortValue> filterPlan) {
        List<QueryLambda<SortValue, int>> orderSelectors =
            new List<QueryLambda<SortValue, int>>();
        List<bool> orderDescending = new List<bool>();
        QueryPlan<SortValue> sourcePlan = filterPlan.Source as QueryPlan<SortValue>;
        while (sourcePlan != null && sourcePlan.Kind != "Source") {
            if (sourcePlan.Kind == "OrderBy" ||
                sourcePlan.Kind == "OrderByDescending" ||
                sourcePlan.Kind == "ThenOrderBy" ||
                sourcePlan.Kind == "ThenOrderByDescending") {
                QueryLambda<SortValue, int> keySelector =
                    sourcePlan.Expression as QueryLambda<SortValue, int>;
                if (keySelector == null) {
                    throw new System.InvalidOperationException(
                        "Unsupported fixture ordering expression.");
                }
                orderSelectors.Add(keySelector);
                orderDescending.Add(
                    sourcePlan.Kind == "OrderByDescending" ||
                    sourcePlan.Kind == "ThenOrderByDescending");
            } else {
                throw new System.InvalidOperationException(
                    "Unsupported fixture query plan shape.");
            }
            sourcePlan = sourcePlan.Source as QueryPlan<SortValue>;
        }
        if (sourcePlan == null) {
            throw new System.InvalidOperationException(
                "Unsupported fixture query plan source.");
        }
        if (sourcePlan.SourceName != "people") {
            throw new System.InvalidOperationException(
                "Unsupported fixture query source.");
        }
        List<SortValue> source = sourcePlan.Source as List<SortValue>;
        QueryLambda<SortValue, bool> predicate =
            filterPlan.Expression as QueryLambda<SortValue, bool>;
        if (source == null || predicate == null || predicate.Body == null) {
            throw new System.InvalidOperationException(
                "Unsupported fixture filter or source payload.");
        }
        QueryExpression<bool> predicateBody = predicate.Body;
        if (predicateBody.Kind != "GreaterThan" &&
            predicateBody.Kind != "GreaterThanOrEqual" &&
            predicateBody.Kind != "LessThan" &&
            predicateBody.Kind != "LessThanOrEqual" &&
            predicateBody.Kind != "Equal" &&
            predicateBody.Kind != "NotEqual") {
            throw new System.InvalidOperationException(
                "Unsupported fixture filter expression.");
        }
        QueryExpression<int> rightExpression =
            predicateBody.Right as QueryExpression<int>;
        int rightValue = EvaluateInt(rightExpression, null, null);
        List<SortValue> ordered = new List<SortValue>();
        for (uint sourceIndex = 0u; sourceIndex < source.Count; sourceIndex += 1u) {
            ordered.Add(source.Get(sourceIndex));
        }
        for (uint index = 1u; index < ordered.Count; index += 1u) {
            SortValue item = ordered.Get(index);
            uint insertAt = index;
            while (insertAt > 0u) {
                SortValue previous = ordered.Get(insertAt - 1u);
                if (ComparePeopleByKeys(
                        previous, item, orderSelectors, orderDescending) <= 0) {
                    break;
                }
                ordered.Set(insertAt, previous);
                insertAt -= 1u;
            }
            ordered.Set(insertAt, item);
        }
        List<SortValue> filtered = new List<SortValue>();
        for (uint index = 0u; index < ordered.Count; index += 1u) {
            SortValue item = ordered.Get(index);
            int leftValue = EvaluateInt(
                predicateBody.Left as QueryExpression<int>, item, null);
            bool keep = false;
            if (predicateBody.Kind == "GreaterThan") {
                keep = leftValue > rightValue;
            } else if (predicateBody.Kind == "GreaterThanOrEqual") {
                keep = leftValue >= rightValue;
            } else if (predicateBody.Kind == "LessThan") {
                keep = leftValue < rightValue;
            } else if (predicateBody.Kind == "LessThanOrEqual") {
                keep = leftValue <= rightValue;
            } else if (predicateBody.Kind == "Equal") {
                keep = leftValue == rightValue;
            } else if (predicateBody.Kind == "NotEqual") {
                keep = leftValue != rightValue;
            }
            if (keep) {
                filtered.Add(item);
            }
        }
        return filtered;
    }

    private int ComparePeopleByKeys(
        SortValue left,
        SortValue right,
        List<QueryLambda<SortValue, int>> orderSelectors,
        List<bool> orderDescending) {
        uint keyIndex = orderSelectors.Count;
        while (keyIndex > 0u) {
            keyIndex -= 1u;
            QueryLambda<SortValue, int> selector =
                orderSelectors.Get(keyIndex);
            int leftKey = EvaluateInt(selector.Body, left, null);
            int rightKey = EvaluateInt(selector.Body, right, null);
            int comparison = 0;
            if (leftKey < rightKey) {
                comparison = -1;
            } else if (leftKey > rightKey) {
                comparison = 1;
            }
            if (comparison != 0) {
                if (orderDescending.Get(keyIndex)) {
                    comparison = -comparison;
                }
                return comparison;
            }
        }
        return 0;
    }

    private List<int> ApplyPeopleSelect(QueryPlan<int> selectPlan) {
        QueryPlan<SortValue> inputPlan =
            selectPlan.Source as QueryPlan<SortValue>;
        List<SortValue> inputValues;
        if (inputPlan != null && inputPlan.Kind == "Source") {
            List<SortValue> source = inputPlan.Source as List<SortValue>;
            if (source == null) {
                throw new System.InvalidOperationException(
                    "Unsupported fixture projection source payload.");
            }
            inputValues = new List<SortValue>();
            for (uint index = 0u; index < source.Count; index += 1u) {
                inputValues.Add(source.Get(index));
            }
        } else {
            inputValues = ApplyPeopleFilter(inputPlan);
        }
        QueryLambda<SortValue, int> selector =
            selectPlan.Expression as QueryLambda<SortValue, int>;
        List<int> selected = new List<int>();
        for (uint index = 0u; index < inputValues.Count; index += 1u) {
            selected.Add(EvaluateInt(
                selector.Body, inputValues.Get(index), null));
        }
        return selected;
    }

    private List<int> ApplyPeopleSelectWindow(QueryPlan<int> plan) {
        QueryPlan<int> selectPlan = plan;
        List<QueryPlan<int>> stages = new List<QueryPlan<int>>();
        while (selectPlan != null && selectPlan.Kind != "Select") {
            if (selectPlan.Kind != "Filter" &&
                selectPlan.Kind != "OrderBy" &&
                selectPlan.Kind != "OrderByDescending" &&
                selectPlan.Kind != "ThenOrderBy" &&
                selectPlan.Kind != "ThenOrderByDescending" &&
                selectPlan.Kind != "Skip" && selectPlan.Kind != "Take" &&
                selectPlan.Kind != "Page") {
                throw new System.InvalidOperationException(
                    "Unsupported fixture post-projection operator.");
            }
            stages.Add(selectPlan);
            selectPlan = selectPlan.Source as QueryPlan<int>;
        }
        if (selectPlan == null || selectPlan.Kind != "Select") {
            throw new System.InvalidOperationException(
                "Unsupported fixture query plan shape.");
        }

        List<int> selected = ApplyPeopleSelect(selectPlan);
        FixtureAsyncCaptureSnapshot captures =
            new FixtureAsyncCaptureSnapshot();
        for (uint stageIndex = stages.Count; stageIndex > 0u;
            stageIndex -= 1u) {
            QueryPlan<int> stage = stages.Get(stageIndex - 1u);
            if (stage.Kind == "Filter") {
                QueryLambda<int, bool> predicate =
                    stage.Expression as QueryLambda<int, bool>;
                if (predicate == null || predicate.Body == null) {
                    throw new System.InvalidOperationException(
                        "The fixture post-projection filter requires a predicate.");
                }
                List<int> filtered = new List<int>();
                for (uint index = 0u; index < selected.Count; index += 1u) {
                    int value = selected.Get(index);
                    if (FixtureAsyncQueryProvider.EvaluateAsyncBool(
                        predicate.Body, value, captures)) {
                        filtered.Add(value);
                    }
                }
                selected = filtered;
            } else if (stage.Kind == "OrderBy" ||
                stage.Kind == "OrderByDescending") {
                List<QueryPlan<int>> orderStages = new List<QueryPlan<int>>();
                orderStages.Add(stage);
                while (stageIndex > 1u) {
                    QueryPlan<int> nextOrder = stages.Get(stageIndex - 2u);
                    if (nextOrder.Kind != "ThenOrderBy" &&
                        nextOrder.Kind != "ThenOrderByDescending") {
                        break;
                    }
                    orderStages.Add(nextOrder);
                    stageIndex -= 1u;
                }
                for (uint orderIndex = 0u;
                    orderIndex < orderStages.Count; orderIndex += 1u) {
                    QueryLambda<int, int> keySelector =
                        orderStages.Get(orderIndex).Expression as
                            QueryLambda<int, int>;
                    if (keySelector == null || keySelector.Body == null) {
                        throw new System.InvalidOperationException(
                            "The fixture post-projection order requires an integer key.");
                    }
                }
                for (uint index = 1u; index < selected.Count; index += 1u) {
                    int item = selected.Get(index);
                    uint insertAt = index;
                    while (insertAt > 0u) {
                        int previous = selected.Get(insertAt - 1u);
                        if (ComparePeopleSelectOrder(
                            item, previous, orderStages, captures) >= 0) {
                            break;
                        }
                        selected.Set(insertAt, previous);
                        insertAt -= 1u;
                    }
                    selected.Set(insertAt, item);
                }
            } else {
                uint start = stage.Count;
                uint limit = stage.Kind == "Take"
                    ? stage.Count
                    : 4294967295u;
                if (stage.Kind == "Page") {
                    limit = stage.SecondCount;
                }
                if (stage.Kind == "Take") {
                    start = 0u;
                }
                if (start > selected.Count) {
                    start = selected.Count;
                }
                uint count = selected.Count - start;
                if (limit < count) {
                    count = limit;
                }
                List<int> window = new List<int>();
                for (uint index = start; index < start + count; index += 1u) {
                    window.Add(selected.Get(index));
                }
                selected = window;
            }
        }
        return selected;
    }

    private int ComparePeopleSelectOrder(
        int left,
        int right,
        List<QueryPlan<int>> orderStages,
        FixtureAsyncCaptureSnapshot captures) {
        for (uint orderIndex = 0u;
            orderIndex < orderStages.Count; orderIndex += 1u) {
            QueryPlan<int> orderStage = orderStages.Get(orderIndex);
            QueryLambda<int, int> keySelector =
                orderStage.Expression as QueryLambda<int, int>;
            int leftKey = FixtureAsyncQueryProvider.EvaluateAsyncInt(
                keySelector.Body, left, captures);
            int rightKey = FixtureAsyncQueryProvider.EvaluateAsyncInt(
                keySelector.Body, right, captures);
            if (leftKey == rightKey) {
                continue;
            }
            bool descending = orderStage.Kind == "OrderByDescending" ||
                orderStage.Kind == "ThenOrderByDescending";
            if ((!descending && leftKey < rightKey) ||
                (descending && leftKey > rightKey)) {
                return -1;
            }
            return 1;
        }
        return 0;
    }

    private int EvaluateInt(
        QueryExpression<int> expression,
        SortValue item,
        FixtureQueryLocal locals) {
        if (expression.Kind == "Conditional") {
            QueryExpression<bool> condition =
                expression.ConstantValue as QueryExpression<bool>;
            if (EvaluateBool(condition, item, locals)) {
                return EvaluateInt(
                    expression.Left as QueryExpression<int>, item, locals);
            }
            return EvaluateInt(
                expression.Right as QueryExpression<int>, item, locals);
        }
        if (expression.Kind == "MemberAccess") {
            if (expression.Name == "Key") { return item.Key; }
            if (expression.Name == "Id") { return item.Id; }
            if (expression.Name == "Secondary") { return item.Secondary; }
        }
        if (expression.Kind == "Variable") {
            FixtureQueryLocal local = locals;
            while (local != null) {
                if (local.Name == expression.Name) { return local.Value; }
                local = local.Parent;
            }
            throw new System.InvalidOperationException(
                "The fixture query local is not bound.");
        }
        if (expression.Kind == "Let") {
            int value = EvaluateInt(
                expression.Left as QueryExpression<int>, item, locals);
            return EvaluateInt(
                expression.Right as QueryExpression<int>, item,
                new FixtureQueryLocal(expression.Name, value, locals));
        }
        if (expression.Kind == "Constant") {
            return (int)expression.ConstantValue;
        }
        if (expression.Kind == "CapturedValue") {
            QueryCapture<int> capture =
                expression.ConstantValue as QueryCapture<int>;
            return capture.Value;
        }
        if (expression.Kind == "Multiply") {
            return EvaluateInt(
                expression.Left as QueryExpression<int>, item, locals) *
                EvaluateInt(
                    expression.Right as QueryExpression<int>, item, locals);
        }
        if (expression.Kind == "Add") {
            return EvaluateInt(
                expression.Left as QueryExpression<int>, item, locals) +
                EvaluateInt(
                    expression.Right as QueryExpression<int>, item, locals);
        }
        if (expression.Kind == "Subtract") {
            return EvaluateInt(
                expression.Left as QueryExpression<int>, item, locals) -
                EvaluateInt(
                    expression.Right as QueryExpression<int>, item, locals);
        }
        if (expression.Kind == "Divide") {
            return EvaluateInt(
                expression.Left as QueryExpression<int>, item, locals) /
                EvaluateInt(
                    expression.Right as QueryExpression<int>, item, locals);
        }
        if (expression.Kind == "Modulo") {
            return EvaluateInt(
                expression.Left as QueryExpression<int>, item, locals) %
                EvaluateInt(
                    expression.Right as QueryExpression<int>, item, locals);
        }
        throw new System.InvalidOperationException(
            "Unsupported fixture integer expression.");
    }

    private bool EvaluateBool(
        QueryExpression<bool> expression,
        SortValue item,
        FixtureQueryLocal locals) {
        if (expression.Kind == "Not") {
            return !EvaluateBool(
                expression.Left as QueryExpression<bool>, item, locals);
        }
        if (expression.Kind == "AndAlso") {
            return EvaluateBool(
                    expression.Left as QueryExpression<bool>, item, locals) &&
                EvaluateBool(
                    expression.Right as QueryExpression<bool>, item, locals);
        }
        if (expression.Kind == "OrElse") {
            return EvaluateBool(
                    expression.Left as QueryExpression<bool>, item, locals) ||
                EvaluateBool(
                    expression.Right as QueryExpression<bool>, item, locals);
        }
        int left = EvaluateInt(
            expression.Left as QueryExpression<int>, item, locals);
        int right = EvaluateInt(
            expression.Right as QueryExpression<int>, item, locals);
        if (expression.Kind == "GreaterThan") { return left > right; }
        if (expression.Kind == "GreaterThanOrEqual") { return left >= right; }
        if (expression.Kind == "LessThan") { return left < right; }
        if (expression.Kind == "LessThanOrEqual") { return left <= right; }
        if (expression.Kind == "Equal") { return left == right; }
        if (expression.Kind == "NotEqual") { return left != right; }
        throw new System.InvalidOperationException(
            "Unsupported fixture boolean expression.");
    }

    internal static bool IsPeopleIntegerExpressionForStream(
        QueryExpression<int> expression) {
        if (expression == null) { return false; }
        if (expression.Kind == "Constant") { return true; }
        if (expression.Kind == "CapturedValue") {
            return expression.ConstantValue as QueryCapture<int> != null;
        }
        if (expression.Kind == "MemberAccess") {
            return expression.Name == "Id" || expression.Name == "Key" ||
                expression.Name == "Secondary";
        }
        if (expression.Kind != "Add" && expression.Kind != "Subtract" &&
            expression.Kind != "Multiply" && expression.Kind != "Divide" &&
            expression.Kind != "Modulo") {
            return false;
        }
        return IsPeopleIntegerExpressionForStream(
                expression.Left as QueryExpression<int>) &&
            IsPeopleIntegerExpressionForStream(
                expression.Right as QueryExpression<int>);
    }

    internal static int EvaluateAsyncPeopleInt(
        QueryExpression<int> expression,
        SortValue value,
        FixtureAsyncCaptureSnapshot captures) {
        if (expression.Kind == "Constant") {
            return (int)expression.ConstantValue;
        }
        if (expression.Kind == "CapturedValue") {
            return captures.Read(
                expression.ConstantValue as QueryCapture<int>);
        }
        if (expression.Kind == "MemberAccess") {
            if (expression.Name == "Id") { return value.Id; }
            if (expression.Name == "Key") { return value.Key; }
            if (expression.Name == "Secondary") { return value.Secondary; }
        }
        if (expression.Kind == "Add") {
            return EvaluateAsyncPeopleInt(
                expression.Left as QueryExpression<int>, value, captures) +
                EvaluateAsyncPeopleInt(
                    expression.Right as QueryExpression<int>, value, captures);
        }
        if (expression.Kind == "Subtract") {
            return EvaluateAsyncPeopleInt(
                expression.Left as QueryExpression<int>, value, captures) -
                EvaluateAsyncPeopleInt(
                    expression.Right as QueryExpression<int>, value, captures);
        }
        if (expression.Kind == "Multiply") {
            return EvaluateAsyncPeopleInt(
                expression.Left as QueryExpression<int>, value, captures) *
                EvaluateAsyncPeopleInt(
                    expression.Right as QueryExpression<int>, value, captures);
        }
        if (expression.Kind == "Divide") {
            return EvaluateAsyncPeopleInt(
                expression.Left as QueryExpression<int>, value, captures) /
                EvaluateAsyncPeopleInt(
                    expression.Right as QueryExpression<int>, value, captures);
        }
        if (expression.Kind == "Modulo") {
            return EvaluateAsyncPeopleInt(
                expression.Left as QueryExpression<int>, value, captures) %
                EvaluateAsyncPeopleInt(
                    expression.Right as QueryExpression<int>, value, captures);
        }
        throw new System.InvalidOperationException(
            "Unsupported fixture cross-type integer projection.");
    }

    internal static int EvaluateAsyncInt(
        QueryExpression<int> expression,
        int value,
        FixtureAsyncCaptureSnapshot captures) {
        if (expression.Kind == "Parameter") { return value; }
        if (expression.Kind == "Constant") {
            return (int)expression.ConstantValue;
        }
        if (expression.Kind == "CapturedValue") {
            return captures.Read(
                expression.ConstantValue as QueryCapture<int>);
        }
        if (expression.Kind == "Add") {
            return EvaluateAsyncInt(
                expression.Left as QueryExpression<int>, value, captures) +
                EvaluateAsyncInt(
                    expression.Right as QueryExpression<int>, value, captures);
        }
        if (expression.Kind == "Subtract") {
            return EvaluateAsyncInt(
                expression.Left as QueryExpression<int>, value, captures) -
                EvaluateAsyncInt(
                    expression.Right as QueryExpression<int>, value, captures);
        }
        if (expression.Kind == "Multiply") {
            return EvaluateAsyncInt(
                expression.Left as QueryExpression<int>, value, captures) *
                EvaluateAsyncInt(
                    expression.Right as QueryExpression<int>, value, captures);
        }
        if (expression.Kind == "Divide") {
            return EvaluateAsyncInt(
                expression.Left as QueryExpression<int>, value, captures) /
                EvaluateAsyncInt(
                    expression.Right as QueryExpression<int>, value, captures);
        }
        if (expression.Kind == "Modulo") {
            return EvaluateAsyncInt(
                expression.Left as QueryExpression<int>, value, captures) %
                EvaluateAsyncInt(
                    expression.Right as QueryExpression<int>, value, captures);
        }
        throw new System.InvalidOperationException(
            "Unsupported fixture async integer expression.");
    }

    internal static bool EvaluateAsyncBool(
        QueryExpression<bool> expression,
        int value,
        FixtureAsyncCaptureSnapshot captures) {
        QueryExpression<int> left = expression.Left as QueryExpression<int>;
        QueryExpression<int> right = expression.Right as QueryExpression<int>;
        if (expression.Kind == "GreaterThan") {
            return EvaluateAsyncInt(left, value, captures) >
                EvaluateAsyncInt(right, value, captures);
        }
        if (expression.Kind == "GreaterThanOrEqual") {
            return EvaluateAsyncInt(left, value, captures) >=
                EvaluateAsyncInt(right, value, captures);
        }
        if (expression.Kind == "LessThan") {
            return EvaluateAsyncInt(left, value, captures) <
                EvaluateAsyncInt(right, value, captures);
        }
        if (expression.Kind == "LessThanOrEqual") {
            return EvaluateAsyncInt(left, value, captures) <=
                EvaluateAsyncInt(right, value, captures);
        }
        if (expression.Kind == "Equal") {
            return EvaluateAsyncInt(left, value, captures) ==
                EvaluateAsyncInt(right, value, captures);
        }
        if (expression.Kind == "NotEqual") {
            return EvaluateAsyncInt(left, value, captures) !=
                EvaluateAsyncInt(right, value, captures);
        }
        throw new System.InvalidOperationException(
            "Unsupported fixture async predicate expression.");
    }
}

/// <summary>A bounded external-style scalar provider used by the native fixture.</summary>
public final class FixtureQueryScalarProvider :
    IQueryScalarProvider, IAsyncQueryScalarProvider,
    IQueryPositionScalarProvider<int>,
    IAsyncQueryPositionScalarProvider<int> {
    public uint SourceReads;

    public bool ExecuteAny(IQueryScalarPlanNode plan) {
        QueryScalarPlanValidator.Validate(plan);
        if (plan.Kind != "Any") {
            throw new System.InvalidOperationException(
                "The fixture boolean scalar provider requires Any.");
        }
        return ReadMatches(plan.Source, true).Count != 0u;
    }

    public uint ExecuteCount(IQueryScalarPlanNode plan) {
        QueryScalarPlanValidator.Validate(plan);
        if (plan.Kind != "Count") {
            throw new System.InvalidOperationException(
                "The fixture count scalar provider requires Count.");
        }
        return ReadMatches(plan.Source, false).Count;
    }

    public Task<bool> ExecuteAnyAsync(
        IQueryScalarPlanNode plan,
        CancellationToken cancellationToken) {
        Task<bool> result = new Task<bool>();
        if (cancellationToken.IsCancellationRequested) {
            result.SetCanceled();
            return result;
        }
        try {
            result.SetResult(ExecuteAny(plan));
        } catch (System.Exception error) {
            result.SetFault(error);
        }
        return result;
    }

    public Task<uint> ExecuteCountAsync(
        IQueryScalarPlanNode plan,
        CancellationToken cancellationToken) {
        Task<uint> result = new Task<uint>();
        if (cancellationToken.IsCancellationRequested) {
            result.SetCanceled();
            return result;
        }
        try {
            result.SetResult(ExecuteCount(plan));
        } catch (System.Exception error) {
            result.SetFault(error);
        }
        return result;
    }

    public int ExecutePosition(IQueryScalarPlanNode node) {
        QueryScalarPlan<int> plan = node as QueryScalarPlan<int>;
        QueryScalarPlanValidator.Validate(node);
        if (plan == null) {
            throw new System.ArgumentNullException("plan");
        }
        List<int> matches = ReadMatches(plan.Source, false);
        if (plan.Kind == "First" || plan.Kind == "FirstOrDefault") {
            if (matches.Count == 0u) {
                if (plan.Kind == "FirstOrDefault") { return 0; }
                throw new System.InvalidOperationException(
                    "The fixture provider found no result for First.");
            }
            return matches.Get(0u);
        }
        if (plan.Kind == "Last" || plan.Kind == "LastOrDefault") {
            if (matches.Count == 0u) {
                if (plan.Kind == "LastOrDefault") { return 0; }
                throw new System.InvalidOperationException(
                    "The fixture provider found no result for Last.");
            }
            return matches.Get(matches.Count - 1u);
        }
        if (plan.Kind == "ElementAt" ||
            plan.Kind == "ElementAtOrDefault") {
            if (plan.Index >= matches.Count) {
                if (plan.Kind == "ElementAtOrDefault") { return 0; }
                throw new System.ArgumentOutOfRangeException("index");
            }
            return matches.Get(plan.Index);
        }
        if (plan.Kind == "Single" || plan.Kind == "SingleOrDefault") {
            if (matches.Count == 0u) {
                if (plan.Kind == "SingleOrDefault") { return 0; }
                throw new System.InvalidOperationException(
                    "The fixture provider found no result for Single.");
            }
            if (matches.Count != 1u) {
                throw new System.InvalidOperationException(
                    "The fixture provider found multiple results for Single.");
            }
            return matches.Get(0u);
        }
        throw new System.InvalidOperationException(
            "The fixture position provider does not support this terminal.");
    }

    public Task<int> ExecutePositionAsync(
        IQueryScalarPlanNode plan,
        CancellationToken cancellationToken) {
        Task<int> result = new Task<int>();
        if (cancellationToken.IsCancellationRequested) {
            result.SetCanceled();
            return result;
        }
        try {
            result.SetResult(ExecutePosition(plan));
        } catch (System.Exception error) {
            result.SetFault(error);
        }
        return result;
    }

    private List<int> ReadMatches(IQueryPlanNode scalarSource, bool stopAfterFirst) {
        SourceReads = 0u;
        QueryPlan<int> current = scalarSource as QueryPlan<int>;
        List<QueryPlan<int>> filters = new List<QueryPlan<int>>();
        bool emptyWindow = false;
        while (current != null && current.Kind != "Source") {
            if (current.Kind == "Filter") {
                filters.Add(current);
            } else if (current.Kind == "OrderBy") {
                QueryLambda<int, int> selector =
                    current.Expression as QueryLambda<int, int>;
                if (selector == null || selector.Body == null ||
                    selector.Body.Kind != "Parameter") {
                    throw new System.InvalidOperationException(
                        "The fixture scalar provider only executes identity ordering.");
                }
            } else if (current.Kind == "Take" && current.Count == 0u) {
                emptyWindow = true;
            } else {
                throw new System.InvalidOperationException(
                    "The fixture scalar provider only executes filters and Take(0).");
            }
            current = current.Source as QueryPlan<int>;
        }
        if (current == null || current.Kind != "Source") {
            throw new System.InvalidOperationException(
                "The fixture scalar provider requires an integer source.");
        }
        List<int> matches = new List<int>();
        if (emptyWindow) {
            return matches;
        }
        List<int> source = current.Source as List<int>;
        if (source == null) {
            throw new System.InvalidOperationException(
                "The fixture scalar provider source must be a list.");
        }

        FixtureAsyncCaptureSnapshot captures =
            new FixtureAsyncCaptureSnapshot();
        for (uint filterIndex = 0u; filterIndex < filters.Count;
            filterIndex += 1u) {
            QueryLambda<int, bool> predicate =
                filters.Get(filterIndex).Expression as QueryLambda<int, bool>;
            if (predicate != null) {
                FixtureAsyncQueryProvider.SnapshotBoolCaptures(
                    predicate.Body, captures);
            }
        }
        for (uint index = 0u; index < source.Count; index += 1u) {
            int value = source.Get(index);
            SourceReads += 1u;
            bool include = true;
            for (uint remaining = filters.Count; remaining > 0u;
                remaining -= 1u) {
                QueryPlan<int> filter = filters.Get(remaining - 1u);
                QueryLambda<int, bool> predicate =
                    filter.Expression as QueryLambda<int, bool>;
                if (predicate == null || predicate.Body == null ||
                    !FixtureAsyncQueryProvider.EvaluateAsyncBool(
                        predicate.Body, value, captures)) {
                    include = false;
                    break;
                }
            }
            if (include) {
                matches.Add(value);
                if (stopAfterFirst) {
                    break;
                }
            }
        }
        return matches;
    }

}

internal final class FixtureAsyncPipelineState {
    private List<QueryPlan<int>> _stages;
    private uint[] _remaining;
    private FixtureAsyncCaptureSnapshot _captures;
    private bool _include;
    private bool _stopAfterCurrent;

    internal bool Include { const get { return _include; } }
    internal bool StopAfterCurrent { const get { return _stopAfterCurrent; } }

    internal constructor() {
        _stages = default;
        _remaining = default;
        _captures = default;
        _include = false;
        _stopAfterCurrent = false;
    }

    internal constructor(
        List<QueryPlan<int>> stages,
        FixtureAsyncCaptureSnapshot captures) {
        _stages = stages;
        _captures = captures;
        _include = false;
        _stopAfterCurrent = false;
        _remaining = new uint[stages.Count];
        for (uint index = 0u; index < stages.Count; index += 1u) {
            QueryPlan<int> stage = stages.Get(index);
            if (stage.Kind == "Skip" || stage.Kind == "Take") {
                _remaining[index] = stage.Count;
            }
        }
    }

    internal int Process(int value) {
        int currentValue = value;
        _include = true;
        _stopAfterCurrent = false;
        for (uint remainingStages = _stages.Count; remainingStages > 0u;
            remainingStages -= 1u) {
            uint stageIndex = remainingStages - 1u;
            QueryPlan<int> stage = _stages.Get(stageIndex);
            if (stage.Kind == "Filter") {
                QueryLambda<int, bool> predicate =
                    stage.Expression as QueryLambda<int, bool>;
                if (predicate == null || predicate.Body == null) {
                    throw new System.InvalidOperationException(
                        "The fixture filter has no typed expression.");
                }
                if (!FixtureAsyncQueryProvider.EvaluateAsyncBool(
                    predicate.Body, currentValue, _captures)) {
                    _include = false;
                    break;
                }
            } else if (stage.Kind == "Select") {
                QueryLambda<int, int> selector =
                    stage.Expression as QueryLambda<int, int>;
                if (selector == null || selector.Body == null) {
                    throw new System.InvalidOperationException(
                        "The fixture projection has no typed expression.");
                }
                currentValue = FixtureAsyncQueryProvider.EvaluateAsyncInt(
                    selector.Body, currentValue, _captures);
            } else if (stage.Kind == "Skip") {
                if (_remaining[stageIndex] > 0u) {
                    _remaining[stageIndex] -= 1u;
                    _include = false;
                    break;
                }
            } else if (stage.Kind == "Take") {
                if (_remaining[stageIndex] == 0u) {
                    _include = false;
                    _stopAfterCurrent = true;
                    break;
                }
                _remaining[stageIndex] -= 1u;
                if (_remaining[stageIndex] == 0u) {
                    _stopAfterCurrent = true;
                }
            }
        }
        return currentValue;
    }
}

async Task<int> ConsumeFirstAsync(IAsyncEnumerable<int> source) {
    int result = -1;
    await foreach (int value in source) {
        result = value;
        break;
    }
    return result;
}

async Task<int> SumAsync(IAsyncEnumerable<int> source) {
    int sum = 0;
    await foreach (int value in source) {
        sum += value;
    }
    return sum;
}

