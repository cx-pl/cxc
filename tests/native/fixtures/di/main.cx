public class TransientCounter {
    private static uint _nextId;
    public uint Id;
    public constructor() { _nextId += 1u; Id = _nextId; }
}

public class AdditionalSingleton : IAdditionalSingleton, IDisposable {
    public static uint DisposeCount;
    public void Dispose() { DisposeCount += 1u; }
}

public class AdditionalScoped : IDisposable {
    public static uint DisposeCount;
    public void Dispose() { DisposeCount += 1u; }
}

public class SingletonProviderCapture {
    public IServiceProvider Provider;
    public constructor(IServiceProvider provider) { Provider = provider; }
}

public class ScopeFactoryCapture {
    public IServiceScopeFactory Factory;
    public constructor(IServiceScopeFactory factory) { Factory = factory; }
}

public class UniqueProbe : IUniqueProbe {
    private static uint _nextId;
    private uint _id;
    public uint Id { const get { return _id; } }
    public constructor() { _nextId += 1u; _id = _nextId; }
}

public class ExternalResource : IExternalResource, IDisposable {
    public static uint DisposeCount;
    public void Dispose() { DisposeCount += 1u; }
}

public class AliasResource : IAliasFirst, IAliasSecond, IDisposable {
    public static uint DisposeCount;
    public void Dispose() { DisposeCount += 1u; }
}

public class TransientResource : IDisposable {
    public static uint DisposeCount;
    public void Dispose() { DisposeCount += 1u; }
}

public class CleanupThrower : IDisposable {
    public static uint DisposeCount;
    public void Dispose() {
        DisposeCount += 1u;
        throw new Exception("expected cleanup failure");
    }
}

public class CleanupSurvivor : IDisposable {
    public static uint DisposeCount;
    public void Dispose() { DisposeCount += 1u; }
}

public class ReentrantCleanup : IDisposable {
    public static uint DisposeCount;
    private ServiceProvider _provider;
    public constructor(IServiceProvider provider) { _provider = (ServiceProvider)provider; }
    public void Dispose() {
        DisposeCount += 1u;
        _provider.Dispose();
    }
}

public class OwnedBeforeFailure : IDisposable {
    public static uint DisposeCount;
    public void Dispose() { DisposeCount += 1u; }
}

public class FailingConsumer {
    public constructor(OwnedBeforeFailure dependency) {
        throw new Exception("expected constructor failure");
    }
}

