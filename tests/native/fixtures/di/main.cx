public class WrongFactoryService { }

public static class AdditionalDiTests {
    public static int Run() {
        IServiceCollection services = new ServiceCollection();
        IServiceCollection chained = services.AddTransient<TransientCounter>();
        if (!Object.ReferenceEquals((object)services, (object)chained)) return 83;
        services.AddScoped<AdditionalScoped>();
        services.AddSingleton<IAdditionalSingleton, AdditionalSingleton>();
        services.AddSingleton<SingletonProviderCapture>();
        services.AddScoped<ScopeFactoryCapture>();
        ServiceProvider provider = services.BuildServiceProvider();
        if (provider.GetService(typeof(NamedSecond)) != null) return 84;
        bool requiredMissingFailed = false;
        try {
            provider.GetRequiredService<IUnregisteredName>();
        } catch (ServiceResolutionException) {
            requiredMissingFailed = true;
        }
        if (!requiredMissingFailed) return 85;

        TransientCounter transientFirst = provider.GetRequiredService<TransientCounter>();
        TransientCounter transientSecond = provider.GetRequiredService<TransientCounter>();
        if (Object.ReferenceEquals((object)transientFirst, (object)transientSecond) ||
            transientFirst.Id == transientSecond.Id) return 60;

        IServiceScope first = provider.CreateScope();
        IServiceScope second = provider.CreateScope();
        AdditionalScoped scopedFirst = first.ServiceProvider.GetRequiredService<AdditionalScoped>();
        if (!Object.ReferenceEquals((object)scopedFirst,
                (object)first.ServiceProvider.GetRequiredService<AdditionalScoped>())) return 61;
        if (Object.ReferenceEquals((object)scopedFirst,
                (object)second.ServiceProvider.GetRequiredService<AdditionalScoped>())) return 62;

        IAdditionalSingleton singleton = first.ServiceProvider.GetRequiredService<IAdditionalSingleton>();
        if (!Object.ReferenceEquals((object)singleton,
                (object)second.ServiceProvider.GetRequiredService<IAdditionalSingleton>())) return 63;
        if (!Object.ReferenceEquals((object)singleton,
                (object)provider.GetRequiredService<IAdditionalSingleton>())) return 64;
        SingletonProviderCapture singletonCapture =
            first.ServiceProvider.GetRequiredService<SingletonProviderCapture>();
        if (!Object.ReferenceEquals((object)provider, (object)singletonCapture.Provider)) return 65;

        ScopeFactoryCapture scopeFactoryCapture =
            first.ServiceProvider.GetRequiredService<ScopeFactoryCapture>();
        if (!Object.ReferenceEquals((object)provider, (object)scopeFactoryCapture.Factory)) return 66;
        IServiceScope sibling = first.ServiceProvider.CreateScope();
        if (Object.ReferenceEquals((object)scopedFirst,
                (object)sibling.ServiceProvider.GetRequiredService<AdditionalScoped>())) return 67;

        ServiceProvider independentProvider = services.BuildServiceProvider();
        IAdditionalSingleton independentSingleton =
            independentProvider.GetRequiredService<IAdditionalSingleton>();
        if (Object.ReferenceEquals((object)singleton, (object)independentSingleton)) return 68;
        independentProvider.Dispose();
        sibling.Dispose();
        first.Dispose();
        second.Dispose();
        provider.Dispose();
        if (AdditionalSingleton.DisposeCount != 2u || AdditionalScoped.DisposeCount != 3u) return 69;

        IServiceCollection duplicateServices = new ServiceCollection();
        ServiceDescriptor duplicate = new ServiceDescriptor(
            typeof(IUniqueProbe), ServiceLifetime.Singleton, typeof(UniqueProbe));
        duplicateServices.Add(duplicate);
        duplicateServices.Add(duplicate);
        ServiceProvider duplicateProvider = duplicateServices.BuildServiceProvider();
        IEnumerable<IUniqueProbe> duplicateValues = duplicateProvider.GetServices<IUniqueProbe>();
        IEnumerator<IUniqueProbe> duplicateEnumerator = duplicateValues.GetEnumerator();
        if (!duplicateEnumerator.MoveNext()) return 70;
        IUniqueProbe firstDuplicate = duplicateEnumerator.Current;
        if (!duplicateEnumerator.MoveNext()) return 71;
        IUniqueProbe secondDuplicate = duplicateEnumerator.Current;
        if (duplicateEnumerator.MoveNext()) return 72;
        duplicateEnumerator.Dispose();
        if (firstDuplicate.Id == secondDuplicate.Id ||
            Object.ReferenceEquals((object)firstDuplicate, (object)secondDuplicate)) return 73;
        if (!Object.ReferenceEquals((object)secondDuplicate,
                (object)duplicateProvider.GetRequiredService<IUniqueProbe>())) return 74;
        duplicateProvider.Dispose();

        ExternalResource external = new ExternalResource();
        IServiceCollection externalServices = new ServiceCollection();
        externalServices.AddSingleton<IExternalResource>(external);
        ServiceProvider externalProvider = externalServices.BuildServiceProvider();
        if (!Object.ReferenceEquals((object)external,
                (object)externalProvider.GetRequiredService<IExternalResource>())) return 75;
        externalProvider.Dispose();
        if (ExternalResource.DisposeCount != 0u) return 76;

        AliasResource aliasValue = new AliasResource();
        IServiceCollection aliasServices = new ServiceCollection();
        delegate(IServiceProvider) => object aliasFactory =
            (IServiceProvider current) => (object)aliasValue;
        aliasServices.AddSingleton(typeof(IAliasFirst), aliasFactory);
        aliasServices.AddSingleton(typeof(IAliasSecond), aliasFactory);
        ServiceProvider aliasProvider = aliasServices.BuildServiceProvider();
        aliasProvider.GetRequiredService<IAliasFirst>();
        aliasProvider.GetRequiredService<IAliasSecond>();
        aliasProvider.Dispose();
        if (AliasResource.DisposeCount != 1u) return 77;

        IServiceCollection transientDisposalServices = new ServiceCollection();
        transientDisposalServices.AddTransient<TransientResource>();
        ServiceProvider transientDisposalProvider = transientDisposalServices.BuildServiceProvider();
        transientDisposalProvider.GetRequiredService<TransientResource>();
        transientDisposalProvider.GetRequiredService<TransientResource>();
        transientDisposalProvider.Dispose();
        if (TransientResource.DisposeCount != 2u) return 78;

        IServiceCollection cleanupServices = new ServiceCollection();
        cleanupServices.AddSingleton<CleanupThrower>();
        cleanupServices.AddSingleton<CleanupSurvivor>();
        ServiceProvider cleanupProvider = cleanupServices.BuildServiceProvider();
        cleanupProvider.GetRequiredService<CleanupThrower>();
        cleanupProvider.GetRequiredService<CleanupSurvivor>();
        bool aggregatedCleanup = false;
        try {
            cleanupProvider.Dispose();
        } catch (ServiceProviderDisposalException error) {
            aggregatedCleanup = error.ErrorCount == 1u;
        }
        if (!aggregatedCleanup || CleanupThrower.DisposeCount != 1u ||
            CleanupSurvivor.DisposeCount != 1u) return 79;
        cleanupProvider.Dispose();

        IServiceCollection reentrantServices = new ServiceCollection();
        reentrantServices.AddSingleton<ReentrantCleanup>();
        ServiceProvider reentrantProvider = reentrantServices.BuildServiceProvider();
        reentrantProvider.GetRequiredService<ReentrantCleanup>();
        reentrantProvider.Dispose();
        reentrantProvider.Dispose();
        if (ReentrantCleanup.DisposeCount != 1u) return 80;

        IServiceCollection failedConstructionServices = new ServiceCollection();
        failedConstructionServices.AddTransient<OwnedBeforeFailure>();
        failedConstructionServices.AddTransient<FailingConsumer>();
        ServiceProvider failedConstructionProvider = failedConstructionServices.BuildServiceProvider();
        bool constructorFailed = false;
        try {
            failedConstructionProvider.GetService(typeof(FailingConsumer));
        } catch (Exception) {
            constructorFailed = true;
        }
        if (!constructorFailed || OwnedBeforeFailure.DisposeCount != 0u) return 81;
        failedConstructionProvider.Dispose();
        if (OwnedBeforeFailure.DisposeCount != 1u) return 82;

        FactoryProbe.CallCount = 0u;
        delegate(IServiceProvider) => object singletonFactory = (IServiceProvider current) => {
            FactoryProbe.CallCount += 1u;
            return (object)new FactoryProbe(FactoryProbe.CallCount);
        };
        IServiceCollection factoryServices = new ServiceCollection();
        factoryServices.AddSingleton(typeof(FactoryProbe), singletonFactory);
        ServiceProvider factoryProvider = factoryServices.BuildServiceProvider();
        if (FactoryProbe.CallCount != 0u) return 86;
        FactoryProbe firstFactoryService = factoryProvider.GetRequiredService<FactoryProbe>();
        FactoryProbe secondFactoryService = factoryProvider.GetRequiredService<FactoryProbe>();
        if (FactoryProbe.CallCount != 1u ||
            !Object.ReferenceEquals((object)firstFactoryService, (object)secondFactoryService)) return 87;
        factoryProvider.Dispose();

        FactoryProbe.CallCount = 0u;
        delegate(IServiceProvider) => FactoryProbe typedFactory =
            (IServiceProvider current) => {
                FactoryProbe.CallCount += 1u;
                return new FactoryProbe(FactoryProbe.CallCount);
            };
        IServiceCollection typedFactoryServices = new ServiceCollection();
        typedFactoryServices.AddSingleton<FactoryProbe>(typedFactory);
        ServiceProvider typedFactoryProvider = typedFactoryServices.BuildServiceProvider();
        FactoryProbe typedSingletonFirst = typedFactoryProvider.GetRequiredService<FactoryProbe>();
        FactoryProbe typedSingletonSecond = typedFactoryProvider.GetRequiredService<FactoryProbe>();
        if (!Object.ReferenceEquals((object)typedSingletonFirst, (object)typedSingletonSecond) ||
            FactoryProbe.CallCount != 1u) return 98;
        typedFactoryProvider.Dispose();

        FactoryProbe.CallCount = 0u;
        IServiceCollection typedScopedServices = new ServiceCollection();
        typedScopedServices.AddScoped<FactoryProbe>(typedFactory);
        ServiceProvider typedScopedProvider = typedScopedServices.BuildServiceProvider();
        IServiceScope typedScopedFirst = typedScopedProvider.CreateScope();
        IServiceScope typedScopedSecond = typedScopedProvider.CreateScope();
        FactoryProbe typedScopedValue = typedScopedFirst.ServiceProvider.GetRequiredService<FactoryProbe>();
        if (!Object.ReferenceEquals((object)typedScopedValue,
                (object)typedScopedFirst.ServiceProvider.GetRequiredService<FactoryProbe>()) ||
            Object.ReferenceEquals((object)typedScopedValue,
                (object)typedScopedSecond.ServiceProvider.GetRequiredService<FactoryProbe>()) ||
            FactoryProbe.CallCount != 2u) return 99;
        typedScopedProvider.Dispose();

        FactoryProbe.CallCount = 0u;
        IServiceCollection typedTransientServices = new ServiceCollection();
        typedTransientServices.AddTransient<FactoryProbe>(typedFactory);
        ServiceProvider typedTransientProvider = typedTransientServices.BuildServiceProvider();
        FactoryProbe typedTransientFirst = typedTransientProvider.GetRequiredService<FactoryProbe>();
        FactoryProbe typedTransientSecond = typedTransientProvider.GetRequiredService<FactoryProbe>();
        if (Object.ReferenceEquals((object)typedTransientFirst, (object)typedTransientSecond) ||
            FactoryProbe.CallCount != 2u) return 100;
        typedTransientProvider.Dispose();
        if (!ProviderReferencesCleared(typedTransientProvider)) return 101;

        ServiceProvider disposedScopeProvider =
            (ServiceProvider)typedScopedFirst.ServiceProvider;
        if (!ProviderReferencesCleared(disposedScopeProvider)) return 102;

        delegate(IServiceProvider) => object wrongFactory =
            (IServiceProvider current) => (object)new Right();
        IServiceCollection wrongFactoryServices = new ServiceCollection();
        wrongFactoryServices.Add(new ServiceDescriptor(
            typeof(ILeft), ServiceLifetime.Singleton, wrongFactory));
        ServiceProvider wrongFactoryProvider = wrongFactoryServices.BuildServiceProvider();
        bool invalidFactoryFailed = false;
        try {
            wrongFactoryProvider.GetService(typeof(ILeft));
        } catch (ServiceResolutionException) {
            invalidFactoryFailed = true;
        }
        if (!invalidFactoryFailed) return 88;
        wrongFactoryProvider.Dispose();

        IServiceCollection ambiguousServices = new ServiceCollection();
        ambiguousServices.AddTransient<ILeft, Left>();
        ambiguousServices.AddTransient<IRight, Right>();
        ambiguousServices.AddTransient<AmbiguousSelection>();
        bool rejectedTie = false;
        try {
            ambiguousServices.BuildServiceProvider();
        } catch (ServiceResolutionException error) {
            rejectedTie = error != null;
        }
        if (!rejectedTie) return 89;

        IServiceCollection incomparableServices = new ServiceCollection();
        incomparableServices.AddTransient<ILeft, Left>();
        incomparableServices.AddTransient<IRight, Right>();
        incomparableServices.AddTransient<IExtraDependency, ExtraDependency>();
        incomparableServices.AddTransient<IAlienDependency, AlienDependency>();
        incomparableServices.AddTransient<IncomparableSelection>();
        bool rejectedIncomparable = false;
        try {
            incomparableServices.BuildServiceProvider();
        } catch (ServiceResolutionException error) {
            rejectedIncomparable = error != null;
        }
        if (!rejectedIncomparable) return 90;

        IServiceCollection shadowedServices = new ServiceCollection();
        shadowedServices.AddTransient(typeof(IShadowService), typeof(BadShadowImplementation));
        shadowedServices.AddTransient(typeof(IShadowService), typeof(GoodShadowImplementation));
        bool rejectedShadowedInvalidGraph = false;
        try {
            shadowedServices.BuildServiceProvider();
        } catch (ServiceResolutionException) {
            rejectedShadowedInvalidGraph = true;
        }
        if (!rejectedShadowedInvalidGraph) return 91;

        IServiceCollection reservedServices = new ServiceCollection();
        bool rejectedReservedKey = false;
        try {
            reservedServices.Add(new ServiceDescriptor(
                typeof(IServiceProvider), ServiceLifetime.Singleton, typeof(RootProviderConsumer)));
        } catch (Exception) {
            rejectedReservedKey = true;
        }
        if (!rejectedReservedKey) return 92;

        IServiceCollection invalidMappingServices = new ServiceCollection();
        bool rejectedInvalidMapping = false;
        try {
            invalidMappingServices.Add(new ServiceDescriptor(
                typeof(ILeft), ServiceLifetime.Transient, typeof(Right)));
        } catch (Exception) {
            rejectedInvalidMapping = true;
        }
        if (!rejectedInvalidMapping) return 93;

        return 0;
    }
}


