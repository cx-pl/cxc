public class GenericOuter<T> {
    public class Nested<U> {
        public T OuterValue;
        public U InnerValue;

        public T ReadOuter() { return OuterValue; }
    }

    public class Shadowed<T> {
        public T Value;
    }

    public class Middle<U> {
        public class Leaf<V> {
            public T OuterValue;
            public U MiddleValue;
            public V InnerValue;
        }
    }
}

