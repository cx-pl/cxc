public async Task MutateChildAfterDelay(
    ArenaAsyncPayload payload, uint delay, bool faultAfterMutation) {
    await TaskHandle.Delay(delay);
    payload.Value += 1;
    if (faultAfterMutation) {
        throw new Exception("first joined child fault");
    }
}

public async Task JoinTwoChildrenIncludingFaultedChild(
    ArenaAsyncPayload payload) {
    Task first = MutateChildAfterDelay(payload, 1u, true);
    Task second = MutateChildAfterDelay(payload, 30u, false);
    await TaskHandle.WhenAll(first, second);
}

public async Task JoinInlineChildrenOnSelectedBranch(
    ArenaAsyncPayload payload, bool firstBranch) {
    if (firstBranch) {
        await TaskHandle.WhenAll(
            MutateChildAfterDelay(payload, 1u, false),
            MutateChildAfterDelay(payload, 20u, false));
    } else {
        await TaskHandle.WhenAll(
            MutateChildAfterDelay(payload, 1u, false),
            MutateChildAfterDelay(payload, 30u, false));
    }
}

