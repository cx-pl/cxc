    int[] durableArray = new int[4];
    for (int index = 0; index < 4; index += 1) {
        durableList.Add(index);
        durableDictionary.Set(keys[index], index);
        durableLinkedList.AddLast(index);
        durableArray[index] = index;
    }

    ArenaAsyncProbe.Result = 0;
    Memory.WithArena(() => {
        try { durableList.GetEnumerator(); }
        catch (Exception) { ArenaAsyncProbe.Result = 1; }
        try { durableDictionary.GetEnumerator(); }
        catch (Exception) { ArenaAsyncProbe.Result = 2; }
        try { durableLinkedList.GetEnumerator(); }
        catch (Exception) { ArenaAsyncProbe.Result = 3; }
        try { durableArray.GetEnumerator(); }
        catch (Exception) { ArenaAsyncProbe.Result = 4; }
    });
    if (ArenaAsyncProbe.Result != 0) return ArenaAsyncProbe.Result;

    Memory.WithArena(() => {
        List<int> scopedList = new List<int>();
        Dictionary<string, int> scopedDictionary =
            new Dictionary<string, int>();
        LinkedList<int> scopedLinkedList = new LinkedList<int>();
        int[] scopedArray = new int[4];
        for (int index = 0; index < 4; index += 1) {
            scopedList.Add(index);
            scopedDictionary.Set(keys[index], index);
            scopedLinkedList.AddLast(index);
            scopedArray[index] = index;
        }
        IEnumerator<int> scopedListEnumerator = null;
        IEnumerator<KeyValuePair<string, int>> scopedDictionaryEnumerator = null;
        IEnumerator<int> scopedLinkedListEnumerator = null;
        IEnumerator<int> scopedArrayEnumerator = null;
        Memory.WithDurable(() => {
            try { scopedListEnumerator = scopedList.GetEnumerator(); }
            catch (Exception) { ArenaAsyncProbe.Result = 5; }
            try { scopedDictionaryEnumerator = scopedDictionary.GetEnumerator(); }
            catch (Exception) { ArenaAsyncProbe.Result = 6; }
            try { scopedLinkedListEnumerator = scopedLinkedList.GetEnumerator(); }
            catch (Exception) { ArenaAsyncProbe.Result = 7; }
            try { scopedArrayEnumerator = scopedArray.GetEnumerator(); }
            catch (Exception) { ArenaAsyncProbe.Result = 8; }
        });
        if (ArenaAsyncProbe.Result == 0) {
            for (int index = 0; index < 4; index += 1) {
                if (!scopedListEnumerator.MoveNext() ||
                    !scopedLinkedListEnumerator.MoveNext() ||
                    !scopedArrayEnumerator.MoveNext() ||
                    !scopedDictionaryEnumerator.MoveNext()) {
                    ArenaAsyncProbe.Result = 9;
                }
            }
            if (scopedListEnumerator.MoveNext() ||
                scopedLinkedListEnumerator.MoveNext() ||
                scopedArrayEnumerator.MoveNext() ||
                scopedDictionaryEnumerator.MoveNext()) {
                ArenaAsyncProbe.Result = 10;
            }
        }
    });
    return ArenaAsyncProbe.Result;
}

public int CheckArenaExceptionCopy() {
    try {
        Memory.WithArena(() => {
            throw new EncodingException(4242u);
        });
    } catch (EncodingException exception) {
        GC.Collect();
        return exception.Position == 4242u ? 0 : 1;
    }
    return 2;
}

public int CheckSynchronousScopeGcAndLoopCleanup() {
    int observedValue = 0;
    Memory.WithArena(() => {
        ArenaAsyncConstructionProbe probe =
            new ArenaAsyncConstructionProbe();
        GC.Collect();
        observedValue = probe.Payload.Value;
    });
    if (observedValue != 96) return 1;

    ArenaAsyncProbe.NativeResourceDisposeCount = 0u;
    Memory.WithArena(() => {
        for (uint index = 0u; index < 4u; index += 1u) {
            NativeBuffer scratch = NativeBuffer.Allocate(1ul);
            try {
                GC.Collect();
                if (index == 0u) continue;
                if (index == 2u) break;
            } finally {
                GC.Collect();
                scratch.Dispose();
                ArenaAsyncProbe.NativeResourceDisposeCount += 1u;
            }
        }
    });
    return ArenaAsyncProbe.NativeResourceDisposeCount == 3u ? 0 : 2;
}

