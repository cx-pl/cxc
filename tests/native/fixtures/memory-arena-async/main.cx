public Task StartCancellationWithNativeBuffer(CancellationToken cancellationToken) {
    NativeBuffer resource = NativeBuffer.Allocate(1ul);
    CancellationTokenRegistration registration = CancellationTokenRegistration.None;
    try {
        TaskCompletionSourceVoid completion = new TaskCompletionSourceVoid();
        registration = cancellationToken.Register(() => {
            ArenaAsyncProbe.CancellationCallbackCount += 1u;
            completion.SetCanceled();
        });
        return DisposeNativeBufferAfterAwait(completion.Task, registration, resource);
    } catch (Exception) {
        registration.Dispose();
        resource.Dispose();
        throw;
    }
}

public async Task DisposeNativeBufferAfterAwait(
    Task pending,
    CancellationTokenRegistration registration,
    NativeBuffer resource) {
    try {
        await pending;
    } finally {
        registration.Dispose();
        resource.Dispose();
        ArenaAsyncProbe.NativeResourceDisposeCount += 1u;
    }
}

