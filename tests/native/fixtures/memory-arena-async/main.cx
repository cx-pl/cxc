public int CheckCollectionOwnerGrowth() {
    string[] keys = new string[8];
    keys[0] = "owner-0";
    keys[1] = "owner-1";
    keys[2] = "owner-2";
    keys[3] = "owner-3";
    keys[4] = "owner-4";
    keys[5] = "owner-5";
    keys[6] = "owner-6";
    keys[7] = "owner-7";

    List<int> durableList = new List<int>();
    Dictionary<string, int> durableDictionary =
        new Dictionary<string, int>();
    Queue<int> durableQueue = new Queue<int>();
    Stack<int> durableStack = new Stack<int>();
    Memory.WithArena(() => {
        for (int index = 0; index < 8; index += 1) {
            durableList.Add(index);
            durableDictionary.Set(keys[index], index);
            durableQueue.Enqueue(index);
            durableStack.Push(index);
        }
    });
    if (durableList.Count != 8u || durableDictionary.Count != 8u ||
        durableQueue.Count != 8u || durableStack.Count != 8u) return 1;
    for (int index = 0; index < 8; index += 1) {
        if (durableList.Get((uint)index) != index ||
            durableDictionary.GetValueOrDefault(keys[index]) != index) return 2;
        if (durableQueue.Dequeue() != index) return 2;
        if (durableStack.Pop() != 7 - index) return 3;
    }

    ArenaAsyncProbe.Result = 0;
    Memory.WithArena(() => {
        List<int> scopedList = new List<int>();
        Dictionary<string, int> scopedDictionary =
            new Dictionary<string, int>();
        Queue<int> scopedQueue = new Queue<int>();
        Stack<int> scopedStack = new Stack<int>();
        for (int index = 0; index < 4; index += 1) {
            scopedList.Add(index);
            scopedDictionary.Set(keys[index], index);
            scopedQueue.Enqueue(index);
            scopedStack.Push(index);
        }
        Memory.WithDurable(() => {
            for (int index = 4; index < 8; index += 1) {
                scopedList.Add(index);
                scopedDictionary.Set(keys[index], index);
                scopedQueue.Enqueue(index);
                scopedStack.Push(index);
            }
        });
        if (scopedList.Count != 8u || scopedDictionary.Count != 8u ||
            scopedQueue.Count != 8u || scopedStack.Count != 8u ||
            scopedQueue.Peek() != 0 || scopedStack.Peek() != 7) {
            ArenaAsyncProbe.Result = 1;
        }
        for (int index = 0; index < 8; index += 1) {
            if (scopedList.Get((uint)index) != index ||
                scopedDictionary.GetValueOrDefault(keys[index]) != index) {
                ArenaAsyncProbe.Result = 2;
            }
            if (scopedQueue.Dequeue() != index ||
                scopedStack.Pop() != 7 - index) {
                ArenaAsyncProbe.Result = 3;
            }
        }
    });
    return ArenaAsyncProbe.Result;
}

public int CheckCollectionEnumeratorOwner() {
    string[] keys = new string[4];
    keys[0] = "enum-0";
    keys[1] = "enum-1";
    keys[2] = "enum-2";
    keys[3] = "enum-3";
