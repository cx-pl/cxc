    joinedChildrenPayload.Value = 0;
    ArenaAsyncProbe.Result = -1;
    TaskHandle joinedChildrenOperation = Memory.WithArenaAsync(() =>
        JoinTwoChildrenIncludingFaultedChild(joinedChildrenPayload));
    GC.Collect();
    TaskScheduler.RunUntil(joinedChildrenOperation);
    bool joinedChildFaultObserved = false;
    try { joinedChildrenOperation.GetResult(); }
    catch (Exception) { joinedChildFaultObserved = true; }
    if (!joinedChildFaultObserved || joinedChildrenPayload.Value != 2) return 37;

    ArenaAsyncPayload trueBranchPayload = new ArenaAsyncPayload();
    TaskHandle trueBranchOperation = Memory.WithArenaAsync(() =>
        JoinInlineChildrenOnSelectedBranch(trueBranchPayload, true));
    GC.Collect();
    TaskScheduler.RunUntil(trueBranchOperation);
    trueBranchOperation.GetResult();
    if (trueBranchPayload.Value != 2) return 41;

    ArenaAsyncPayload falseBranchPayload = new ArenaAsyncPayload();
    TaskHandle falseBranchOperation = Memory.WithArenaAsync(() =>
        JoinInlineChildrenOnSelectedBranch(falseBranchPayload, false));
    GC.Collect();
    TaskScheduler.RunUntil(falseBranchOperation);
    falseBranchOperation.GetResult();
    if (falseBranchPayload.Value != 2) return 42;

    ArenaAsyncPayload trueLocalBranchPayload = new ArenaAsyncPayload();
    TaskHandle trueLocalBranchOperation = Memory.WithArenaAsync(() =>
        JoinBranchLocalChildrenOnSelectedBranch(trueLocalBranchPayload, true));
    GC.Collect();
    TaskScheduler.RunUntil(trueLocalBranchOperation);
    trueLocalBranchOperation.GetResult();
    if (trueLocalBranchPayload.Value != 2) return 43;

    ArenaAsyncPayload falseLocalBranchPayload = new ArenaAsyncPayload();
    TaskHandle falseLocalBranchOperation = Memory.WithArenaAsync(() =>
        JoinBranchLocalChildrenOnSelectedBranch(falseLocalBranchPayload, false));
    GC.Collect();
    TaskScheduler.RunUntil(falseLocalBranchOperation);
    falseLocalBranchOperation.GetResult();
    if (falseLocalBranchPayload.Value != 2) return 44;

    ArenaAsyncPayload trueThreeLocalBranchPayload = new ArenaAsyncPayload();
    TaskHandle trueThreeLocalBranchOperation = Memory.WithArenaAsync(() =>
        JoinThreeBranchLocalChildrenOnSelectedBranch(
            trueThreeLocalBranchPayload, true));
    GC.Collect();
    TaskScheduler.RunUntil(trueThreeLocalBranchOperation);
    trueThreeLocalBranchOperation.GetResult();
    if (trueThreeLocalBranchPayload.Value != 3) return 88;

    ArenaAsyncPayload falseThreeLocalBranchPayload = new ArenaAsyncPayload();
    TaskHandle falseThreeLocalBranchOperation = Memory.WithArenaAsync(() =>
        JoinThreeBranchLocalChildrenOnSelectedBranch(
            falseThreeLocalBranchPayload, false));
    GC.Collect();
    TaskScheduler.RunUntil(falseThreeLocalBranchOperation);
    falseThreeLocalBranchOperation.GetResult();
    if (falseThreeLocalBranchPayload.Value != 3) return 89;

    CancellationTokenSource aggregateCancellationSource =
        new CancellationTokenSource();
    aggregateCancellationSource.Cancel();
    ArenaAsyncPayload canceledChildrenPayload = new ArenaAsyncPayload();
    TaskHandle canceledChildrenOperation = Memory.WithArenaAsync(() =>
        JoinCanceledChildWithSibling(
            canceledChildrenPayload, aggregateCancellationSource.Token));
    GC.Collect();
    TaskScheduler.RunUntil(canceledChildrenOperation);
    bool canceledChildrenObserved = false;
    try { canceledChildrenOperation.GetResult(); }
    catch (OperationCanceledException) { canceledChildrenObserved = true; }
    if (!canceledChildrenObserved || !canceledChildrenOperation.IsCanceled ||
        canceledChildrenPayload.Value != 1) return 38;

    ArenaAsyncPayload threeJoinedChildrenPayload = new ArenaAsyncPayload();
    ArenaAsyncProbe.Result = -1;
    TaskHandle threeJoinedChildrenOperation = Memory.WithArenaAsync(() =>
        JoinThreeChildrenIncludingFaultedChild(threeJoinedChildrenPayload));
    GC.Collect();
    TaskScheduler.RunUntil(threeJoinedChildrenOperation);
    bool threeChildFaultObserved = false;
    try { threeJoinedChildrenOperation.GetResult(); }
    catch (Exception) { threeChildFaultObserved = true; }
    if (!threeChildFaultObserved || threeJoinedChildrenPayload.Value != 3) return 39;

    CancellationTokenSource threeChildCancellationSource =
        new CancellationTokenSource();
    threeChildCancellationSource.Cancel();
    ArenaAsyncPayload threeCanceledChildrenPayload = new ArenaAsyncPayload();
    TaskHandle threeCanceledChildrenOperation = Memory.WithArenaAsync(() =>
        JoinThreeChildrenIncludingCanceledChild(
            threeCanceledChildrenPayload, threeChildCancellationSource.Token));
    GC.Collect();
    TaskScheduler.RunUntil(threeCanceledChildrenOperation);
    bool threeChildCancellationObserved = false;
    try { threeCanceledChildrenOperation.GetResult(); }
    catch (OperationCanceledException) { threeChildCancellationObserved = true; }
    if (!threeChildCancellationObserved || !threeCanceledChildrenOperation.IsCanceled ||
        threeCanceledChildrenPayload.Value != 2) return 40;

    TaskHandle faulted = Memory.WithArenaAsync(() => FaultAfterDelay());
    TaskScheduler.RunUntil(faulted);
    bool observed = false;
    try { faulted.GetResult(); }
    catch (Exception) { observed = true; }
    if (!observed) return 2;

    TaskHandle derivedFaulted = Memory.WithArenaAsync(() =>
        FaultDerivedAfterDelay());
    GC.Collect();
    TaskScheduler.RunUntil(derivedFaulted);
    observed = false;
    try { derivedFaulted.GetResult(); }
    catch (EncodingException exception) {
        observed = exception.Position == 4242u;
    }
    if (!observed) return 35;

    ArenaAsyncPayload durableExceptionPayload = new ArenaAsyncPayload();
    durableExceptionPayload.Value = 93;
    TaskHandle derivedPayloadFaulted = Memory.WithArenaAsync(() =>
        FaultDerivedWithDurablePayloadAfterDelay(durableExceptionPayload));
    GC.Collect();
    TaskScheduler.RunUntil(derivedPayloadFaulted);
    observed = false;
    try { derivedPayloadFaulted.GetResult(); }
    catch (ArenaAsyncDerivedException exception) {
        observed = exception.Payload == durableExceptionPayload &&
            exception.Payload.Value == 93;
    }
    if (!observed) return 36;

    TaskHandle startFault = Memory.WithArenaAsync(() =>
        FailBeforeReturningTask());
    TaskScheduler.RunUntil(startFault);
    observed = false;
    try { startFault.GetResult(); }
    catch (Exception) { observed = true; }
    if (!observed) return 3;

    CancellationTokenSource source = new CancellationTokenSource();
    source.Cancel();
    TaskHandle canceled = Memory.WithArenaAsync(() =>
        TaskHandle.Delay(1u, source.Token));
    TaskScheduler.RunUntil(canceled);
    if (!canceled.IsCanceled) return 4;

    CancellationTokenSource resourceSource = new CancellationTokenSource();
    ArenaAsyncProbe.NativeResourceDisposeCount = 0u;
    ArenaAsyncProbe.CancellationCallbackCount = 0u;
    TaskHandle resourceCanceled = null;
    try {
        resourceCanceled = Memory.WithArenaAsync(() =>
            StartCancellationWithNativeBuffer(resourceSource.Token));
        GC.Collect();
        if (ArenaAsyncProbe.NativeResourceDisposeCount != 0u) return 35;
        resourceSource.Cancel();
        GC.Collect();
        TaskScheduler.RunUntil(resourceCanceled);
    } catch (Exception exception) {
        Console.WriteLine(exception.Message);
        return 10;
    }
    if (!resourceCanceled.IsCanceled) return 8;
    bool observedCancellation = false;
    try {
        resourceCanceled.GetResult();
    } catch (OperationCanceledException) {
        observedCancellation = true;
    }
    if (!observedCancellation) return 8;
    if (ArenaAsyncProbe.NativeResourceDisposeCount != 1u) return 9;
    if (ArenaAsyncProbe.CancellationCallbackCount == 0u) {
        Console.WriteLine("cancellation callback was not invoked");
        return 11;
    }
    if (ArenaAsyncProbe.CancellationCallbackCount != 1u) {
        Console.WriteLine("cancellation callback ran more than once");
        return 12;
    }

    return 0;
}
