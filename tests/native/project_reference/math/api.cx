namespace Math;
public struct Value {
    public int number;
}
public interface IValue {
    int Get();
}
public class Box<T> {
    public T Value;
    public constructor() {}
}
public class Crate<T> {
    public T Value;
    public constructor() {}
}
public int LibraryBox() {
    Box<int> box = new Box<int>();
    box.Value = 1;
    return box.Value;
}
public IValue Echo(IValue value) {
    return value;
}
public int ReadInterface(IValue value) {
    return value.Get();
}
public int ReadBox(Box<int> box) {
    return box.Value;
}
public T Identity<T>(T value) {
    return value;
}
public int AddOne(int value) {
    return value + 1;
}
